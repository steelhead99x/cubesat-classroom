---
// The satellite's path across the sky. It rises low on the left, climbs into the
// open sky on the right and comes to rest there; text stays clear on the left.
// Purely decorative: one crossing on load, nothing on reduced motion.
interface Props {
  labels?: boolean;
  animate?: boolean;
}
const { labels = false, animate = true } = Astro.props;
const arc = 'M -10 700 C 140 660, 230 230, 640 170';
---
<svg class="pointer-events-none absolute inset-y-0 right-0 hidden h-full w-[52%] lg:block" viewBox="0 0 600 700" preserveAspectRatio="xMaxYMax meet" aria-hidden="true">
  <path d={arc} fill="none" stroke="#a4c9ff" stroke-opacity=".38" stroke-width="1.6" stroke-dasharray="2 10" stroke-linecap="round" />
  <g class={animate ? 'pass-sat' : ''} style={`offset-path: path("${arc}"); offset-distance: 70%; offset-rotate: 0deg;`}>
    <circle r="40" fill="#a4c9ff" fill-opacity=".1" />
    <circle r="22" fill="#a4c9ff" fill-opacity=".12" />
    <g transform="scale(1.45) translate(-17 -9)">
      <rect x="11" y="0" width="12" height="18" rx="2.5" fill="#ffd23f" stroke="#0b1d3a" stroke-width="1.6" />
      <rect x="-4" y="5" width="13" height="8" rx="1.2" fill="#a4c9ff" stroke="#0b1d3a" stroke-width="1.3" />
      <rect x="25" y="5" width="13" height="8" rx="1.2" fill="#a4c9ff" stroke="#0b1d3a" stroke-width="1.3" />
    </g>
    {labels && <text y="-46" text-anchor="middle" font-family="var(--font-sans)" font-size="14" font-weight="700" fill="#ffb547">Overhead now</text>}
  </g>
</svg>
