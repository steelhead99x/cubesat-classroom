---
import { repo } from '../hubs.mjs';

const command = 'curl -fsSL https://cubesat.club/start.sh | bash';
---
<section id="start" class="start" aria-labelledby="start-title">
  <h2 id="start-title">One command to start</h2>
  <p class="mt-2">Paste this into your terminal and follow the prompts. Open the local address the station prints.</p>
  <div class="terminal mt-5 flex flex-wrap items-center justify-between gap-3">
    <code id="command">{command}</code>
    <button id="copy" type="button" hidden>Copy command</button>
  </div>
  <p class="mt-3 text-sm">macOS, Linux or WSL. The starter offers to install or update Rust if needed. The station uses simulated sensors and video.</p>
  <p id="copy-status" class="sr-only" role="status"></p>
  <a class="mt-4 inline-block" href={repo + '/blob/main/output/pdf/cubesat-classroom-quick-start.pdf'}>Print the one-page quick start</a>
</section>
<script>
  const button = document.querySelector<HTMLButtonElement>('#copy');
  const command = document.querySelector('#command');
  const status = document.querySelector('#copy-status');

  if (button && command && status && navigator.clipboard) {
    button.hidden = false;
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(command.textContent ?? '');
        status.textContent = 'Command copied.';
        button.textContent = 'Copied';
      } catch {
        status.textContent = 'Select and copy the command from the box.';
        button.textContent = 'Copy manually';
        const range = document.createRange();
        range.selectNodeContents(command);
        const selection = window.getSelection();
        selection?.removeAllRanges();
        selection?.addRange(range);
      }
    });
  }
</script>
