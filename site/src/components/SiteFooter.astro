---
import { hubs, repo } from '../hubs.mjs';

interface Props {
  showHubs?: boolean;
}

const { showHubs = true } = Astro.props;
const homeFor = (hub: typeof hubs[number]) => 'https://' + hub.host + (hub.slug === 'lessons' ? '/hub/lessons/' : '/');
---
<footer class="border-t border-line text-sm">
  <div class="shell flex flex-wrap items-center justify-between gap-x-6 gap-y-3 py-6">
    <p class="text-muted">An independent volunteer project inspired by Teachers in Space and AMSAT.</p>
    <nav class="flex flex-wrap gap-x-4 gap-y-2" aria-label="Project sites">
      {showHubs && hubs.map(hub => <a class="font-semibold text-ink underline underline-offset-4" href={homeFor(hub)}>{hub.name}</a>)}
      <a class="font-semibold text-ink underline underline-offset-4" href={repo}>GitHub <span aria-hidden="true">↗</span></a>
    </nav>
  </div>
</footer>
