---
import { hubs, missionBriefing, repo } from '../hubs.mjs';
import { mainNav, moreNav, navHref } from '../nav.mjs';

interface Props {
  showHubs?: boolean;
}

const { showHubs = true } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const homeFor = (hub: typeof hubs[number]) => hub.home ?? 'https://' + hub.host + (hub.path ?? '/');
const columns = [
  { title: 'Learn and play', links: mainNav.map(i => ({ label: i.label, href: navHref(i, base) })) },
  ...moreNav.map(g => ({ title: g.group, links: g.items.map(i => ({ label: i.label, href: navHref(i, base) })) })),
  {
    title: 'Project sites',
    links: [
      // cubesat.app is already listed under Community.
      ...(showHubs ? hubs.filter(hub => !moreNav.some(g => g.items.some(i => i.href === homeFor(hub)))).map(hub => ({ label: hub.name, href: homeFor(hub) })) : []),
      { label: 'Mission briefing', href: missionBriefing },
      { label: 'GitHub', href: repo },
    ],
  },
];
---
<footer class="site-footer text-sm">
  <div class="shell py-8">
    <p class="max-w-md">An independent volunteer open-source space education project.</p>
    <nav class="cols mt-6" aria-label="Footer">
      {columns.map(col => (
        <div>
          <h2 class="col-title">{col.title}</h2>
          <ul>
            {col.links.map(link => <li><a href={link.href}>{link.label}</a></li>)}
          </ul>
        </div>
      ))}
    </nav>
  </div>
  <div class="shell t-src flex flex-wrap justify-between gap-x-6 gap-y-1 border-t border-white/15 py-3.5 text-white/70">
    <span class="legal-row">
      <span>Open source · MIT or Apache 2.0</span>
      <a class="legal font-normal" href={`${base}/privacy/`}>Privacy</a>
      <a class="legal font-normal" href={`${base}/terms/`}>Terms</a>
    </span>
    <span>Volunteer site work by <a class="credit font-normal" href="https://hikd.ai/">hikd.ai</a></span>
  </div>
</footer>

<style>
  .cols { display: grid; gap: 1.2rem 2rem; grid-template-columns: repeat(auto-fit, minmax(9.5rem, 1fr)); }
  .cols ul { list-style: none; margin: .35rem 0 0; padding: 0; }
  .col-title { margin: 0; font: 600 .72rem var(--font-mono); letter-spacing: .12em; text-transform: uppercase; color: rgb(255 255 255 / .6); }
  .cols a { display: inline-flex; align-items: center; min-height: 2.75rem; font-weight: 600; color: #fff; text-decoration: underline; text-decoration-color: rgb(255 255 255 / .35); text-underline-offset: 4px; }
  .cols a:hover { text-decoration-color: #fff; }
  .legal-row { display: flex; flex-wrap: wrap; align-items: center; gap: 0 1.25rem; }
  .legal { display: inline-flex; align-items: center; min-height: 2.75rem; color: inherit; text-decoration: underline; text-decoration-color: rgb(255 255 255 / .35); text-underline-offset: 4px; }
  .legal:hover { text-decoration-color: currentColor; }
  .credit { display: inline-flex; align-items: center; min-height: 2.75rem; }
</style>
