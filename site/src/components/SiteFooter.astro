---
import { hubs, missionBriefing, repo } from '../hubs.mjs';

interface Props {
  showHubs?: boolean;
}

const { showHubs = true } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const homeFor = (hub: typeof hubs[number]) => hub.home ?? 'https://' + hub.host + (hub.path ?? '/');
---
<footer class="site-footer text-sm">
  <div class="shell flex flex-wrap items-center justify-between gap-x-6 gap-y-3 py-7">
    <p>An independent volunteer open-source space education project.</p>
    <nav class="flex flex-wrap gap-x-5 gap-y-2" aria-label="Footer">
      {showHubs && hubs.map(hub => <a class="font-semibold underline underline-offset-4" href={homeFor(hub)}>{hub.name}</a>)}
      <a class="font-semibold underline underline-offset-4" href={base + '/games/'}>Games</a>
      <a class="font-semibold underline underline-offset-4" href={base + '/wiki/'}>Glossary</a>
      <a class="font-semibold underline underline-offset-4" href={missionBriefing}>Mission briefing</a>
      <a class="font-semibold underline underline-offset-4" href={repo}>GitHub</a>
    </nav>
  </div>
  <div class="shell t-src flex flex-wrap justify-between gap-x-6 gap-y-1 border-t border-white/15 py-3.5 text-white/70">
    <span>Open source · MIT or Apache 2.0</span>
    <span>Volunteer site work by <a class="font-normal" href="https://hikd.ai/">hikd.ai</a></span>
  </div>
</footer>
