---
// In-person workshops are the project's main goal: three a year. Dates, places
// and costs are set with partners and announced when confirmed.
import { fundraiser, repo } from '../hubs.mjs';

interface Props {
  id?: string;
}
const { id = 'workshops' } = Astro.props;
const host = `${repo}/issues/new?template=feedback.yml&labels=feedback,workshop&title=${encodeURIComponent('Workshop: host or attend')}`;
const workshops = [
  { season: 'Workshop 1', title: 'Build', text: 'Print and assemble the 1U model, wire a sensor, and check the fit with a mentor.' },
  { season: 'Workshop 2', title: 'Operate', text: 'Run the ground station, follow a satellite pass with licensed radio mentors, and log what comes back.' },
  { season: 'Workshop 3', title: 'Share', text: 'Present crew logs, compare balloon or bench data, and teach the next group of teachers.' },
];
const funds = [
  'Print filament, sensors and boards for each team',
  'Receive radios and antennas for mentors to demonstrate',
  'Travel help so teachers can attend',
  'Space, food and printed handouts',
];
---
<section id={id} class="scroll-mt-6" aria-labelledby={id + '-title'}>
  <div class="grid gap-10 lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)]">
    <div>
      <h2 id={id + '-title'}>Planned: three in-person workshops a year</h2>
      <p class="mt-4 text-lg text-muted">Everything here builds toward a day in the same room: teachers, students and radio mentors with real parts on the table. The website and the quests get you ready. The workshops are where it will come together.</p>
      <p class="mt-4 text-muted">Dates and places are set with partner schools and announced when they are confirmed.</p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a class="button launch" href={host}>Host or attend a workshop</a>
        <a class="button quiet" href={fundraiser}>Donate</a>
      </div>
    </div>
    <ol class="grid gap-4 sm:grid-cols-3 lg:grid-cols-1">
      {workshops.map((w, i) => (
        <li class="grid grid-cols-[auto_1fr] gap-4 rounded-[1.25rem] bg-white p-5 ring-1 ring-line">
          <span class="grid size-11 place-items-center rounded-full bg-night font-display text-lg font-extrabold text-horizon" aria-hidden="true">{i + 1}</span>
          <div>
            <h3>{w.title}</h3>
            <p class="mt-1 text-muted">{w.text}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
  <div class="mt-8 rounded-[1.25rem] bg-[#fde8e8] p-6">
    <h3>What workshop funding covers</h3>
    <ul class="mt-3 grid gap-x-8 gap-y-2 text-muted sm:grid-cols-2">
      {funds.map(item => <li class="flex gap-2"><span class="mt-2 size-1.5 shrink-0 rounded-full bg-signal-deep" aria-hidden="true"></span>{item}</li>)}
    </ul>
    <p class="mt-4 text-sm text-muted">The donate button goes to Teachers in Space, which runs its own teacher training and flight program. CubeSat Classroom is an independent volunteer project. Workshop budgets and goals will be published here once they are set.</p>
  </div>
</section>
