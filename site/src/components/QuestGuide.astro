---
// Quest guide demo. Visitors pick a question; there is no typing box. With no
// PUBLIC_GUIDE_ENDPOINT configured, answers are the prewritten ones in
// src/guide/answers.mjs. With an endpoint, answers come from the live guide in
// src/worker.mjs, which never exposes the API key to the browser.
import { general, questTopics } from '../guide/answers.mjs';

interface Props {
  quest?: string;
  title?: string;
}

const { quest = '', title = 'this quest' } = Astro.props;
const endpoint = import.meta.env.PUBLIC_GUIDE_ENDPOINT ?? '';
const questions = [
  ...(quest ? questTopics.map(t => ({ id: t.key, question: t.question })) : []),
  ...general.map(g => ({ id: g.id, question: g.question })),
];
---
<section class="guide grid gap-6 rounded-[1.5rem] bg-white p-6 ring-1 ring-line sm:p-8 lg:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)]" data-quest={quest} data-endpoint={endpoint} aria-labelledby="guide-title">
  <div>
    <div class="flex items-center gap-3">
      <span class="grid size-11 place-items-center rounded-full bg-violet text-night" aria-hidden="true">
        <svg class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v3m0 12v3M3 12h3m12 0h3M7.5 7.5 9 9m6 6 1.5 1.5m0-9L15 9m-6 6-1.5 1.5"/><circle cx="12" cy="12" r="3"/></svg>
      </span>
      <h2 id="guide-title" class="text-2xl">Ask the quest guide</h2>
    </div>
    <p class="mt-3 text-muted">Pick a question about {title}. Answers match the level you chose.</p>
    <p data-guide-mode class="mt-4 rounded-xl bg-paper p-3 text-sm text-muted">
      {endpoint
        ? 'Answers come from an AI quest guide with classroom guardrails. It only talks about the mission.'
        : 'Demo: these answers were written by the project team. The live guide will be an AI with classroom guardrails, and it will always say so.'}
    </p>
    <ul class="mt-5 flex flex-wrap gap-2" aria-label="Questions">
      {questions.map(q => (
        <li><button type="button" data-ask={q.id} class="rounded-full border-2 border-ink px-4 py-2 text-sm font-bold text-ink hover:bg-paper aria-disabled:cursor-wait aria-disabled:opacity-60">{q.question}</button></li>
      ))}
    </ul>
  </div>
  <div class="flex min-h-[14rem] flex-col rounded-2xl bg-paper p-4">
    <ol data-chat class="flex flex-1 flex-col gap-3" aria-live="polite">
      <li class="max-w-[85%] rounded-2xl rounded-tl-sm bg-white p-3 text-sm text-muted ring-1 ring-line">Hi crew. Pick a question and I will help, without giving away the answers you should find yourselves.</li>
    </ol>
  </div>
</section>

<script>
  import { answerFor } from '../guide/answers.mjs';

  type Level = 'beginner' | 'intermediate' | 'professional';
  const root = document.querySelector<HTMLElement>('.guide');
  if (root) {
    const chat = root.querySelector<HTMLOListElement>('[data-chat]')!;
    const quest = root.dataset.quest ?? '';
    const endpoint = root.dataset.endpoint ?? '';
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const level = (): Level => (document.documentElement.dataset.level as Level) || 'beginner';
    let busy = false;

    // A random id kept in this browser so the live guide can count daily limits.
    // The server only ever stores a salted hash of it.
    function clientId() {
      try {
        let id = localStorage.getItem('cubesat.guide');
        if (!id) { id = crypto.randomUUID(); localStorage.setItem('cubesat.guide', id); }
        return id;
      } catch { return 'no-storage'; }
    }

    function bubble(text: string, mine: boolean) {
      const item = document.createElement('li');
      item.className = mine
        ? 'ml-auto max-w-[85%] rounded-2xl rounded-tr-sm bg-night p-3 text-sm font-bold text-white'
        : 'max-w-[85%] rounded-2xl rounded-tl-sm bg-white p-3 text-sm text-ink ring-1 ring-line';
      item.textContent = text;
      chat.append(item);
      while (chat.children.length > 9) chat.firstElementChild?.remove();
      return item;
    }

    async function reveal(item: HTMLElement, text: string) {
      if (reduce) { item.textContent = text; return; }
      item.textContent = '';
      const words = text.split(' ');
      for (let i = 0; i < words.length; i++) {
        item.textContent += (i ? ' ' : '') + words[i];
        await new Promise(r => setTimeout(r, 28));
      }
    }

    async function live(questionId: string): Promise<string | null> {
      try {
        const res = await fetch(endpoint, {
          method: 'POST',
          headers: { 'content-type': 'application/json', 'x-guide-client': clientId() },
          body: JSON.stringify({ quest, question: questionId, level: level() }),
        });
        const data = await res.json().catch(() => ({}));
        if (res.ok && typeof data.answer === 'string') return data.answer;
        if (res.status === 429) return data.message ?? 'That is all the questions for today. Keep going with the quest steps, and come back tomorrow.';
        return null;
      } catch { return null; }
    }

    root.addEventListener('click', async event => {
      const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-ask]');
      if (!button || busy) return;
      busy = true;
      root.querySelectorAll('[data-ask]').forEach(b => b.setAttribute('aria-disabled', 'true'));
      const questionId = button.dataset.ask!;
      bubble(button.textContent ?? '', true);
      const reply = bubble('Thinking…', false);
      const prewritten = answerFor(quest, questionId, level()) ?? 'I can only help with the mission.';
      const text = endpoint ? (await live(questionId)) ?? prewritten : prewritten;
      if (!endpoint) await new Promise(r => setTimeout(r, reduce ? 0 : 450));
      await reveal(reply, text);
      root.querySelectorAll('[data-ask]').forEach(b => b.removeAttribute('aria-disabled'));
      busy = false;
    });
  }
</script>
