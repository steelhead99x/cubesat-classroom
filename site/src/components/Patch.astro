---
// A quest's mission patch: navy field, white keyline and stars, a band in the quest's colour, the
// icon, and the patch name cut into a ribbon. The art is in ../patch-art.json and the frame and
// label outlines in ../patch-shapes.json, both shared with the 3D-printable patches
// (hardware/patches). Run `python3 hardware/patches/gen/patches.py build` after changing either.
import art from '../patch-art.json';
import shapes from '../patch-shapes.json';

interface Props {
  id: string;
  name: string;   // full quest title, used for the accessible label
  label: string;
  size?: number;
}

type Shape = { layer: 'white' | 'tone'; kind: 'fill' | 'stroke'; d: string; width?: number; gap?: number };
const { id, name, label, size = 120 } = Astro.props;
const spec = (art.patches as Record<string, { tone: string; shapes: Shape[] }>)[id];
const tone = spec?.tone ?? '#a4c9ff';
const [dx, dy] = art.frame.art_shift;
const outline = (shapes.labels as Record<string, { label: string; d: string }>)[id];
// Use the outlined label only if it was generated from the current name.
const useOutline = outline?.label === label;
const f = shapes.frame;
---
<svg class="patch" data-patch={id} data-name={name} style={`--tone:${tone}`} viewBox="0 0 100 100" width={size} height={size} role="img">
  <title>{name}: not earned yet</title>
  <path class="p-body" d={f.body} />
  <path class="p-white" d={f.key} fill-rule="evenodd" />
  <path class="p-tone" d={f.band} fill-rule="evenodd" />
  <path class="p-white" d={f.stars} />
  <g transform={`translate(${dx} ${dy})`}>
    {(spec?.shapes ?? []).map(s => (
      <>
        {s.gap && (s.kind === 'fill'
          ? <path class="p-gap" d={s.d} stroke-width={2 * s.gap} fill-rule="evenodd" />
          : <path class="p-gap-line" d={s.d} stroke-width={(s.width ?? 0) + 2 * s.gap} />)}
        {s.kind === 'fill'
          ? <path class={`p-${s.layer}`} d={s.d} fill-rule="evenodd" />
          : <path class={`s-${s.layer}`} d={s.d} stroke-width={s.width} />}
      </>
    ))}
  </g>
  <path class="p-white" d={f.ribbon} />
  <path class="p-tone" d={f.ribbonInner} />
  {useOutline
    ? <path class="p-body" d={outline.d} fill-rule="evenodd" />
    : <text class="p-body" x="50" y={art.frame.label.cy + art.frame.label.cap / 2} text-anchor="middle" font-family="var(--font-mono)" font-size={art.frame.label.cap * 1.35} font-weight="500" letter-spacing=".4">{label.toUpperCase()}</text>}
</svg>
