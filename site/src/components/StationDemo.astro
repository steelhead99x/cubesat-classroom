---
// A browser-only rehearsal of the classroom ground station. It mirrors the Rust
// simulator: the same synthetic readings, the same eight-frame test chart and the
// same five-second freshness rule. No network traffic leaves the page.
const quests = [
  { id: 'reading', label: 'Read a measurement' },
  { id: 'video', label: 'Bring back all 8 frames' },
  { id: 'recovery', label: 'Lose and regain contact' },
];
---
<section id="demo" class="scroll-mt-6" aria-labelledby="demo-title">
  <div class="flex flex-wrap items-end justify-between gap-3">
    <div>
      <h2 id="demo-title">Try the ground station</h2>
      <p class="mt-2 max-w-2xl text-muted">A rehearsal that runs in this page. Request a reading, bring back a picture, then pause contact halfway through and see what reaches the ground.</p>
    </div>
    <p class="rounded-full border border-line bg-white px-3 py-1 text-xs font-semibold text-faint">Simulated · nothing is transmitted</p>
  </div>

  <div class="mt-6 grid overflow-hidden rounded-2xl bg-night text-white shadow-xl shadow-night/15 lg:grid-cols-2">
    <div class="flex flex-col gap-5 p-5 sm:p-7">
      <div class="rounded-xl border border-white/10 bg-white/5 p-4">
        <ol class="grid grid-cols-[auto_1fr_auto_1fr_auto] items-center gap-2 text-center text-xs font-semibold text-blue-100" aria-label="Signal path">
          <li class="flex flex-col items-center gap-1.5"><span class="grid size-9 place-items-center rounded-lg bg-blue-300 text-night" aria-hidden="true">G</span>Ground</li>
          <li data-link class="h-0.5 rounded bg-sky/60 transition-colors" aria-hidden="true"></li>
          <li class="flex flex-col items-center gap-1.5"><span class="grid size-9 place-items-center rounded-lg bg-amber-300 text-night" aria-hidden="true">C</span>CubeSat</li>
          <li class="h-0.5 rounded bg-sky/60" aria-hidden="true"></li>
          <li class="flex flex-col items-center gap-1.5"><span class="grid size-9 place-items-center rounded-lg bg-emerald-300 text-night" aria-hidden="true">P</span>Payload</li>
        </ol>
        <p data-link-status class="mt-3 text-center text-xs text-blue-100/80">Radio link ready</p>
      </div>

      <div class="flex flex-wrap gap-2.5">
        <button data-action="sensors" type="button" class="rounded-lg bg-sky px-4 py-2.5 text-sm font-bold text-night hover:bg-blue-200 disabled:cursor-not-allowed disabled:opacity-50">Get sensor reading</button>
        <button data-action="video" type="button" class="rounded-lg bg-amber-300 px-4 py-2.5 text-sm font-bold text-night hover:bg-amber-200 disabled:cursor-not-allowed disabled:opacity-50">Start video</button>
        <button data-contact type="button" class="rounded-lg border border-white/30 px-4 py-2.5 text-sm font-bold text-white hover:bg-white/10">Pause contact</button>
      </div>

      <div>
        <dl class="grid grid-cols-3 gap-2">
          <div class="rounded-lg bg-white/5 p-3"><dt class="text-xs text-blue-100/80">Temperature</dt><dd data-temp class="mt-1 font-mono text-lg font-bold sm:text-xl">—</dd></div>
          <div class="rounded-lg bg-white/5 p-3"><dt class="text-xs text-blue-100/80">Bus voltage</dt><dd data-volt class="mt-1 font-mono text-lg font-bold sm:text-xl">—</dd></div>
          <div class="rounded-lg bg-white/5 p-3"><dt class="text-xs text-blue-100/80">Light</dt><dd data-light class="mt-1 font-mono text-lg font-bold sm:text-xl">—</dd></div>
        </dl>
        <p data-fresh class="mt-2 text-xs text-blue-100/80">No reading yet</p>
      </div>

      <ul class="flex flex-wrap gap-2 text-xs font-semibold" aria-label="Quests">
        {quests.map(q => (
          <li data-quest={q.id} class="rounded-full border border-white/20 px-3 py-1 text-blue-100 data-[done]:border-emerald-300 data-[done]:bg-emerald-300 data-[done]:text-night">
            <span data-mark aria-hidden="true">○</span> {q.label}<span data-sr class="sr-only">: open</span>
          </li>
        ))}
      </ul>
    </div>

    <div class="flex flex-col gap-4 border-t border-white/10 bg-navy p-5 sm:p-7 lg:border-t-0 lg:border-l">
      <figure class="m-0">
        <canvas data-screen width="320" height="240" class="block aspect-[4/3] w-full rounded-lg bg-[#0b1a33]" role="img" aria-label="Test camera: waiting"></canvas>
        <figcaption data-frames class="mt-2 text-xs text-blue-100/80">0 of 8 frames</figcaption>
      </figure>
      <div>
        <h3 class="text-sm font-bold tracking-normal text-blue-100">Mission log</h3>
        <ol data-log class="mt-2 space-y-1 font-mono text-xs text-blue-100/90" aria-live="polite">
          <li class="text-blue-100/60">T+0.0 s  Station ready.</li>
        </ol>
      </div>
    </div>
  </div>
  <p class="mt-3 text-sm text-faint">The full station runs on your computer and sends each request across two Media over QUIC relays. <a class="font-semibold text-ink underline underline-offset-4" href="#start">Install it in one command</a>.</p>
</section>

<script>
  const MAX_AGE_MS = 5000;
  const FRAME_COUNT = 8;
  const FRAME_INTERVAL_MS = 500;
  const TIMEOUT_MS = 3000;
  const PALETTE = ['#e14346', '#ffc443', '#3ca479', '#3271ca', '#303554', '#f3e8d0'];

  const root = document.querySelector<HTMLElement>('#demo');
  if (root) {
    const $ = <T extends Element>(sel: string) => root.querySelector<T>(sel)!;
    const sensorsBtn = $<HTMLButtonElement>('[data-action="sensors"]');
    const videoBtn = $<HTMLButtonElement>('[data-action="video"]');
    const contactBtn = $<HTMLButtonElement>('[data-contact]');
    const canvas = $<HTMLCanvasElement>('[data-screen]');
    const ctx = canvas.getContext('2d')!;
    const log = $<HTMLOListElement>('[data-log]');
    const start = performance.now();

    let online = true;
    let busy = false;
    let sample: { temperature: number; voltage: number; light: number; captured: number } | null = null;
    let frames = 0;
    const done = { reading: false, video: false, recovery: false };
    let lossTried = false;
    let sequence = Math.floor(Date.now() / 1000);

    const sleep = (ms: number) => new Promise(resolve => setTimeout(resolve, ms));
    const legDelay = () => 180 + Math.random() * 260;

    function note(text: string) {
      const item = document.createElement('li');
      item.textContent = `T+${((performance.now() - start) / 1000).toFixed(1)} s  ${text}`;
      log.prepend(item);
      while (log.children.length > 6) log.lastElementChild?.remove();
    }

    function synthetic(seq: number) {
      // Same formula as Sample::synthetic in src/main.rs.
      return {
        temperature: 18 + (seq % 11) / 2,
        voltage: (3900 + (seq % 61)) / 1000,
        light: seq % 30 < 20 ? 460 : 0,
        captured: Date.now(),
      };
    }

    function drawFrame(frame: number) {
      // Same chart as test_frame in src/classroom.rs.
      for (let i = 0; i < 6; i++) {
        ctx.fillStyle = PALETTE[i];
        ctx.fillRect(i * 54, 0, 54, 191);
        ctx.fillStyle = PALETTE[5 - i];
        ctx.fillRect(i * 54, 191, 54, 49);
      }
      const x = frame * 33 + 24;
      ctx.fillStyle = '#121c2e';
      ctx.fillRect(x - 21, 140 - 21, 43, 43);
      ctx.fillStyle = '#ffffff';
      ctx.fillRect(x - 17, 140 - 17, 35, 35);
      canvas.setAttribute('aria-label', `Test camera: frame ${frame + 1} of ${FRAME_COUNT}`);
    }

    function drawIdle(text: string) {
      ctx.fillStyle = '#0b1a33';
      ctx.fillRect(0, 0, 320, 240);
      ctx.fillStyle = '#9fb7d9';
      ctx.font = '600 14px system-ui, sans-serif';
      ctx.textAlign = 'center';
      ctx.fillText(text, 160, 124);
    }

    function complete(quest: keyof typeof done) {
      if (done[quest]) return;
      done[quest] = true;
      const chip = $<HTMLElement>(`[data-quest="${quest}"]`);
      chip.dataset.done = '';
      chip.querySelector('[data-mark]')!.textContent = '✓';
      chip.querySelector('[data-sr]')!.textContent = ': complete';
    }

    function render() {
      sensorsBtn.disabled = videoBtn.disabled = busy || !online;
      contactBtn.textContent = online ? 'Pause contact' : 'Restore contact';
      $<HTMLElement>('[data-link]').className = 'h-0.5 rounded transition-colors ' + (online ? (busy ? 'bg-sky animate-pulse' : 'bg-sky/60') : 'bg-signal');
      $<HTMLElement>('[data-link-status]').textContent = online ? (busy ? 'Request in flight' : 'Radio link ready') : 'Contact paused · no signal';
      if (sample) {
        const age = Date.now() - sample.captured;
        $('[data-temp]').textContent = `${sample.temperature.toFixed(1)} °C`;
        $('[data-volt]').textContent = `${sample.voltage.toFixed(3)} V`;
        $('[data-light]').textContent = `${sample.light} lx`;
        const fresh = online && age <= MAX_AGE_MS;
        $('[data-fresh]').textContent = `${fresh ? 'Fresh' : 'Historical'} · captured ${Math.round(age / 1000)} s ago`;
      }
    }

    // Wait for a reply leg, or fail if contact is paused or the deadline passes.
    async function leg(): Promise<boolean> {
      const until = performance.now() + legDelay();
      while (performance.now() < until) {
        if (!online) {
          await sleep(TIMEOUT_MS);
          return false;
        }
        await sleep(40);
      }
      return online;
    }

    async function requestSensors() {
      busy = true; render();
      const sent = performance.now();
      note('Command sent: read sensors');
      const ok = (await leg()) && (await leg());
      if (ok) {
        sample = synthetic(++sequence);
        note(`Reply in ${Math.round(performance.now() - sent)} ms: ${sample.temperature.toFixed(1)} °C, ${sample.voltage.toFixed(3)} V, ${sample.light} lx`);
        complete('reading');
        if (lossTried) complete('recovery');
      } else {
        note('No complete reply. Check contact and try again.');
      }
      busy = false; render();
    }

    async function requestVideo() {
      busy = true; frames = 0; render();
      note('Command sent: start test camera');
      drawIdle('Waiting for the first frame…');
      $('[data-frames]').textContent = `0 of ${FRAME_COUNT} frames`;
      if (!(await leg())) {
        note('No complete reply. Check contact and try again.');
        busy = false; render(); return;
      }
      for (let frame = 0; frame < FRAME_COUNT; frame++) {
        if (frame > 0) await sleep(FRAME_INTERVAL_MS);
        if (!online) break;
        drawFrame(frame);
        frames = frame + 1;
        $('[data-frames]').textContent = `${frames} of ${FRAME_COUNT} frames`;
      }
      if (frames === FRAME_COUNT) {
        note('Received all eight frames.');
        complete('video');
        if (lossTried) complete('recovery');
      } else {
        $('[data-frames]').textContent = `${frames} of ${FRAME_COUNT} frames · incomplete`;
        note(`Contact lost after ${frames} of ${FRAME_COUNT} frames. The partial burst is marked incomplete.`);
      }
      busy = false; render();
    }

    sensorsBtn.addEventListener('click', requestSensors);
    videoBtn.addEventListener('click', requestVideo);
    contactBtn.addEventListener('click', () => {
      online = !online;
      if (!online) lossTried = true;
      note(online ? 'Contact restored. Try a new request.' : 'Contact paused. The last readings are historical.');
      render();
    });

    drawIdle('Camera is waiting');
    render();
    setInterval(render, 500);
  }
</script>
