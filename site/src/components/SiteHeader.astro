---
import wordmark from '../../../docs/assets/cubesat-classroom-wordmark-reversed.svg';

interface Props {
  brand?: string;
  mark?: string;
  home: string;
  label?: string;
  links: { label: string; href: string; current?: boolean }[];
}

const { brand = 'CubeSat Classroom', mark = 'mark.svg', home, label = 'Main', links } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
// The main site shows the reversed wordmark, as on the mission briefing.
// Club and other hub sites keep their own mark and name.
const main = brand === 'CubeSat Classroom';
---
<header class="site-header">
  <div class="shell flex flex-wrap items-center justify-between gap-x-6 gap-y-2 py-3.5">
    <a class="brand inline-flex items-center gap-3" href={home}>
      {main
        ? <img src={wordmark.src} width="113" height="40" alt="CubeSat Classroom" class="h-10 w-auto">
        : <><img src={base + '/' + mark} width="35" height="35" alt=""><span>{brand}</span></>}
    </a>
    <nav class="flex flex-wrap items-center gap-x-4 gap-y-1 sm:gap-x-6" aria-label={label}>
      {links.map(link => (
        <a href={link.href} aria-current={link.current ? 'page' : undefined}>{link.label}</a>
      ))}
    </nav>
  </div>
</header>
