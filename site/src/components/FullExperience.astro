---
import { repo } from '../hubs.mjs';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<section class="rounded-[1.25rem] bg-white p-6 ring-1 ring-line sm:p-8" aria-labelledby="next-steps-title">
  <h2 id="next-steps-title">Continue with the bench labs</h2>
  <p class="mt-3 max-w-2xl text-muted">Install the local station and pick a hardware quest for Arduino, Seeed XIAO, Raspberry Pi, or a computer-only setup.</p>
  <div class="mt-6 grid gap-4 md:grid-cols-2">
    <div class="rounded-xl bg-paper p-4">
      <h3 class="text-lg">Local station and hardware quests</h3>
      <p class="mt-1 text-sm text-muted">Choose a quest based on the hardware available to your class.</p>
      <a class="mt-3 inline-block text-sm font-semibold underline underline-offset-4" href={repo + '/tree/main/quest'}>Open the quest board</a>
    </div>
    <div class="rounded-xl bg-paper p-4">
      <h3 class="text-lg">Classroom support proposal</h3>
      <p class="mt-1 text-sm text-muted">Review the proposal for hosted classroom tools and tell us what your school would need.</p>
      <a class="mt-3 inline-block text-sm font-semibold underline underline-offset-4" href={base + '/plans/'}>Read the proposal and give feedback</a>
    </div>
  </div>
</section>
