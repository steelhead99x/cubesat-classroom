---
import { Image } from 'astro:assets';
import panelMark from '../assets/classroom-mark-reversed.svg?url';
import board from '../../../hardware/sdr-receiver/kicad/csc-r1-top.png';
import { repo } from '../hubs.mjs';
import { EXPERIMENTS } from '../lib/pedal.mjs';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const wiki = (slug: string) => `${base}/wiki/${slug}/`;
const plan = `${repo}/blob/main/hardware/sdr-receiver/rev-b-pedal-plan.md`;
const pedalDoc = `${repo}/blob/main/hardware/sdr-receiver/pedal/README.md`;
const stationSim = `${repo}/blob/main/docs/classroom-receiver.md#stats-version-1`;
const revA = `${repo}/blob/main/hardware/sdr-receiver/README.md`;

// Hotspots on the real Rev A board render. Positions come from fab/csc-r1-cpl-top.csv
// (board outline x 60–180 mm, y 50–128 mm): left = (x − 60) / 120, top = (y − 50) / 78.
const parts = [
  { n: 1, left: 1.8, top: 66.7, name: 'Antenna in (SMA, J3)', job: 'The satellite signal comes in here. On the pedal this is the SMA jack on the right side, and the antenna sits up on a mast, joined by a coax cable.', terms: [['amateur-satellite-band', '2 m and 70 cm bands']] },
  { n: 2, left: 21.8, top: 64.2, name: 'Low-noise amplifier (PGA-103+, U5)', job: 'Makes the very faint signal stronger before anything else can add noise.', terms: [] },
  { n: 3, left: 45.3, top: 66.7, name: 'Band filters and switches (two PE4259, U6 and U7)', job: 'The BAND toggle flips these switches to pick the 2 m or the 70 cm filter. The filters block strong signals outside the band, like FM radio stations.', terms: [['amateur-satellite-band', 'amateur satellite bands']] },
  { n: 4, left: 78.0, top: 65.4, name: 'I/Q demodulator (LTC5584, U8)', job: 'Mixes the radio signal down to two slow signals, I and Q, that the ADC can read.', terms: [] },
  { n: 5, left: 88.4, top: 62.5, name: 'Synthesizer (ADF4351, U11) and 25 MHz TCXO', job: 'Makes the tuning frequency. Turning TUNE changes it in 5 kHz steps.', terms: [] },
  { n: 6, left: 79.0, top: 45.5, name: 'ADC (TLV320ADC3140, U10)', job: 'Turns I and Q into numbers. The GAIN knob sets its gain, from 0 to 42 dB. Too much gain and the peaks clip.', terms: [] },
  { n: 7, left: 78.3, top: 14.4, name: 'XIAO microcontroller sockets (J12, J13)', job: 'The XIAO plugs in here. It is the pedal’s computer (MCU): it tunes the synthesizer, reads the ADC and sends the stream.', terms: [['xiao', 'XIAO']] },
  { n: 8, left: 11.7, top: 95.9, name: 'USB-C (J1)', job: 'Power, and on the XIAO ESP32-S3 a USB stream to a laptop. In the pedal it comes out through a USB-C panel jack on the top end, beside the 9 V jack.', terms: [] },
];
---
<section id="pedal-lab" class="mt-10" aria-labelledby="pedal-title">
  <h2 id="pedal-title">Satellite pedal trainer</h2>
  <p class="mt-2 max-w-2xl text-muted">Practice on the CSC-R1P receiver: a satellite radio built into a guitar-pedal box. Turn the knobs, flip BAND and stomp ENGAGE on the pedal, or use the controls. The browser simulates the waveform. You need no hardware, account or radio license to play.</p>
  <div class="console mt-4">
    <header><img src={panelMark} width="44" height="44" alt="" /><strong>CSC-R1P / RECEIVER LAB</strong></header>
    <p id="pedal-task" aria-live="polite">1 of 3 · Tap ENGAGE to unmute the receiver.</p>
    <div class="rig">
      <figure class="pedal">
        <svg data-pedal viewBox="-34 -50 134 182" role="img" aria-labelledby="pedal-svg-title">
          <title id="pedal-svg-title">Top view of the CSC-R1P pedal. GAIN, TUNE and LEVEL knobs in a row at the top, the OLED display under them, the ENGAGE light, the BAND toggle and the ENGAGE footswitch at the bottom. The OUT jack is on the left side, the antenna input on the right, and the 9 V jack, USB-C and Wi-Fi antenna on the top end.</title>
          <defs>
            <linearGradient id="pedal-case" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#2f6b4f"/><stop offset="1" stop-color="#173d2c"/></linearGradient>
            <radialGradient id="pedal-knob" cx=".35" cy=".3" r=".8"><stop offset="0" stop-color="#4a524e"/><stop offset="1" stop-color="#121614"/></radialGradient>
            <radialGradient id="pedal-metal" cx=".35" cy=".3" r=".8"><stop offset="0" stop-color="#f2f5f3"/><stop offset="1" stop-color="#8a948f"/></radialGradient>
          </defs>
          <g class="lbl">
            <!-- Top end, from hardware/sdr-receiver/pedal/face-template.svg: 9 V DC at 20 mm, USB-C at 36 mm, Wi-Fi RP-SMA at 50 mm -->
            <rect x="16" y="-5" width="8" height="5" rx="1" fill="#1b1f1d" stroke="#6f7a74" stroke-width=".4"/>
            <text x="20" y="-8" text-anchor="middle">9V DC</text>
            <rect x="31.5" y="-3" width="9" height="3" rx="1.4" fill="#cfd5d2"/>
            <text x="36" y="-12.5" text-anchor="middle">USB-C</text>
            <rect x="47" y="-5" width="6" height="5" fill="url(#pedal-metal)"/>
            <rect x="48" y="-32" width="4" height="27" rx="2" fill="#1b1f1d" stroke="#6f7a74" stroke-width=".4"/>
            <text x="55" y="-26">Wi-Fi</text>
            <text x="55" y="-21.5">antenna</text>
            <!-- Left side: 1/4 inch OUT. Right side: receive antenna IN by coax -->
            <rect x="-6" y="76" width="6" height="10" fill="url(#pedal-metal)"/>
            <text x="-8" y="79.5" text-anchor="end">OUT</text>
            <text x="-8" y="84" text-anchor="end">¼ in</text>
            <rect x="65.5" y="37" width="5" height="6" fill="url(#pedal-metal)"/>
            <path d="M70.5 40 H84 V-34" fill="none" stroke="#5d6b64" stroke-width="2.2" stroke-linecap="round"/>
            <text x="86" y="-38" text-anchor="middle">to mast</text>
            <text x="86" y="-43" text-anchor="middle">antenna</text>
            <text x="72" y="49">ANT IN</text>
          </g>
          <!-- Hammond 1590N1 (125B) die-cast box, 121.2 × 65.5 mm. Positions from the face template. -->
          <rect width="65.5" height="121.2" rx="4" fill="url(#pedal-case)" stroke="#0b1c14" stroke-width=".8"/>
          <text class="face" x="32.75" y="7" text-anchor="middle">CSC-R1P · SATELLITE RX</text>
          <g data-knob="gain" class="knob">
            <circle cx="15.8" cy="20" r="6.5" fill="url(#pedal-knob)" stroke="#000" stroke-width=".4"/>
            <line x1="15.8" y1="20" x2="15.8" y2="14.5" stroke="#f3fff7" stroke-width="1.2" stroke-linecap="round"/>
          </g>
          <text class="face" x="15.8" y="30.5" text-anchor="middle">GAIN</text>
          <g data-knob="tune" class="knob">
            <circle cx="32.8" cy="20" r="6.5" fill="url(#pedal-knob)" stroke="#000" stroke-width=".4"/>
            <circle cx="32.8" cy="20" r="4.8" fill="none" stroke="#2b322e" stroke-width=".4"/>
            <line x1="32.8" y1="20" x2="32.8" y2="14.5" stroke="#f3fff7" stroke-width="1.2" stroke-linecap="round"/>
          </g>
          <text data-tune-label class="face" x="32.8" y="30.5" text-anchor="middle">TUNE</text>
          <g data-knob="level" class="knob">
            <circle cx="49.8" cy="20" r="6.5" fill="url(#pedal-knob)" stroke="#000" stroke-width=".4"/>
            <line x1="49.8" y1="20" x2="49.8" y2="14.5" stroke="#f3fff7" stroke-width="1.2" stroke-linecap="round"/>
          </g>
          <text class="face" x="49.8" y="30.5" text-anchor="middle">LEVEL</text>
          <!-- I²C OLED behind its window -->
          <rect x="12.75" y="33.6" width="40" height="14" rx="1.2" fill="#020604" stroke="#0b1c14" stroke-width=".8"/>
          <g class="oled">
            <text data-oled-top x="14.5" y="37.6">2m  SIM  MUTE</text>
            <text data-oled-freq class="big" x="14.5" y="43.4">145.795</text>
            <text x="45.2" y="43.4" class="small">MHz</text>
            <rect x="14.5" y="44.1" width="36.5" height="1.0" fill="none" stroke="#7fe6ff" stroke-width=".25"/>
            <rect data-oled-bar x="14.5" y="44.1" width="0" height="1.0" fill="#7fe6ff"/>
            <text data-oled-note x="14.5" y="47.3" class="tiny">input 0%</text>
          </g>
          <!-- ENGAGE light; the OLED shows signal strength -->
          <circle data-status-led cx="32.8" cy="55.6" r="2.2" fill="#3a1412" stroke="#0b1c14" stroke-width=".5"/>
          <text class="face" x="32.8" y="61.5" text-anchor="middle">ON</text>
          <g data-toggle class="hit">
            <rect x="39.75" y="79.6" width="12" height="16" fill="transparent"/>
            <circle cx="45.75" cy="87.6" r="2.6" fill="url(#pedal-metal)"/>
            <line data-toggle-bat x1="45.75" y1="87.6" x2="45.75" y2="81.6" stroke="#dfe5e2" stroke-width="1.6" stroke-linecap="round"/>
          </g>
          <text class="face" x="45.75" y="78.5" text-anchor="middle">2 m</text>
          <text class="face" x="45.75" y="99.5" text-anchor="middle">70 cm</text>
          <text class="face" x="54.5" y="88.6" text-anchor="start">BAND</text>
          <g data-footswitch class="hit">
            <circle cx="32.75" cy="104.6" r="7.5" fill="url(#pedal-metal)" stroke="#4b5550" stroke-width=".5"/>
            <circle data-footswitch-cap cx="32.75" cy="104.6" r="5.2" fill="#c5ccc8" stroke="#6f7a74" stroke-width=".4"/>
          </g>
          <text class="face" x="32.75" y="116.5" text-anchor="middle">ENGAGE</text>
        </svg>
        <figcaption>Drawn to scale from the <a href={pedalDoc}>pedal’s drilling template</a> on a 125B box, 121 × 66 mm: knobs up top, footswitch at the bottom, signal flowing right to left. Drag a knob sideways to turn it, tap BAND or stomp ENGAGE. In pass mode, tap TUNE to switch between 5 kHz and 1 kHz steps.</figcaption>
      </figure>
      <div class="rig-controls">
        <div class="scope">
          <svg viewBox="0 0 400 80" preserveAspectRatio="none" role="img" aria-label="Simulated receiver waveform"><path d="M0 40H400 M100 0V80 M200 0V80 M300 0V80" stroke="#264239" fill="none" vector-effect="non-scaling-stroke"/><polyline data-wave points="0,40 400,40" fill="none" stroke="#8dffb6" stroke-width="2" vector-effect="non-scaling-stroke"/></svg>
          <output data-display aria-live="off">145.795 MHz · muted</output>
        </div>
        <div class="spectrum">
          <svg viewBox="0 0 400 64" preserveAspectRatio="none" role="img" aria-labelledby="spec-label">
            <title id="spec-label">Spectrum around the tuning: the shaded window is what the receiver hears, the spike is the satellite's carrier.</title>
            <rect data-pb x="185" y="0" width="30" height="52" fill="#1d4a33"/>
            <line x1="200" x2="200" y1="0" y2="52" stroke="#8dffb6" stroke-dasharray="2 2" vector-effect="non-scaling-stroke"/>
            <polyline data-spec-noise points="0,48 400,48" fill="none" stroke="#3f6f56" vector-effect="non-scaling-stroke"/>
            <line data-spec-carrier x1="-10" x2="-10" y1="48" y2="10" stroke="#ffd36b" stroke-width="3" vector-effect="non-scaling-stroke"/>
          </svg>
          <div class="spec-axis"><span>−20 kHz</span><span>tuned here</span><span>+20 kHz</span></div>
          <p data-spec-note class="spec-note">The carrier is 5 kHz above your tuning, outside the window.</p>
        </div>
        <div class="controls">
          <label>BAND<select data-band><option value="2">2 m</option><option value="70">70 cm</option></select></label>
          <fieldset><legend>TUNE</legend><div><button data-down aria-label="Tune down">−</button> <button data-up aria-label="Tune up">+</button></div></fieldset>
          <label>GAIN <output data-gain-label>0 dB (×1)</output><input data-gain type="range" min="0" max="42" step="1" value="0" /></label>
          <label>LEVEL <output data-level-label>25%</output><input data-volume type="range" min="0" max="100" value="25" /></label>
        </div>
        <div class="actions"><button data-engage aria-pressed="false">ENGAGE</button><button data-check>Check setting</button><button data-reset>Restart</button></div>
        <p data-feedback role="status"></p>
        <div class="chain" role="group" aria-label="Signal chain, antenna to output. Tap a stage to see what it is doing.">
          <ol data-chain></ol>
          <p data-chain-why class="chain-why" aria-live="polite">Tap a stage to see what it does. A red stage is where the signal is stopped.</p>
        </div>
        <div class="experiments" id="pedal-experiments" data-experiments>
          <h3>Predict, then test</h3>
          <p class="note">Pick what you think will happen, then try it on the pedal. The trainer notices when you do it. <span data-exp-count>0 of {EXPERIMENTS.length} done.</span></p>
          <ol>
            {EXPERIMENTS.map((e, i) => (
              <li class="exp" data-exp={e.id}>
                <p class="q"><strong>{i + 1}.</strong> {e.question}</p>
                <fieldset><legend class="sr-only">Your prediction</legend>
                  {e.choices.map((c, n) => <label class="choice"><input type="radio" name={`exp-${e.id}`} value={n} /> {c}</label>)}
                </fieldset>
                <p class="task" data-exp-task hidden><strong>Now try it:</strong> {e.task}</p>
                <p class="result" data-exp-result role="status"></p>
              </li>
            ))}
          </ol>
        </div>
        <div class="pass" data-pass-panel>
          <h3>Pass mode: follow the Doppler shift</h3>
          <p class="note">A satellite rises, passes 45° up and sets in about 10 minutes, shown 20 times faster. Its 145.800 MHz signal arrives about 3.4 kHz high as it comes toward you and 3.4 kHz low as it leaves. Keep it within 1.5 kHz to hear it. The same model runs in the station’s <a href={stationSim}>receiver simulator</a>.</p>
          <div class="actions"><button data-pass-start>Start a pass</button><button data-step aria-pressed="false">TUNE step: 5 kHz</button></div>
          <svg class="sky" viewBox="0 0 400 60" preserveAspectRatio="none" role="img" aria-label="Elevation of the simulated satellite over the pass"><path data-sky-path d="M0 60" fill="none" stroke="#3f6f56" vector-effect="non-scaling-stroke"/><circle data-sky-sat cx="-10" cy="60" r="4" fill="#ffd36b"/></svg>
          <output data-pass-readout aria-live="off">Press Start a pass.</output>
          <p data-pass-result role="status"></p>
          <figure class="pass-chart" data-pass-chart hidden>
            <svg viewBox="0 0 400 120" preserveAspectRatio="none" role="img" aria-labelledby="pass-chart-label">
              <title id="pass-chart-label">After the pass: the satellite's Doppler shift against your tuning. The shaded band is what you could hear.</title>
              <g data-pass-chart-body></g>
            </svg>
            <figcaption><span class="k dop"></span>satellite (Doppler) <span class="k you"></span>your tuning ±1.5 kHz <span class="k miss"></span>not heard · desk simulation</figcaption>
          </figure>
          <p data-pass-tip class="pass-tip"></p>
        </div>
      </div>
    </div>
  </div>
  <p class="mt-3 max-w-2xl text-sm text-muted">On paper, sketch the path from the antenna through GAIN to the output LEVEL. Mark where the signal clipped.</p>

  <details class="inside mt-5" id="pedal-inside">
    <summary>Look inside the pedal</summary>
    <p class="mt-3 max-w-2xl text-sm text-muted">This is the <a class="underline" href={revA}>CSC-R1 Rev A dev kit</a>, drawn from its KiCad design. The <a class="underline" href={pedalDoc}>CSC-R1P pedal</a> uses the same radio parts on a narrower board that fits the box, with a second board under the face for the knobs and display. Neither board has been built or tested yet. Tap a number to read what that part does.</p>
    <figure class="board mt-3">
      <div class="board-img">
        <Image src={board} widths={[480, 960, 1417]} sizes="(min-width: 768px) 760px, 100vw" alt="Top side of the CSC-R1 Rev A receiver board: a red circuit board, 120 × 78 mm, with the antenna jack on the left edge, the radio parts in a row across the middle and the XIAO sockets at the top right." loading="lazy" />
        {parts.map((p) => <a class="spot" href={`#pedal-part-${p.n}`} style={`left:${p.left}%;top:${p.top}%`} aria-label={`Part ${p.n}: ${p.name}`}>{p.n}</a>)}
      </div>
      <figcaption class="mt-2 text-xs text-muted">Signal path, left to right: antenna, amplifier, band filters, demodulator, ADC, then the XIAO. Positions are from the board’s pick-and-place file.</figcaption>
    </figure>
    <ol class="parts mt-4 max-w-2xl text-sm">
      {parts.map((p) => (
        <li id={`pedal-part-${p.n}`}>
          <span class="num" aria-hidden="true">{p.n}</span>
          <div><strong>{p.name}</strong><p class="text-muted">{p.job}{p.terms.length > 0 && <> Wiki: {p.terms.map(([slug, label], i) => <>{i > 0 && ', '}<a class="underline" href={wiki(slug)}>{label}</a></>)}.</>}</p></div>
        </li>
      ))}
    </ol>
    <h3 class="mt-5 text-base">What the pedal adds to the kit</h3>
    <ul class="mt-2 max-w-2xl list-disc space-y-1 pl-5 text-sm text-muted">
      <li><strong>Control board:</strong> the OLED display, TUNE encoder, GAIN and LEVEL pots, BAND toggle, ENGAGE footswitch and light, read by a second I/O expander and a small ADC.</li>
      <li><strong>Pedal power and sound:</strong> a 9 V center-negative jack with reverse-polarity protection and a switching regulator, and a ¼ inch OUT jack fed by an audio DAC.</li>
      <li><strong>Later (Rev B):</strong> a <a class="underline" href={wiki('915-mhz')}>902–928 MHz</a> HaLow radio and power monitors. They are left out of this first pedal so it only listens.</li>
    </ul>
    <p class="mt-2 max-w-2xl text-sm text-muted">The receiver only listens on the <a class="underline" href={wiki('amateur-satellite-band')}>amateur satellite bands</a>, for signals from satellites like the <a class="underline" href={wiki('iss')}>ISS</a>. Details: <a class="underline" href={pedalDoc}>CSC-R1P pedal</a> · <a class="underline" href={plan}>Rev B plan</a>.</p>
  </details>

  <div class="mt-5 max-w-2xl text-sm">
    <h3>Try it at home with a USB receiver</h3>
    <p class="mt-2 text-muted">In the U.S., you can listen to public FM broadcasts with a receive-only USB SDR and antenna without an amateur radio license. Ask an adult to help plug in the receiver and open its tuning app.</p>
    <ol class="mt-2 list-decimal space-y-2 pl-5 text-muted">
      <li>Choose wide FM (WFM) and tune to a local FM station. Start with the speaker volume low.</li>
      <li>On paper, write down the frequency in MHz and the receiver gain. Move the antenna and note whether the station sounds clearer.</li>
      <li>Compare two gain settings. Then change only the speaker volume. Write down which control affected reception and which changed how loud it sounded.</li>
    </ol>
    <p class="mt-3 text-muted">The physical pedal is a prototype design. Its XIAO’s Wi-Fi transmits data, and the planned HaLow radio would too. Use the browser or a receive-only USB SDR for this lesson. <a class="underline" href="https://www.fcc.gov/media/radio/fm-query">Find a U.S. FM station</a> · <a class="underline" href={plan + '#controls'}>Pedal control design</a></p>
  </div>
</section>
<style>
  .console { background:#081410; color:#bdf5ce; border:1px solid #37674a; border-radius:.65rem; padding:clamp(1rem,3vw,2rem); font-family:var(--font-mono); }
  header,.actions,.controls { display:flex; align-items:center; gap:1rem; flex-wrap:wrap; }
  header { letter-spacing:.09em; }
  #pedal-task { margin:1rem 0; color:white; }
  .rig { display:grid; gap:1.25rem; align-items:start; }
  @media (min-width: 48rem) { .rig { grid-template-columns:minmax(14rem,19rem) 1fr; } }
  .pedal { margin:0 auto; width:100%; max-width:19rem; }
  .pedal svg { display:block; width:100%; height:auto; touch-action:pan-y; user-select:none; }
  .pedal figcaption { margin-top:.5rem; font-size:.75rem; line-height:1.4; color:#9fcbb0; font-family:var(--font-sans, inherit); }
  .pedal figcaption a { text-decoration:underline; }
  .lbl text { fill:#9fcbb0; font-size:3.4px; font-family:var(--font-mono); }
  .face { fill:#e8fff0; font-size:3px; font-weight:700; letter-spacing:.06em; font-family:var(--font-mono); }
  .oled text { fill:#7fe6ff; font-size:2.6px; font-family:var(--font-mono); }
  .oled .big { font-size:5px; font-weight:700; }
  .oled .small { font-size:2.3px; }
  .knob { cursor:grab; transition:transform .15s ease-out; }
  .knob:active { cursor:grabbing; }
  .hit { cursor:pointer; }
  [data-toggle-bat] { transition:transform .12s ease-out; }
  [data-footswitch-cap] { transition:transform .08s; transform-origin:32.75px 104.6px; }
  .hit:active [data-footswitch-cap] { transform:scale(.9); }
  [data-status-led] { transition:fill .15s; }
  .oled .tiny { font-size:2.3px; }
  .pass { margin-top:1.25rem; border-top:1px solid #37674a; padding-top:1rem; }
  .pass h3 { color:white; font-size:1rem; }
  .pass .note { margin:.5rem 0; font-size:.8rem; color:#9fcbb0; font-family:var(--font-sans, inherit); }
  .pass .note a { text-decoration:underline; }
  .sky { display:block; width:100%; height:3.5rem; margin:.75rem 0 .5rem; background:#04100b; border:1px solid #37674a; }
  [data-pass-result]:not(:empty) { margin-top:.5rem; color:white; }
  @media (prefers-reduced-motion: reduce) { .knob,[data-toggle-bat],[data-footswitch-cap] { transition:none; } }
  .scope { background:#04100b; border:1px solid #37674a; padding:.7rem; }
  .scope svg { display:block; width:100%; height:5rem; }
  .controls { margin:1rem 0; align-items:start; }
  .controls label,.controls fieldset { min-width:7rem; flex:1; }
  .controls select,.controls input { display:block; width:100%; }
  button,select { border:1px solid #638b70; color:#dcffe6; background:#152c20; border-radius:.25rem; min-height:44px; padding:.4rem .8rem; cursor:pointer; }
  input { min-height:44px; accent-color:#93f5aa; }
  button[aria-pressed=true] { background:#bdf5ce; color:#081410; }
  [data-feedback]:not(:empty) { margin-top:1rem; }
  .inside summary { cursor:pointer; font-weight:700; min-height:44px; display:flex; align-items:center; }
  .board-img { position:relative; max-width:47.5rem; border-radius:.4rem; overflow:hidden; }
  .board-img :global(img) { display:block; width:100%; height:auto; }
  .spot { position:absolute; transform:translate(-50%,-50%); width:1.6rem; height:1.6rem; border-radius:999px; background:#081410; color:#fff; border:2px solid #fff; font:700 .8rem/1.3rem var(--font-mono); text-align:center; text-decoration:none; box-shadow:0 1px 4px rgba(0,0,0,.5); }
  .spot:hover,.spot:focus-visible { background:#fff; color:#081410; }
  .parts { display:grid; gap:.75rem; }
  .parts li { display:flex; gap:.75rem; align-items:flex-start; scroll-margin-top:5rem; border-radius:.4rem; padding:.25rem; }
  .parts li:target { outline:2px solid currentColor; }
  .num { flex:none; width:1.6rem; height:1.6rem; border-radius:999px; background:#081410; color:#fff; font:700 .8rem/1.6rem var(--font-mono); text-align:center; }
  /* Spectrum: what the tuner hears (shaded) and where the carrier is (gold) */
  .spectrum { margin-top:.6rem; border:1px solid #264239; border-radius:.25rem; padding:.4rem .5rem .5rem; }
  .spectrum svg { display:block; width:100%; height:4rem; }
  .spec-axis { display:flex; justify-content:space-between; font-size:.68rem; color:#7fae90; }
  .spec-note { margin-top:.25rem; font-size:.8rem; color:#dcffe6; font-family:var(--font-sans, inherit); }
  /* Signal chain: one button per stage, coloured by what it is doing */
  .chain { margin-top:.75rem; }
  .chain :global(ol) { display:grid; grid-template-columns:repeat(auto-fit, minmax(6.4rem, 1fr)); gap:.35rem; list-style:none; padding:0; margin:0; }
  .chain :global(button) { border:1px solid #638b70; color:#dcffe6; background:#152c20; border-radius:.25rem; cursor:pointer; width:100%; min-height:4.2rem; display:grid; align-content:start; gap:.15rem; padding:.4rem .45rem; text-align:left; font-size:.72rem; line-height:1.25; }
  .chain :global(.nm) { font-weight:700; color:#fff; }
  .chain :global(.nw) { color:#9fcbb0; font-family:var(--font-sans, inherit); }
  .chain :global(.dot) { width:.55rem; height:.55rem; border-radius:50%; background:#3d5a49; }
  .chain :global([data-status="ok"] .dot) { background:#8dffb6; }
  .chain :global([data-status="warn"] .dot) { background:#ffd36b; }
  .chain :global([data-status="stop"]) { border-color:#ef6b6c; }
  .chain :global([data-status="stop"] .dot) { background:#ef6b6c; }
  .chain :global([data-status="idle"]) { opacity:.75; }
  .chain :global(.first-stop) { box-shadow:0 0 0 2px #ef6b6c55; }
  .chain :global(button[aria-pressed=true]) { background:#21402f; color:#dcffe6; outline:2px solid #bdf5ce; }
  .chain-why { margin-top:.45rem; min-height:2.6em; font-size:.82rem; color:#fff; font-family:var(--font-sans, inherit); }
  @media (prefers-reduced-motion: no-preference) { .chain :global(.first-stop .dot) { animation:blink 1.2s ease-in-out infinite; } }
  @keyframes blink { 50% { opacity:.35; } }
  /* Predict, then test */
  .experiments { margin-top:1.25rem; border-top:1px solid #37674a; padding-top:1rem; }
  .experiments h3 { color:white; font-size:1rem; }
  .experiments .note { margin:.5rem 0; font-size:.8rem; color:#9fcbb0; font-family:var(--font-sans, inherit); }
  .experiments ol { display:grid; gap:.6rem; list-style:none; padding:0; }
  .exp { border:1px solid #264239; border-radius:.3rem; padding:.6rem .7rem; font-family:var(--font-sans, inherit); font-size:.85rem; }
  .exp[data-done] { border-color:#8dffb6; }
  .exp .q { color:#fff; }
  .exp fieldset { display:flex; flex-wrap:wrap; gap:.35rem .9rem; margin-top:.35rem; border:0; padding:0; }
  .exp .choice { display:inline-flex; align-items:center; gap:.35rem; min-height:44px; cursor:pointer; }
  .exp .choice input { min-height:auto; }
  .exp .task { margin-top:.3rem; color:#ffd36b; }
  .exp .result:not(:empty) { margin-top:.3rem; color:#dcffe6; }
  /* After a pass */
  .pass-chart { margin:.75rem 0 0; }
  .pass-chart svg { display:block; width:100%; height:8rem; border:1px solid #264239; border-radius:.25rem; }
  .pass-chart figcaption { margin-top:.25rem; font-size:.7rem; color:#9fcbb0; }
  .pass-chart .k { display:inline-block; width:.8rem; height:.25rem; margin:0 .25rem 0 .5rem; vertical-align:middle; }
  .pass-chart .k.dop { background:#ffd36b; }
  .pass-chart .k.you { background:#1d5a3a; border-top:2px solid #8dffb6; height:.45rem; }
  .pass-chart .k.miss { background:#ef6b6c; height:.35rem; }
  .pass-tip:not(:empty) { margin-top:.5rem; color:#fff; font-family:var(--font-sans, inherit); font-size:.85rem; }
</style>
<script>
  import { TASKS, check as checkStep, clampOffset, frequencyMHz, inputPercent, knobAngle, signal as computeSignal, tuneAngle, GAIN_MAX_DB, TUNE_DEGREES_PER_STEP as TUNE_DEGREES, chain, carrierOffsetKhz, EXPERIMENTS, judge, gainTimes } from '../lib/pedal.mjs';
  import { makePass, score, passDebrief, STEPS_HZ, PASSBAND_HZ } from '../lib/pass.mjs';

  const panel = document.querySelector<HTMLElement>('#pedal-lab')!;
  const get = <T extends Element>(name: string) => panel.querySelector<T>(name)!;
  const band = get<HTMLSelectElement>('[data-band]');
  const gain = get<HTMLInputElement>('[data-gain]');
  const volume = get<HTMLInputElement>('[data-volume]');
  let engaged = false, offset = -1, stage = 0, sawClip = false;
  // Pass mode: a simulated pass at 20 times real speed, tuned in Hz from 145.800 MHz.
  const pass = makePass();
  const SPEED = 20, FRAME_MS = 100;
  let passS: number | null = null, passOffsetHz = 0, stepIndex = 0, passTimer = 0, lastLogged = -1;
  let passLog: { passS: number; inView: boolean; heard: boolean; decoded: boolean; dopplerHz: number; tunedOffsetHz: number }[] = [];
  const passState = () => passS === null ? null : pass.at(passS, { gainDb: Number(gain.value), tunedHz: band.value === '2' ? pass.nominalHz + passOffsetHz : 0 });
  // Keep the input waveform stable while learners compare settings.
  const noise = Array.from({ length: 201 }, () => Math.random() * 2 - 1);
  const signal = () => computeSignal(noise, { band: band.value, offset, gainDb: Number(gain.value) });
  const rotate = (el: Element, deg: number, cx: number, cy: number) => el.setAttribute('transform', `rotate(${deg} ${cx} ${cy})`);

  function renderPedal(tuned: boolean, peak: number, frequency: number, clipping: boolean) {
    rotate(get('[data-knob="gain"]'), knobAngle(Number(gain.value), 0, GAIN_MAX_DB), 15.8, 20);
    rotate(get('[data-knob="level"]'), knobAngle(Number(volume.value), 0, 100), 49.8, 20);
    rotate(get('[data-knob="tune"]'), passS === null ? tuneAngle(offset) : (passOffsetHz / 1000) * TUNE_DEGREES, 32.8, 20);
    rotate(get('[data-toggle-bat]'), band.value === '2' ? 0 : 180, 45.75, 87.6);
    get('[data-status-led]').setAttribute('fill', engaged ? '#ff4d3d' : '#3a1412');
    get('[data-oled-top]').textContent = (band.value === '2' ? '2m ' : '70cm') + (passS === null ? '  SIM  ' : '  PASS ') + (engaged ? 'ON' : 'MUTE');
    get('[data-oled-freq]').textContent = frequency.toFixed(3);
    get('[data-oled-bar]').setAttribute('width', String(36.5 * Math.min(1, peak)));
    get('[data-oled-note]').textContent = clipping ? 'input CLIP' : 'input ' + inputPercent(peak) + '%' + (tuned && band.value === '2' ? '  ISS' : '');
  }

  function render() {
    const state = passState();
    let tuned: boolean, samples: number[], peak: number, frequency: number;
    if (state) {
      // Pass mode: the carrier's size follows the simulated SNR; noise stays put.
      tuned = state.heard;
      const carrier = state.heard ? Math.min(0.9, 0.08 * 10 ** (state.snrDb / 20)) : 0;
      samples = noise.map((n, i) => carrier * Math.sin((i * Math.PI) / 20) + 0.08 * n);
      peak = 10 ** (state.adcDbfs / 20);
      frequency = (band.value === '2' ? pass.nominalHz + passOffsetHz : 435_000_000) / 1e6;
      get('[data-display]').textContent = frequency.toFixed(3) + ' MHz · ' + state.dbfs.toFixed(0) + ' dBFS · ' +
        (state.heard ? 'carrier heard' : state.inView ? 'carrier outside the passband' : 'satellite below the horizon') + (engaged ? ' · output on' : ' · muted');
    } else {
      ({ tuned, samples, peak } = signal());
      if (stage === 2 && engaged && tuned && peak > 1) sawClip = true;
      frequency = frequencyMHz(band.value, offset);
      get('[data-display]').textContent = frequency.toFixed(3) + ' MHz · input ' + (peak > 1 ? 'over 100' : inputPercent(peak)) + '% · ' +
        (peak > 1 ? 'CLIPPING' : 'within range') + (engaged ? ' · output on' : ' · muted');
    }
    get('[data-wave]').setAttribute('points', samples.map((raw, i) => {
      // Clip at the input, before LEVEL: turning LEVEL down shrinks a clipped wave, it can't unflatten it.
      const sample = Math.max(-1, Math.min(1, raw));
      return (2 * i) + ',' + (40 - (engaged ? sample * Number(volume.value) / 100 * 37 : 0));
    }).join(' '));
    get('[data-engage]').setAttribute('aria-pressed', String(engaged));
    get('[data-gain-label]').textContent = `${gain.value} dB (×${gainTimes(Number(gain.value))})`;
    // Where the carrier is relative to the tuning, in kHz (null: the band filter blocks it).
    const offsetKhz = state
      ? (band.value === '2' && state.inView ? state.offsetHz / 1000 : null)
      : carrierOffsetKhz(band.value, offset);
    renderSpectrum(offsetKhz, peak, state ? state.heard : tuned);
    renderChain(chain({ band: band.value, offsetKhz, peak, gainDb: Number(gain.value), level: Number(volume.value), engaged, passbandKhz: PASSBAND_HZ / 1000 }));
    if (!state) watchExperiments({ band: band.value, offset, gainDb: Number(gain.value), level: Number(volume.value), engaged, peak, tuned });
    get('[data-level-label]').textContent = volume.value + '%';
    const task = get('#pedal-task');
    const want = passS === null ? TASKS[stage] : 'Pass · Keep the carrier within 1.5 kHz as the Doppler shift changes. Tap TUNE for 1 kHz steps.';
    if (task.textContent !== want) task.textContent = want;
    renderPedal(tuned, peak, frequency, state?.clipping ?? peak > 1);
    if (state) renderPass(state);
  }

  // ---- Spectrum: ±20 kHz around the tuning, the passband window and the carrier ----
  const specNoise = Array.from({ length: 81 }, () => Math.random());
  function renderSpectrum(offsetKhz: number | null, peak: number, heard: boolean) {
    const x = (k: number) => 200 + k * 10; // 10 px per kHz, ±20 kHz across 400
    const pb = get('[data-pb]');
    pb.setAttribute('x', String(x(-PASSBAND_HZ / 1000)));
    pb.setAttribute('width', String((2 * PASSBAND_HZ / 1000) * 10));
    pb.setAttribute('fill', heard ? '#1d5a3a' : '#1d4a33');
    const floor = 50 - Math.min(12, Number(gain.value) / 4);
    get('[data-spec-noise]').setAttribute('points', specNoise.map((n, i) => `${i * 5},${(floor - n * 4).toFixed(1)}`).join(' '));
    const c = get('[data-spec-carrier]');
    const note = get('[data-spec-note]');
    if (offsetKhz === null || Math.abs(offsetKhz) > 20) {
      c.setAttribute('x1', '-10'); c.setAttribute('x2', '-10');
      note.textContent = offsetKhz === null
        ? (band.value === '70' ? 'No carrier: the 70 cm band filter blocks the 145.800 MHz satellite.' : 'No carrier: the satellite is below the horizon.')
        : `The carrier is ${Math.round(Math.abs(offsetKhz))} kHz ${offsetKhz > 0 ? 'above' : 'below'} your tuning, off this view.`;
      return;
    }
    const top = Math.max(4, floor - 8 - Math.min(1.4, peak) * 26);
    c.setAttribute('x1', String(x(offsetKhz))); c.setAttribute('x2', String(x(offsetKhz)));
    c.setAttribute('y1', String(floor)); c.setAttribute('y2', top.toFixed(1));
    const k = Math.abs(offsetKhz) < 10 ? Math.abs(offsetKhz).toFixed(1).replace(/\.0$/, '') : Math.round(Math.abs(offsetKhz));
    note.textContent = heard
      ? (Math.abs(offsetKhz) < 0.05 ? 'The carrier is right on your tuning, inside the window: you hear it.' : `The carrier is ${k} kHz ${offsetKhz > 0 ? 'above' : 'below'} your tuning, inside the window: you hear it.`)
      : `The carrier is ${k} kHz ${offsetKhz > 0 ? 'above' : 'below'} your tuning, outside the window. Turn TUNE ${offsetKhz > 0 ? 'up' : 'down'}.`;
  }

  // ---- Signal chain: each stage's live state; tap one to read why ----
  let chainPick = '';
  function renderChain(blocks: ReturnType<typeof chain>) {
    const list = get('[data-chain]');
    if (!list.children.length) {
      list.innerHTML = blocks.map(b => `<li><button type="button" data-stage="${b.id}"><span class="dot" aria-hidden="true"></span><span class="nm"></span><span class="nw"></span></button></li>`).join('');
      for (const btn of list.querySelectorAll<HTMLButtonElement>('[data-stage]')) {
        btn.addEventListener('click', () => { chainPick = chainPick === btn.dataset.stage ? '' : btn.dataset.stage!; render(); });
      }
    }
    const firstStop = blocks.find(b => b.status === 'stop');
    blocks.forEach((b, i) => {
      const btn = list.children[i].querySelector<HTMLButtonElement>('button')!;
      btn.dataset.status = b.status;
      btn.querySelector('.nm')!.textContent = b.name;
      btn.querySelector('.nw')!.textContent = b.now;
      btn.setAttribute('aria-pressed', String(chainPick === b.id));
      btn.setAttribute('aria-label', `${b.name}: ${b.now}${b.status === 'stop' ? '. The signal is stopped here.' : ''}`);
      btn.classList.toggle('first-stop', b === firstStop);
    });
    const pick = blocks.find(b => b.id === chainPick);
    const why = get('[data-chain-why]');
    const text = pick ? `${pick.name}: ${pick.why}` : firstStop ? `Stopped at ${firstStop.name}: ${firstStop.why}` : 'The signal gets all the way through. Tap a stage to see what it does.';
    if (why.textContent !== text) why.textContent = text;
  }

  // ---- Predict, then test ----
  type Reading = { band: string; offset: number; gainDb: number; level: number; engaged: boolean; peak: number; tuned: boolean };
  const expState = new Map<string, { choice: number; anchor: Reading | null; done: boolean }>();
  let lastReading: Reading | null = null;
  function watchExperiments(now: Reading) {
    const changed = !lastReading || JSON.stringify(lastReading) !== JSON.stringify(now);
    if (!changed) return;
    for (const e of EXPERIMENTS) {
      const st = expState.get(e.id);
      if (!st || st.done) continue;
      const anchor = st.anchor ?? lastReading ?? now;
      if (anchor !== now && e.done(anchor, now)) {
        st.done = true;
        const card = get(`[data-exp="${e.id}"]`);
        card.dataset.done = 'true';
        card.querySelector('[data-exp-result]')!.textContent = '✓ ' + judge(e, st.choice).text;
        card.querySelector<HTMLElement>('[data-exp-task]')!.hidden = true;
        const n = [...expState.values()].filter(s => s.done).length;
        get('[data-exp-count]').textContent = `${n} of ${EXPERIMENTS.length} done.`;
        continue;
      }
      st.anchor = e.keep && st.anchor && e.keep(st.anchor, now) ? st.anchor : now;
    }
    lastReading = now;
  }
  for (const e of EXPERIMENTS) {
    const card = get(`[data-exp="${e.id}"]`);
    card.addEventListener('change', ev => {
      const input = ev.target as HTMLInputElement;
      if (input.type !== 'radio') return;
      const prev = expState.get(e.id);
      if (prev?.done) return;
      expState.set(e.id, { choice: Number(input.value), anchor: null, done: false });
      card.querySelector<HTMLElement>('[data-exp-task]')!.hidden = false;
      card.querySelector('[data-exp-result]')!.textContent = 'Prediction saved. Now try it on the pedal.';
    });
  }

  // ---- After a pass: the Doppler shift against the learner's tuning ----
  function drawPassChart() {
    const seen = passLog.filter(s => s.inView);
    if (!seen.length) return;
    const W = 400, H = 120, top = 8, bottom = 112, range = 5000; // ±5 kHz
    const x = (s: number) => ((s - seen[0].passS) / Math.max(1, seen[seen.length - 1].passS - seen[0].passS)) * W;
    const y = (hz: number) => top + ((range - Math.max(-range, Math.min(range, hz))) / (2 * range)) * (bottom - top);
    const parts: string[] = [];
    parts.push(`<line x1="0" x2="${W}" y1="${y(0)}" y2="${y(0)}" stroke="#264239" />`);
    // Your tuning with its passband, where you were on 2 m.
    let band = '', line = '';
    for (const s of seen) {
      if (!Number.isFinite(s.tunedOffsetHz)) continue;
      band += `<rect x="${x(s.passS).toFixed(1)}" y="${y(s.tunedOffsetHz + PASSBAND_HZ).toFixed(1)}" width="${(W / seen.length + 0.6).toFixed(1)}" height="${(y(s.tunedOffsetHz - PASSBAND_HZ) - y(s.tunedOffsetHz + PASSBAND_HZ)).toFixed(1)}" fill="#1d5a3a" />`;
      line += `${line ? 'L' : 'M'}${x(s.passS).toFixed(1)} ${y(s.tunedOffsetHz).toFixed(1)}`;
    }
    parts.push(band, `<path d="${line}" fill="none" stroke="#8dffb6" stroke-width="1.5" vector-effect="non-scaling-stroke" />`);
    parts.push(`<path d="${seen.map((s, i) => `${i ? 'L' : 'M'}${x(s.passS).toFixed(1)} ${y(s.dopplerHz).toFixed(1)}`).join('')}" fill="none" stroke="#ffd36b" stroke-width="2" vector-effect="non-scaling-stroke" />`);
    for (const s of seen) if (!s.heard) parts.push(`<rect x="${x(s.passS).toFixed(1)}" y="${bottom + 2}" width="${(W / seen.length).toFixed(1)}" height="5" fill="#ef6b6c" />`);
    parts.push(`<text x="4" y="${y(range) + 9}" fill="#9fcbb0" font-size="8">+5 kHz</text><text x="4" y="${y(-range) - 2}" fill="#9fcbb0" font-size="8">−5 kHz</text>`);
    get('[data-pass-chart-body]').innerHTML = parts.join('');
    get<HTMLElement>('[data-pass-chart]').hidden = false;
    const tip = passDebrief(passLog);
    get('[data-pass-tip]').textContent = tip ? 'Next time: ' + tip.text : '';
  }

  function renderPass(state: ReturnType<typeof pass.at>) {
    const x = (s: number) => (400 * s) / pass.duration;
    const y = (el: number) => 58 - (54 * Math.max(0, el)) / 90;
    get('[data-sky-sat]').setAttribute('cx', String(x(state.passS)));
    get('[data-sky-sat]').setAttribute('cy', String(y(state.elevationDeg)));
    const off = (state.offsetHz / 1000).toFixed(1);
    get('[data-pass-readout]').textContent = state.inView
      ? `[desk simulation] elevation ${state.elevationDeg.toFixed(0)}° · range ${state.rangeKm.toFixed(0)} km · Doppler ${state.dopplerHz >= 0 ? '+' : ''}${(state.dopplerHz / 1000).toFixed(2)} kHz · you are ${off} kHz off · ${state.heard ? `SNR ${state.snrDb.toFixed(0)} dB` + (state.decoded ? ' · beacon decoded' : '') : 'not heard'}`
      : state.passS < 0 ? `[desk simulation] satellite rises in ${Math.ceil(-state.passS)} s` : '[desk simulation] satellite has set';
    get('[data-oled-note]').textContent = state.inView
      ? `EL ${state.elevationDeg.toFixed(0)}  ${state.heard ? 'SNR ' + state.snrDb.toFixed(0) + 'dB' : 'NO CARRIER'}${state.decoded ? ' BCN' : ''}`
      : state.passS < 0 ? 'WAITING FOR AOS' : 'LOS';
  }

  function drawSky() {
    const pts: string[] = [];
    for (let i = 0; i <= 80; i++) {
      const s = (pass.duration * i) / 80;
      const el = pass.at(s).elevationDeg;
      pts.push(`${i === 0 ? 'M' : 'L'}${(400 * s) / pass.duration} ${58 - (54 * Math.max(0, el)) / 90}`);
    }
    get('[data-sky-path]').setAttribute('d', pts.join(' '));
  }

  function stopPass(finished: boolean) {
    clearInterval(passTimer);
    passTimer = 0;
    get('[data-pass-start]').textContent = 'Start a pass';
    if (finished) {
      const { heard, decoded } = score(passLog);
      get('[data-pass-result]').textContent = `Pass complete (desk simulation): you heard the carrier for ${heard}% of the pass and decoded the beacon for ${decoded}%. On paper, write down when you had to retune and why.`;
      drawPassChart();
    }
    passS = null;
    render();
    get('[data-pass-readout]').textContent = 'Press Start a pass.';
  }

  function startPass() {
    if (passTimer) return stopPass(false);
    band.value = '2';
    passOffsetHz = 0;
    passLog = [];
    lastLogged = -1;
    passS = -10;
    get('[data-pass-result]').textContent = '';
    get<HTMLElement>('[data-pass-chart]').hidden = true;
    get('[data-pass-tip]').textContent = '';
    get('[data-pass-start]').textContent = 'Stop';
    drawSky();
    passTimer = window.setInterval(() => {
      passS! += (SPEED * FRAME_MS) / 1000;
      const whole = Math.floor(passS!);
      if (whole > lastLogged && whole >= 0) {
        const st = passState()!;
        passLog.push({ passS: whole, inView: st.inView, heard: st.heard && engaged, decoded: st.decoded && engaged, dopplerHz: st.dopplerHz, tunedOffsetHz: band.value === '2' ? passOffsetHz : NaN });
        lastLogged = whole;
      }
      if (passS! > pass.duration + 5) return stopPass(true);
      render();
    }, FRAME_MS);
    render();
  }

  const setStep = (i: number) => {
    stepIndex = i;
    const label = STEPS_HZ[i] / 1000 + ' kHz';
    get('[data-step]').textContent = 'TUNE step: ' + label;
    get('[data-step]').setAttribute('aria-pressed', String(i === 1));
    get('[data-tune-label]').textContent = i === 1 ? 'TUNE 1k' : 'TUNE';
  };

  function check() {
    const { tuned, peak } = signal();
    const result = checkStep({ stage, engaged, tuned, sawClip, peak, level: Number(volume.value) });
    stage = result.stage;
    if (result.feedback) get('[data-feedback]').textContent = result.feedback;
    render();
  }
  const engage = () => { engaged = !engaged; render(); if (stage === 0 && engaged) check(); };
  const tune = (delta: number) => {
    if (passS !== null) passOffsetHz = Math.max(-20_000, Math.min(20_000, passOffsetHz + delta * STEPS_HZ[stepIndex]));
    else offset = clampOffset(offset + delta);
    render();
  };
  get('[data-pass-start]').addEventListener('click', startPass);
  get('[data-step]').addEventListener('click', () => setStep(1 - stepIndex));
  get('[data-check]').addEventListener('click', check);
  get('[data-engage]').addEventListener('click', engage);
  get('[data-down]').addEventListener('click', () => tune(-1));
  get('[data-up]').addEventListener('click', () => tune(1));
  panel.addEventListener('input', render);
  get('[data-reset]').addEventListener('click', () => {
    if (passTimer) stopPass(false);
    setStep(0); get('[data-pass-result]').textContent = '';
    offset = -1; stage = 0; engaged = false; sawClip = false; band.value = '2'; gain.value = '0'; volume.value = '25';
    get('[data-feedback]').textContent = ''; render();
  });

  // The pedal drawing works too: stomp the footswitch, flip the toggle, drag or scroll a knob.
  // Every action also has a labelled control beside the drawing for keyboard and screen readers.
  get('[data-footswitch]').addEventListener('click', engage);
  get('[data-toggle]').addEventListener('click', () => { band.value = band.value === '2' ? '70' : '2'; render(); });
  const nudge = (name: string, steps: number) => {
    if (name === 'tune') return tune(steps);
    const input = name === 'gain' ? gain : volume;
    input.value = String(Number(input.value) + steps * (name === 'gain' ? 1 : 2));
    render();
  };
  for (const knob of panel.querySelectorAll<SVGGElement>('[data-knob]')) {
    const name = knob.dataset.knob!;
    let lastX = 0, lastY = 0, rest = 0, moved = false;
    knob.addEventListener('pointerdown', (e) => { lastX = e.clientX; lastY = e.clientY; rest = 0; moved = false; knob.setPointerCapture(e.pointerId); });
    // Pressing the TUNE encoder switches its step, like the real encoder's push switch.
    knob.addEventListener('pointerup', () => { if (name === 'tune' && !moved && passS !== null) setStep(1 - stepIndex); });
    knob.addEventListener('pointermove', (e) => {
      if (!knob.hasPointerCapture(e.pointerId)) return;
      // Drag right or up to turn clockwise. One step per 6 px (12 px for TUNE, like detents).
      // On a phone a vertical swipe scrolls the page, so sideways drags turn the knob.
      rest += (e.clientX - lastX) + (lastY - e.clientY); lastX = e.clientX; lastY = e.clientY;
      const size = name === 'tune' ? 12 : 6;
      const steps = Math.trunc(rest / size);
      if (steps) { moved = true; rest -= steps * size; nudge(name, steps); }
    });
    knob.addEventListener('wheel', (e) => { e.preventDefault(); nudge(name, e.deltaY < 0 ? 1 : -1); }, { passive: false });
  }
  render();
</script>
