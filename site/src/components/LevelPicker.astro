---
import { levels } from '../levels';

interface Props {
  describe?: boolean;
}

const { describe = false } = Astro.props;
---
<div class="level-picker">
  <fieldset>
    <legend class="text-sm font-bold text-ink">Pick your level</legend>
    <div class="mt-2 inline-flex flex-wrap gap-1 rounded-sm border border-line bg-white p-1">
      {levels.map(level => (
        <label class="cursor-pointer">
          <input class="peer sr-only" type="radio" name="level" value={level.id} checked={level.id === 'beginner'}>
          <span class="grid min-h-11 place-items-center rounded-[2px] px-3 py-2 text-sm font-semibold text-muted hover:text-ink peer-checked:bg-night peer-checked:text-white peer-focus-visible:outline-3 peer-focus-visible:outline-offset-2">{level.name}</span>
        </label>
      ))}
    </div>
  </fieldset>
  {describe && levels.map(level => (
    <p data-show={level.id} class="mt-3 max-w-sm text-sm text-muted">{level.who}</p>
  ))}
</div>

<script>
  // One level for the whole site, remembered for this visitor only.
  const KEY = 'cubesat.level';
  const valid = ['beginner', 'intermediate', 'professional'];

  function apply(level: string) {
    document.documentElement.dataset.level = level;
    for (const input of document.querySelectorAll<HTMLInputElement>('.level-picker input[name="level"]')) {
      input.checked = input.value === level;
    }
    document.dispatchEvent(new CustomEvent('levelchange', { detail: level }));
  }

  let saved = 'beginner';
  try {
    const stored = localStorage.getItem(KEY);
    if (stored && valid.includes(stored)) saved = stored;
  } catch {}

  // A step names its own level. The query supplies a level when there is no lesson step.
  function followLink() {
    let target: HTMLElement | null = null;
    try { target = document.getElementById(decodeURIComponent(location.hash.slice(1))); } catch { /* malformed fragment */ }
    const named = target?.closest<HTMLElement>('[data-show]')?.dataset.show;
    const query = new URLSearchParams(location.search).get('level');
    const linked = [named, query].find(level => level && valid.includes(level));
    apply(linked ?? saved);
    if (linked && target) requestAnimationFrame(() => target.scrollIntoView({ block: 'start' }));
  }

  followLink();
  addEventListener('hashchange', followLink);

  document.addEventListener('change', event => {
    const input = event.target as HTMLInputElement;
    if (input.name !== 'level' || !valid.includes(input.value)) return;
    saved = input.value;
    try { localStorage.setItem(KEY, saved); } catch {}
    apply(saved);
  });
</script>
