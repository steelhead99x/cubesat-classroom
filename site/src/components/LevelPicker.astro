---
import { levels } from '../levels';

interface Props {
  showIntro?: boolean;
  describe?: boolean;
}

const { showIntro = false, describe = false } = Astro.props;
---
<div class="level-picker">
  <fieldset>
    <legend class="text-sm font-bold text-ink">Pick your level</legend>
    <div class="mt-2 inline-flex flex-wrap gap-1 rounded-xl border border-line bg-white p-1">
      {levels.map(level => (
        <label class="cursor-pointer">
          <input class="peer sr-only" type="radio" name="level" value={level.id} checked={level.id === 'beginner'}>
          <span class="block rounded-lg px-4 py-2 text-sm font-semibold text-muted peer-checked:bg-night peer-checked:text-sky peer-checked:hover:text-sky peer-focus-visible:outline-3 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-blue-600 hover:text-ink">{level.name}</span>
        </label>
      ))}
    </div>
  </fieldset>
  {describe && levels.map(level => (
    <p data-show={level.id} class="mt-3 max-w-md text-sm text-muted"><strong class="text-ink">{level.who}.</strong> {level.intro}</p>
  ))}
  {showIntro && (
    <div class="mt-4 grid gap-3 md:grid-cols-3">
      {levels.map(level => (
        <div data-level-card={level.id} class="rounded-xl border border-line bg-white p-4 transition-colors data-[active]:border-night data-[active]:ring-2 data-[active]:ring-night/10">
          <p class="text-sm font-bold text-ink">{level.name}</p>
          <p class="mt-0.5 text-xs font-semibold text-faint">{level.who}</p>
          <p class="mt-2 text-sm text-muted">{level.intro}</p>
        </div>
      ))}
    </div>
  )}
</div>

<script>
  // One level for the whole site, remembered for this visitor only.
  const KEY = 'cubesat.level';
  const valid = ['beginner', 'intermediate', 'professional'];

  function apply(level: string) {
    document.documentElement.dataset.level = level;
    for (const input of document.querySelectorAll<HTMLInputElement>('.level-picker input[name="level"]')) {
      input.checked = input.value === level;
    }
    for (const card of document.querySelectorAll<HTMLElement>('[data-level-card]')) {
      card.toggleAttribute('data-active', card.dataset.levelCard === level);
    }
    document.dispatchEvent(new CustomEvent('levelchange', { detail: level }));
  }

  let saved = 'beginner';
  try { saved = localStorage.getItem(KEY) ?? 'beginner'; } catch {}
  apply(valid.includes(saved) ? saved : 'beginner');

  document.addEventListener('change', event => {
    const input = event.target as HTMLInputElement;
    if (input.name !== 'level' || !valid.includes(input.value)) return;
    try { localStorage.setItem(KEY, input.value); } catch {}
    apply(input.value);
  });
</script>
