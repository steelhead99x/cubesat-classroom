---
interface Props {
  icon: 'station' | 'balloon' | 'cube';
  name: string;
  description: string;
  action: string;
  href: string;
}

const { icon, name, description, action, href } = Astro.props;
const tones = {
  station: 'bg-blue-50 text-blue-700',
  balloon: 'bg-amber-100 text-amber-900',
  cube: 'bg-rose-50 text-signal',
};
---
<article class="flex min-w-0 flex-col items-start rounded-2xl border border-line bg-white p-5 sm:p-6">
  <span class={'grid size-10 place-items-center rounded-lg ' + tones[icon]}>
    <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      {icon === 'station' && <path d="m4 12 8 8m-1-1 4-4M7 15 4 20h7m-6-7a6 6 0 0 0 8-8L5 13Zm11-8a5 5 0 0 1 3 3m-2-6a8 8 0 0 1 5 5"/>}
      {icon === 'balloon' && <path d="M18 9a6 6 0 1 0-12 0c0 4 5 7 6 8 1-1 6-4 6-8Zm-8 9h4m-2 0v3"/>}
      {icon === 'cube' && <path d="m12 3 8 4.5v9L12 21l-8-4.5v-9L12 3ZM4 7.5l8 4.5 8-4.5M12 12v9"/>}
    </svg>
  </span>
  <h3 class="mt-4">{name}</h3>
  <p class="mt-2 mb-4 text-muted">{description}</p>
  <a class="mt-auto font-semibold underline underline-offset-4" href={href}>{action} <span aria-hidden="true">↗</span></a>
</article>
