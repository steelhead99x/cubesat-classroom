---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import LevelPicker from '../../components/LevelPicker.astro';
import PatchShelf from '../../components/PatchShelf.astro';
import QuestGuide from '../../components/QuestGuide.astro';
import FullExperience from '../../components/FullExperience.astro';
import { classroomHost } from '../../hubs.mjs';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const quests = (await getCollection('quests')).sort((a, b) => a.data.order - b.data.order);
const total = quests.reduce((sum, quest) => sum + quest.data.minutes, 0);
---
<Base title="Classroom lessons | CubeSat Classroom" description="Five browser lessons on satellite operations, each available at three levels." canonical={'https://' + classroomHost + '/quests/'}>
  <SiteHeader slot="header" home={base + '/'} links={[
    { label: 'Lessons', href: base + '/quests/', current: true },
    { label: 'Simulator', href: base + '/#demo' },
    { label: 'CAD', href: base + '/hardware/' },
    { label: 'For teachers', href: base + '/#teachers' },
  ]} />
  <div class="shell space-y-9 py-10 sm:py-14">
    <header class="grid items-end gap-5 lg:grid-cols-[1fr_auto]">
      <div>
        <h1>Classroom lessons</h1>
        <p class="lede mt-3">Five exercises in the browser ground station. Allow about {total} minutes for the full sequence.</p>
      </div>
      <LevelPicker describe />
    </header>
    <ol class="lesson-outline">
      {quests.map(quest => (
        <li>
          <span aria-hidden="true">{String(quest.data.order).padStart(2, '0')}</span>
          <div class="grid gap-x-5 gap-y-2 sm:grid-cols-[1fr_auto]">
            <div>
              <a href={`${base}/quests/${quest.id}/`} class="font-bold text-accent underline underline-offset-4">{quest.data.title}</a>
              <p class="mt-1">{quest.data.summary}</p>
            </div>
            <p class="sm:text-right">{quest.data.minutes} min · {quest.data.skill}</p>
          </div>
        </li>
      ))}
    </ol>
    <details class="reference-panel">
      <summary>Mission patches</summary>
      <div class="mt-5"><PatchShelf size={84} /></div>
    </details>
    <details class="reference-panel">
      <summary>Ground station questions</summary>
      <div class="mt-5"><QuestGuide title="satellites and ground stations" /></div>
    </details>
    <FullExperience />
  </div>
  <SiteFooter slot="footer" />
</Base>
