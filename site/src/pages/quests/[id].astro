---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import LevelPicker from '../../components/LevelPicker.astro';
import StationDemo from '../../components/StationDemo.astro';
import FullExperience from '../../components/FullExperience.astro';
import QuestGuide from '../../components/QuestGuide.astro';
import { repo } from '../../hubs.mjs';
import { siteOrigin } from '../../origin';
import { levels, inline } from '../../levels';

export async function getStaticPaths() {
  const quests = (await getCollection('quests')).sort((a, b) => a.data.order - b.data.order);
  return quests.map((quest, index) => ({
    params: { id: quest.id },
    props: { quest, next: quests[index + 1], total: quests.length },
  }));
}

const { quest, next, total } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const tool = quest.data.tool;
const toolHref = tool && (tool.href.startsWith('/') ? base + tool.href : tool.href);
const feedback = `${repo}/issues/new?template=feedback.yml&labels=feedback&title=${encodeURIComponent('Quest feedback: ' + quest.data.title)}`;
---
<Base title={quest.data.title + ' | Example quest | CubeSat Classroom'} description={quest.data.summary} canonical={`${siteOrigin}/quests/${quest.id}/`}>
  <SiteHeader slot="header" home={base + '/'} current="lessons" />
  <div class="section-band">
    <div class="shell grid items-end gap-5 py-8 sm:py-11 lg:grid-cols-[1fr_auto]">
      <div>
        <a class="tap text-sm font-bold text-accent underline underline-offset-4" href={base + '/quests/'}>All lessons</a>
        <p class="mt-4 text-sm text-muted">Lesson {quest.data.order} of {total} · {quest.data.minutes} min · {quest.data.skill}</p>
        <h1 class="mt-2 max-w-3xl">{quest.data.title}</h1>
        <p class="lede mt-3">{quest.data.summary}</p>
      </div>
      <LevelPicker />
    </div>
  </div>
  <div class="shell space-y-10 py-10">
    <div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.7fr)]">
      <article class="space-y-6">
        <p>On paper, write the lesson title and your level. Number your notes to match the steps. Tick each one when you finish it.</p>
        {levels.map(level => {
          const data = quest.data[level.id];
          return (
            <div data-show={level.id} class="space-y-6">
              <section aria-labelledby={`steps-${level.id}`}>
                <h2 id={`steps-${level.id}`} class="text-2xl">Steps for {level.name.toLowerCase()} crews</h2>
                <div class="quest-steps mt-4 text-muted"><ol>{data.steps.map((step, n) => (
                  <li id={`${level.id}-step-${n + 1}`} class="quest-step">
                    <span set:html={inline(step, base)} />
                    <a class="step-share" href={`#${level.id}-step-${n + 1}`} data-share aria-label={`Copy link to ${level.name.toLowerCase()} step ${n + 1}`}>Link<span data-copied hidden> · copied</span></a>
                  </li>
                ))}</ol></div>
              </section>
              <section id={`${level.id}-check`} class="border-l-2 border-accent bg-ground p-4" aria-labelledby={`check-${level.id}`}>
                <h3 id={`check-${level.id}`} class="text-base text-ink">Check your work</h3>
                <p class="mt-1 text-ink">{data.check}</p>
              </section>
              <section id={`${level.id}-discuss`} class="border-l-2 border-line bg-ground p-4" aria-labelledby={`discuss-${level.id}`}>
                <h3 id={`discuss-${level.id}`} class="text-base text-ink">Talk it over</h3>
                <p class="mt-1 text-ink">{data.discuss}</p>
              </section>
            </div>
          );
        })}
        <div class="flex flex-wrap items-center gap-3">
          <button type="button" data-complete={quest.id} class="button quiet disabled:cursor-default disabled:border-transparent disabled:bg-mint">Mark this quest done</button>
          {next
            ? <a class="button primary" href={`${base}/quests/${next.id}/`}>Next quest: {next.data.title}</a>
            : <a class="button primary" href={base + '/quests/'}>Back to all lessons</a>}
        </div>
        <p class="text-sm text-faint">Something unclear or wrong? <a class="font-bold text-ink underline underline-offset-4" href={feedback}>Suggest a change on GitHub</a>.</p>
      </article>
      {tool ? (
        <aside class="lesson-tool order-first self-start border-2 lg:order-none border-line bg-ground p-6" aria-labelledby="tool-title">
          <h2 id="tool-title" class="text-2xl">You need: {tool.name}</h2>
          <p class="mt-3 text-muted">{tool.note}</p>
          <p class="mt-5"><a class="button primary" href={toolHref} target="_blank" rel="noopener">Open {tool.name} <span class="sr-only">(opens in a new tab)</span></a></p>
          <p class="mt-4 text-sm text-faint">It opens in a new tab, so these steps stay here. Keep your notes on paper, with your team nickname, not your name.</p>
        </aside>
      ) : <StationDemo heading={false} />}
    </div>
    <details class="reference-panel">
      <summary>Get help with this lesson</summary>
      <div class="mt-5"><QuestGuide quest={quest.id} title={quest.data.title.toLowerCase()} /></div>
    </details>
    <FullExperience />
  </div>
  <SiteFooter slot="footer" />
</Base>

<script>
  import { earn, earned } from '../../patches';

  const button = document.querySelector<HTMLButtonElement>('[data-complete]');
  function sync() {
    if (!button) return;
    const done = earned().has(button.dataset.complete!);
    button.disabled = done;
    button.textContent = done ? 'Lesson complete' : 'Mark this quest done';
  }
  button?.addEventListener('click', () => earn(button.dataset.complete!));
  document.addEventListener('patchearned', sync);
  sync();
</script>

<script>
  // Copy a step's link (with the level in it, so it opens at that level for whoever follows it).
  // Without clipboard access it stays an ordinary link to the step.
  for (const link of document.querySelectorAll<HTMLAnchorElement>('[data-share]')) {
    link.addEventListener('click', async e => {
      if (e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || !navigator.clipboard) return;
      e.preventDefault();
      const url = new URL(link.href);
      try { await navigator.clipboard.writeText(url.href); } catch { location.hash = url.hash; return; }
      const note = link.querySelector<HTMLElement>('[data-copied]')!;
      note.hidden = false;
      setTimeout(() => { note.hidden = true; }, 2000);
    });
  }
</script>

<style>
  .quest-step { scroll-margin-top: 1.5rem; }
  .quest-step:target, section:target { outline: 3px solid var(--color-flag); outline-offset: 4px; border-radius: 2px; }
  .step-share { margin-left: .4rem; font-size: .8rem; font-weight: 600; color: var(--color-accent); text-decoration: underline; text-underline-offset: 3px; white-space: nowrap; }
  .quest-step :global(a:not(.step-share)) { color: var(--color-ink); font-weight: 600; text-decoration: underline; text-underline-offset: 3px; }
</style>
