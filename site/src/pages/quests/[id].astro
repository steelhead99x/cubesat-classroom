---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import LevelPicker from '../../components/LevelPicker.astro';
import StationDemo from '../../components/StationDemo.astro';
import FullExperience from '../../components/FullExperience.astro';
import QuestGuide from '../../components/QuestGuide.astro';
import { repo } from '../../hubs.mjs';
import { siteOrigin } from '../../origin';
import { levels, inline } from '../../levels';

export async function getStaticPaths() {
  const quests = (await getCollection('quests')).sort((a, b) => a.data.order - b.data.order);
  return quests.map((quest, index) => ({
    params: { id: quest.id },
    props: { quest, next: quests[index + 1], total: quests.length },
  }));
}

const { quest, next, total } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const feedback = `${repo}/issues/new?template=feedback.yml&labels=feedback&title=${encodeURIComponent('Quest feedback: ' + quest.data.title)}`;
---
<Base title={quest.data.title + ' | Example quest | CubeSat Classroom'} description={quest.data.summary} canonical={`${siteOrigin}/quests/${quest.id}/`}>
  <SiteHeader slot="header" home={base + '/'} links={[
    { label: 'Mission', href: base + '/mission/' },
    { label: 'Lessons', href: base + '/quests/', current: true },
    { label: 'Simulator', href: base + '/#demo' },
    { label: 'CAD', href: base + '/hardware/' },
    { label: 'Glossary', href: base + '/wiki/' },
    { label: 'For teachers', href: base + '/#teachers' },
  ]} />
  <div class="section-band">
    <div class="shell grid items-end gap-5 py-8 sm:py-11 lg:grid-cols-[1fr_auto]">
      <div>
        <a class="text-sm font-bold text-accent underline underline-offset-4" href={base + '/quests/'}>All lessons</a>
        <p class="mt-4 text-sm text-muted">Lesson {quest.data.order} of {total} · {quest.data.minutes} min · {quest.data.skill}</p>
        <h1 class="mt-2 max-w-3xl">{quest.data.title}</h1>
        <p class="lede mt-3">{quest.data.summary}</p>
      </div>
      <LevelPicker />
    </div>
  </div>
  <div class="shell space-y-10 py-10">
    <div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.7fr)]">
      <article class="space-y-6">
        {levels.map(level => {
          const data = quest.data[level.id];
          return (
            <div data-show={level.id} class="space-y-6">
              <section aria-labelledby={`steps-${level.id}`}>
                <h2 id={`steps-${level.id}`} class="text-2xl">Steps for {level.name.toLowerCase()} crews</h2>
                <div class="quest-steps mt-4 text-muted"><ol>{data.steps.map(step => <li set:html={inline(step)} />)}</ol></div>
              </section>
              <section class="border-l-2 border-accent bg-ground p-4" aria-labelledby={`check-${level.id}`}>
                <h3 id={`check-${level.id}`} class="text-base text-ink">Check your work</h3>
                <p class="mt-1 text-ink">{data.check}</p>
              </section>
              <section class="border-l-2 border-line bg-ground p-4" aria-labelledby={`discuss-${level.id}`}>
                <h3 id={`discuss-${level.id}`} class="text-base text-ink">Talk it over</h3>
                <p class="mt-1 text-ink">{data.discuss}</p>
              </section>
            </div>
          );
        })}
        <div class="flex flex-wrap items-center gap-3">
          <button type="button" data-complete={quest.id} class="button quiet disabled:cursor-default disabled:border-transparent disabled:bg-mint">Mark this quest done</button>
          {next
            ? <a class="button primary" href={`${base}/quests/${next.id}/`}>Next quest: {next.data.title}</a>
            : <a class="button primary" href={base + '/quests/'}>Back to all lessons</a>}
        </div>
        <p class="text-sm text-faint">Something unclear or wrong? <a class="font-bold text-ink underline underline-offset-4" href={feedback}>Suggest a change on GitHub</a>.</p>
      </article>
      <StationDemo heading={false} />
    </div>
    <details class="reference-panel">
      <summary>Get help with this lesson</summary>
      <div class="mt-5"><QuestGuide quest={quest.id} title={quest.data.title.toLowerCase()} /></div>
    </details>
    <FullExperience />
  </div>
  <SiteFooter slot="footer" />
</Base>

<script>
  import { earn, earned } from '../../patches';

  const button = document.querySelector<HTMLButtonElement>('[data-complete]');
  function sync() {
    if (!button) return;
    const done = earned().has(button.dataset.complete!);
    button.disabled = done;
    button.textContent = done ? 'Lesson complete' : 'Mark this quest done';
  }
  button?.addEventListener('click', () => earn(button.dataset.complete!));
  document.addEventListener('patchearned', sync);
  sync();
</script>
