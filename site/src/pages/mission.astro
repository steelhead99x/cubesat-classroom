---
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import FlightChart from '../components/FlightChart.astro';
import { publicSite, repo } from '../hubs.mjs';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const doc = (path: string) => repo + '/blob/main/' + path;
const rides = [
  { name: 'Perlan 2 glider', height: 'Up to 23 km (76,124 ft record)', air: 'Open science bay: sensors sit in outside air', float: 'None', text: 'An engineless glider that rides mountain waves over the Andes. Student CubeSat experiments have flown in its science bay.', href: doc('quest/m0/perlan-stratosphere.md'), action: 'Open the Perlan 2 quest' },
  { name: 'Research spaceship', height: 'About 87 km', air: 'Pressurised cabin: pressure stays nearly flat', float: 'About 3 minutes', text: 'Carried to about 13.6 km by an aircraft, then a one-minute rocket burn.', href: doc('quest/m0/predict-the-spaceflight.md'), action: 'Predict the spaceflight' },
  { name: 'International Space Station', height: 'About 400 km', air: 'Pressurised station; CubeSats are released outside', float: 'Continuous', text: 'Circles Earth about every 90 minutes. CubeSats ride up as cargo and are released into their own orbit.', href: doc('quest/m0/iss-orbit.md'), action: 'Find the ISS' },
];
const gates = [
  ['Predict', 'Run the flight model and write down what each sensor should record.'],
  ['Bench', 'Log for the full length of a flight on a desk, with a deliberate gap.'],
  ['Compare', 'Explain the same sensors on a glider, a spaceship and the ISS.'],
  ['Package', 'Draft the payload paperwork and list every open question.'],
  ['Host review', 'Get written answers from the flight host.'],
  ['Rehearse', 'Time the switch-on, logging, switch-off and data hand-back.'],
  ['Fly and share', 'Publish the measurements next to the predictions.'],
];
---
<Base title="The research flight | CubeSat Classroom" description="How a classroom can prepare a sensor kit for a suborbital research flight." canonical={'https://' + publicSite + '/mission/'}>
  <SiteHeader slot="header" home={base + '/'} links={[
    { label: 'Mission', href: base + '/mission/', current: true },
    { label: 'Lessons', href: base + '/quests/' },
    { label: 'Simulator', href: base + '/#demo' },
    { label: 'CAD', href: base + '/hardware/' },
  ]} />

  <section class="classroom-hero">
    <div class="shell py-11 sm:py-16">
      <p class="field-label">Flight preparation</p>
      <h1 class="mt-3 max-w-3xl">A classroom experiment on a research spaceflight</h1>
      <p class="lede mt-5">What would a small sensor kit record on a suborbital research flight? This page helps a class predict it.</p>
      <div class="mt-7 flex flex-wrap items-center gap-x-5 gap-y-3">
        <a class="button primary" href={doc('docs/suborbital-flight-plan.md')}>Read the flight plan</a>
      </div>
      <p class="mt-5 max-w-2xl text-sm text-muted">An independent volunteer project. Flight details come from public sources. The flight host decides what flies and when.</p>
    </div>
  </section>

  <section class="shell py-12 sm:py-16" aria-labelledby="ride-title">
    <div class="grid gap-8 lg:grid-cols-[.8fr_1.2fr] lg:gap-16">
      <div>
        <h2 id="ride-title">The ride, minute by minute</h2>
        <p class="mt-3 text-muted">About 70 minutes from take-off to landing. Most of it is a slow climb. The part in space lasts a few minutes, so the kit has to be recording before it starts.</p>
        <p class="mt-3 text-muted">Inside the cabin the air stays at about the pressure of a mountain town. A pressure sensor there will not show the near-vacuum outside.</p>
        <a class="mt-4 inline-block text-accent" href={doc('quest/m0/predict-the-spaceflight.md')}>Make your own prediction</a>
      </div>
      <div><FlightChart /></div>
    </div>
  </section>

  <div class="section-band">
    <section class="shell py-12 sm:py-16" aria-labelledby="kit-title">
      <h2 id="kit-title">What the kit measures</h2>
      <p class="mt-3 max-w-2xl text-muted">A small printed CubeSat with an Arduino, a rechargeable battery and a clock that time-stamps every reading.</p>
      <ul class="mt-6 grid gap-x-8 gap-y-3 sm:grid-cols-2 lg:grid-cols-4">
        {['Temperature', 'Pressure', 'Acceleration', 'Rotation', 'Magnetic field', 'Carbon dioxide', 'Humidity', 'Light'].map(s => <li class="resource font-semibold text-ink">{s}</li>)}
      </ul>
    </section>
  </div>

  <section class="shell py-12 sm:py-16" aria-labelledby="rides-title">
    <h2 id="rides-title">Three rides, one set of sensors</h2>
    <p class="mt-3 max-w-2xl text-muted">Each ride teaches something different about the same measurements.</p>
    <div class="mt-6 grid gap-x-8 gap-y-8 md:grid-cols-3">
      {rides.map(r => (
        <article class="resource">
          <h3>{r.name}</h3>
          <p class="my-3 text-muted">{r.text}</p>
          <dl class="space-y-1 text-sm">
            <div><dt class="inline font-semibold text-ink">Height: </dt><dd class="inline text-muted">{r.height}</dd></div>
            <div><dt class="inline font-semibold text-ink">Air on the sensor: </dt><dd class="inline text-muted">{r.air}</dd></div>
            <div><dt class="inline font-semibold text-ink">Weightlessness: </dt><dd class="inline text-muted">{r.float}</dd></div>
          </dl>
          <a class="mt-3 inline-block text-accent" href={r.href}>{r.action}</a>
        </article>
      ))}
    </div>
    <a class="mt-8 inline-block font-bold text-accent underline underline-offset-4" href={doc('quest/m0/one-sensor-three-rides.md')}>Compare all three in one quest</a>
  </section>

  <div class="section-band">
    <section class="shell grid gap-8 py-12 sm:py-16 lg:grid-cols-[.8fr_1.2fr] lg:gap-16" aria-labelledby="gates-title">
      <div>
        <h2 id="gates-title">Seven steps to flight-ready</h2>
        <p class="mt-3 text-muted">Each step ends with something a reviewer can check. Following the public guide does not earn a place on the flight; the host decides.</p>
      </div>
      <ol class="lesson-outline">
        {gates.map(([name, text], i) => <li><span>{String(i + 1).padStart(2, '0')}</span><div><strong class="text-ink">{name}</strong><p>{text}</p></div></li>)}
      </ol>
    </section>
  </div>

  <SiteFooter slot="footer" />
</Base>
