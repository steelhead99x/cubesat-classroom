---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import LevelPicker from '../components/LevelPicker.astro';
import StationDemo from '../components/StationDemo.astro';
import MissionFanout from '../components/MissionFanout.astro';
import ProposalCard from '../components/ProposalCard.astro';
import QuickStart from '../components/QuickStart.astro';
import rail from '../../../docs/assets/rail-fit.png';
import { fundraiser, repo } from '../hubs.mjs';
import { siteOrigin } from '../origin';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const site = siteOrigin;
const labs = [
  { name: 'Ground station', text: 'Run the Rust station locally and see how commands and data move through two Media over QUIC relays.', href: '#start', action: 'Install the station' },
  { name: 'Balloon lab', text: 'Log pressure and temperature, then compare your measurements with data from a balloon flight.', href: repo + '/blob/main/docs/balloon-lab.md', action: 'Open the lab' },
  { name: 'Printable CubeSat', text: 'Print the 1U bench model on a Bambu P1S. Start in PLA and measure the fit before trying ASA.', href: base + '/hardware/', action: 'View drawings and print files' },
];
---
<Base
  title="CubeSat Classroom | Satellite operations for ages 13 and up"
  description="Teach satellite operations with a browser simulator, five guided lessons, and open-source bench labs."
  canonical={site + '/'}
  image={site + rail.src.replace(base, '')}
>
  <SiteHeader slot="header" home={base + '/'} links={[
    { label: 'Mission', href: base + '/mission/' },
    { label: 'Lessons', href: base + '/quests/' },
    { label: 'Simulator', href: '#demo' },
    { label: 'Labs', href: '#labs' },
    { label: 'CAD', href: base + '/hardware/' },
    { label: 'For teachers', href: '#teachers' },
  ]} />

  <section class="classroom-hero" aria-labelledby="home-title">
    <div class="shell grid items-center gap-9 py-11 sm:py-16 lg:grid-cols-[1.12fr_1fr] lg:gap-16">
      <div>
        <p class="field-label">Open-source space education</p>
        <h1 id="home-title" class="mt-4">Run a ground station in your classroom</h1>
        <p class="lede mt-5">Receive data from a model CubeSat and learn how a ground station tracks satellites around Earth.</p>
        <div class="mt-7 flex flex-wrap items-center gap-x-5 gap-y-3">
          <a class="button primary" href={base + '/quests/first-contact/'}>Start the first lesson</a>
          <a class="font-bold text-accent underline decoration-line underline-offset-4 hover:decoration-current" href={base + '/mission/'}>See the flight, minute by minute</a>
        </div>
        <p class="mt-5 text-sm text-muted">For learners 13 and up, guided by teachers, guardians and mentors. The browser lessons need no account or equipment. Built by volunteers.</p>
      </div>
      <figure class="bench-figure m-0">
        <Image src={rail} alt="Exploded CAD view of the CubeSat chassis, camera cover, and base plate" widths={[360, 540, 720]} sizes="(min-width: 1024px) 34rem, 100vw" priority />
        <figcaption><span>Rev B classroom bench model</span><span>100 × 100 × 113.5 mm</span></figcaption>
      </figure>
    </div>
  </section>

  <section id="quests" class="shell scroll-mt-6 py-12 sm:py-16" aria-labelledby="lessons-title">
    <div class="grid gap-6 lg:grid-cols-[.8fr_1.2fr] lg:gap-16">
      <div>
        <h2 id="lessons-title">Classroom lessons</h2>
        <p class="mt-3 max-w-md text-muted">Five short exercises, about 35 minutes. Take a reading, bring back a picture, lose the signal, decide when data is old, and watch the light change.</p>
        <a class="mt-4 inline-block text-accent" href={base + '/quests/'}>View the lesson sequence</a>
      </div>
      <ol class="lesson-outline">
        <li><span>01</span><div><a class="text-ink hover:text-accent" href={base + '/quests/first-contact/'}>Request a reading</a><p>Record a value and its unit.</p></div></li>
        <li><span>02</span><div><a class="text-ink hover:text-accent" href={base + '/quests/bring-back-a-picture/'}>Receive a picture</a><p>Count the frames that reach the station.</p></div></li>
        <li><span>03</span><div><a class="text-ink hover:text-accent" href={base + '/quests/lose-the-signal/'}>Investigate a signal loss</a><p>Pause contact and check which data still arrives.</p></div></li>
        <li><span>04</span><div><a class="text-ink hover:text-accent" href={base + '/quests/fresh-or-historical/'}>Decide if a reading is fresh</a><p>Wait until the station calls it historical.</p></div></li>
        <li><span>05</span><div><a class="text-ink hover:text-accent" href={base + '/quests/light-and-shadow/'}>Watch the light level</a><p>See why it sometimes drops to zero.</p></div></li>
      </ol>
    </div>
  </section>

  <div class="section-band">
    <div class="shell py-12 sm:py-16">
      <div class="mb-6 flex flex-wrap items-end justify-between gap-4">
        <div>
          <h2>Ground station simulator</h2>
          <p class="mt-2 text-muted">Request a reading or start the test camera. All data is simulated in your browser.</p>
        </div>
        <LevelPicker />
      </div>
      <StationDemo heading={false} />
      <a class="mt-5 inline-block font-bold text-accent underline underline-offset-4" href={base + '/quests/'}>Open the guided lessons and quest help</a>
    </div>
  </div>

  <section id="labs" class="shell scroll-mt-6 py-12 sm:py-16" aria-labelledby="labs-title">
    <h2 id="labs-title">Bench and field labs</h2>
    <div class="resource-grid mt-6 grid gap-x-8 gap-y-6 md:grid-cols-3">
      {labs.map(lab => (
        <article class="resource">
          <h3>{lab.name}</h3>
          <p class="my-3 text-muted">{lab.text}</p>
          <a class="text-accent" href={lab.href}>{lab.action}</a>
        </article>
      ))}
    </div>
    <div id="get-started" class="mt-9"><QuickStart /></div>
  </section>

  <section id="fork" class="shell scroll-mt-6 pb-12 sm:pb-16" aria-labelledby="fork-title">
    <div class="grid gap-6 border-t-2 border-line pt-8 lg:grid-cols-[.8fr_1.2fr] lg:gap-16">
      <div>
        <h2 id="fork-title">Start your own club site</h2>
        <p class="mt-3 max-w-md text-muted">CubeSat Classroom is a starting kit, not a competitor. Copy it, rename it, and make it your school's, club's or mission's own.</p>
      </div>
      <div>
        <ul class="lesson-outline">
          <li><span>01</span><div><strong class="text-ink">Fork the repository</strong><p>Lessons, simulator, ground station and print files come with it. MIT or Apache 2.0.</p></div></li>
          <li><span>02</span><div><strong class="text-ink">Change one settings file</strong><p>Your name, web address and links live in one place.</p></div></li>
          <li><span>03</span><div><strong class="text-ink">Add your mission</strong><p>Write quests for your balloon, rocket, glider or satellite. Share improvements back if you like.</p></div></li>
        </ul>
        <a class="mt-5 inline-block font-bold text-accent underline underline-offset-4" href={repo + '/blob/main/docs/fork-guide.md'}>Read the fork guide</a>
          <a class="mt-3 block text-accent" href={base + '/open-source/'}>Open-source neighbours: projects with and without AI, both respected</a>
      </div>
    </div>
  </section>

  <div class="section-band" id="support">
    <section id="teachers" class="shell grid gap-9 py-12 sm:py-16 md:grid-cols-2" aria-labelledby="teacher-title">
      <div>
        <h2 id="teacher-title">For teachers and mentors</h2>
        <p class="mt-3 max-w-lg text-muted">Start with <a class="text-accent" href={base + '/quests/first-contact/'}>First contact</a>. Ask students to record what they measured and what they would check next. Tell us where the lesson could be clearer.</p>
        <a class="mt-4 inline-block text-accent" href={repo + '/blob/main/output/pdf/cubesat-classroom-quick-start.pdf'}>Print the one-page guide</a>
        <a class="mt-2 block text-accent" href={repo + '/blob/main/docs/demo-run-sheet.md'}>Use the five-minute demo run sheet</a>
      </div>
      <div id="workshops">
        <h3>Volunteer and contribute</h3>
        <p class="mt-3 max-w-lg text-muted">Help review a lesson, run a bench test, or make plans for a workshop with CubeSat Club.</p>
        <div class="mt-4 flex flex-wrap gap-x-5 gap-y-2">
          <a class="text-accent" href={base + '/volunteer/'}>Volunteer with CubeSat Club</a>
          <a class="text-accent" href={repo + '/blob/main/CONTRIBUTING.md'}>Contribution guide</a>
        </div>
        <p class="mt-4 text-sm text-muted">Give directly to <a class="text-accent" href={fundraiser}>Teachers in Space</a> to support its teacher training and flight program.</p>
      </div>
    </section>
  </div>

  <div class="shell space-y-6 py-10">
    <details class="reference-panel">
      <summary>How a ground station shares data</summary>
      <div class="mt-6"><MissionFanout /></div>
    </details>
    <details class="reference-panel">
      <summary>Open hardware proposal</summary>
      <div class="mt-6"><ProposalCard /></div>
    </details>
  </div>

  <SiteFooter slot="footer" />
</Base>
