---
import '../theme.css';
import rail from '../../../docs/assets/rail-fit.png';
import { fundraiser, hubs, repo } from '../hubs.mjs';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const command = 'curl -fsSL https://cubesatclass.com/start.sh | bash';
const labs = [
  { icon: 'station', name: 'Ground station', description: 'Request a sensor reading and watch practice video. Start with a simulated CubeSat.', action: 'Run the station', href: '#start' },
  { icon: 'balloon', name: 'Balloon lab', description: 'Log pressure and temperature in class, then compare your measurements with real flight data.', action: 'Open the lesson', href: repo + '/blob/main/docs/balloon-lab.md' },
  { icon: 'cube', name: 'Print the CubeSat', description: 'Print a 1U bench model on a Bambu P1S. Start in PLA and check how the parts fit.', action: 'Get the print files', href: repo + '/tree/main/hardware' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="An open space lab for K–12 for K–12. Run a practice CubeSat ground station, print a satellite model, and teach the next crew.">
    <meta name="theme-color" content="#10264a">
    <link rel="icon" type="image/svg+xml" href={base + '/mark.svg'}>
    <title>CubeSat Classroom</title>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="night">
      <div class="shell flex flex-wrap items-center justify-between gap-x-5 gap-y-3 py-5">
        <a class="brand inline-flex items-center gap-3" href={base + '/'}>
          <img src={base + '/mark.svg'} width="35" height="35" alt="">
          <span>CubeSat Classroom</span>
        </a>
        <nav class="flex flex-wrap items-center gap-x-6 gap-y-2" aria-label="Main">
          <a href="#labs">Classroom</a>
          <a href="#quests">Quests</a>
          <a href="#support">Donate</a>
        </nav>
      </div>
    </header>
    <main id="main">
      <div class="night">
        <section class="hero shell grid items-center gap-8 py-12 lg:grid-cols-[1.2fr_1fr] lg:gap-14 lg:py-16">
          <div>
            <p class="eyebrow">An open space lab for K–12</p>
            <h1>Build a CubeSat.<br><em>Run the mission.</em></h1>
            <p class="intro mt-5">Run a practice ground station, bring back a measurement, and teach the next crew what you learned.</p>
            <div class="mt-7 flex flex-wrap items-center gap-5">
              <a class="button launch" href="#start">Start the ground station <span aria-hidden="true">↓</span></a>
              <a class="light-link" href="#labs">Explore the labs</a>
            </div>
          </div>
          <figure class="chassis">
            <img src={rail.src} width={rail.width} height={rail.height} alt="Exploded CAD view of the printed chassis, camera cover, and base plate" fetchpriority="high">
            <figcaption><span>Rev B</span> 3D-printable 1U bench model</figcaption>
          </figure>
        </section>
      </div>
      <div class="shell pb-12">
        <section id="labs" class="py-12" aria-labelledby="labs-title">
          <h2 id="labs-title">Classroom labs</h2>
          <div class="mt-5 grid gap-4 md:grid-cols-3">
            {labs.map(lab => (
              <article class="lab flex flex-col items-start">
                <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  {lab.icon === 'station' && <path d="m4 12 8 8m-1-1 4-4M7 15 4 20h7m-6-7a6 6 0 0 0 8-8L5 13Zm11-8a5 5 0 0 1 3 3m-2-6a8 8 0 0 1 5 5"/>}
                  {lab.icon === 'balloon' && <path d="M18 9a6 6 0 1 0-12 0c0 4 5 7 6 8 1-1 6-4 6-8Zm-8 9h4m-2 0v3"/>}
                  {lab.icon === 'cube' && <path d="m12 3 8 4.5v9L12 21l-8-4.5v-9L12 3ZM4 7.5l8 4.5 8-4.5M12 12v9"/>}
                </svg>
                <h3 class="mt-4">{lab.name}</h3>
                <p class="mt-2 mb-4">{lab.description}</p>
                <a class="mt-auto" href={lab.href}>{lab.action} <span aria-hidden="true">↗</span></a>
              </article>
            ))}
          </div>
        </section>
        <div id="get-started"></div>
        <section id="start" class="start" aria-labelledby="start-title">
          <h2 id="start-title">One command to start</h2>
          <p class="mt-2">Paste this into your terminal and follow the prompts. Open the local address the station prints.</p>
          <div class="terminal mt-5 flex flex-wrap items-center justify-between gap-3">
            <code id="command">{command}</code>
            <button id="copy" type="button" hidden>Copy command</button>
          </div>
          <p class="mt-3 text-sm">macOS, Linux or WSL. The station uses simulated sensors and video.</p>
          <p id="copy-status" class="sr-only" role="status"></p>
          <a class="mt-4 inline-block" href={repo + '/blob/main/output/pdf/cubesat-classroom-quick-start.pdf'}>Print the one-page quick start <span aria-hidden="true">↗</span></a>
        </section>
        <div class="mt-10 grid gap-x-12 gap-y-8 md:grid-cols-2">
          <section id="quests" aria-labelledby="quests-title">
            <div id="contribute"></div>
            <h2 id="quests-title">Help the next crew</h2>
            <p class="mt-2 mb-4">Try a lesson, record a bench test, or improve a part. Share the steps so another group can repeat your work.</p>
            <a href={repo + '/tree/main/quest'}>Pick a quest <span aria-hidden="true">↗</span></a>
            <a class="ml-3" href={repo + '/blob/main/CONTRIBUTING.md'}>How to contribute <span aria-hidden="true">↗</span></a>
          </section>
          <section id="support" class="donate-panel" aria-labelledby="support-title">
            <h2 id="support-title">Support Teachers in Space</h2>
            <p class="mt-2 mb-4">This project is built and supported by volunteers as a contribution to space education. Donations go directly to Teachers in Space for teacher training and spaceflight.</p>
            <a href={fundraiser}>Donate to Teachers in Space <span aria-hidden="true">↗</span></a>
          </section>
        </div>
      </div>
    </main>
    <footer>
      <div class="shell flex flex-wrap items-center justify-between gap-3 py-6">
        <p>An independent volunteer project inspired by Teachers in Space and AMSAT.</p>
        <nav class="project-links flex flex-wrap gap-x-4 gap-y-2" aria-label="Project sites">
          {hubs.map(hub => <a href={'https://' + hub.host + '/'}>{hub.name}</a>)}
          <a href={repo}>GitHub <span aria-hidden="true">↗</span></a>
        </nav>
      </div>
    </footer>
    <script>
      const button = document.querySelector<HTMLButtonElement>('#copy');
      const command = document.querySelector('#command');
      const status = document.querySelector('#copy-status');

      if (button && command && status && navigator.clipboard) {
        button.hidden = false;
        button.addEventListener('click', async () => {
          try {
            await navigator.clipboard.writeText(command.textContent ?? '');
            status.textContent = 'Command copied.';
            button.textContent = 'Copied';
          } catch {
            status.textContent = 'Select and copy the command from the box.';
            button.textContent = 'Copy manually';
            const range = document.createRange();
            range.selectNodeContents(command);
            const selection = window.getSelection();
            selection?.removeAllRanges();
            selection?.addRange(range);
          }
        });
      }
    </script>
  </body>
</html>
