---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import LevelPicker from '../components/LevelPicker.astro';
import PedalLab from '../components/PedalLab.astro';
import PlayLearn from '../components/PlayLearn.astro';
import StationDemo from '../components/StationDemo.astro';
import MissionFanout from '../components/MissionFanout.astro';
import ProposalCard from '../components/ProposalCard.astro';
import QuickStart from '../components/QuickStart.astro';
import MissionEmblem from '../components/MissionEmblem.astro';
import exploded from '../../../hardware/amsat-cubesatsim/render-exploded.png';
import preview from '../../../hardware/amsat-cubesatsim/render-exploded-navy.png';
import { missionBriefing, repo } from '../hubs.mjs';
import { siteOrigin } from '../origin';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const site = siteOrigin;
const labs = [
  { name: 'Ground station', text: 'Run the Rust station locally and see how commands and data move through two Media over QUIC relays.', href: '#start', action: 'Install the station' },
  { name: 'Balloon lab', text: 'Log pressure and temperature, then compare your measurements with data from a balloon flight.', href: repo + '/blob/main/docs/balloon-lab.md', action: 'Open the lab' },
  { name: 'Printable CubeSat', text: 'Print the AMSAT-based 1U frame and Arduino payload plate. Start with the test coupons and measure the fit.', href: base + '/hardware/', action: 'View drawings and print files' },
];
---
<Base
  title="CubeSat Classroom | Satellite operations for ages 13 and up"
  description="Run a simulated satellite ground station in your classroom. Start with five free, open-source lessons, then explore the Rust station and hands-on bench labs."
  canonical={site + '/'}
  image={site + preview.src.replace(base, '')}
>
  <SiteHeader slot="header" home={base + '/'} />

  <section class="briefing" aria-labelledby="home-title">
    <svg class="orbits" viewBox="0 0 800 800" fill="none" aria-hidden="true">
      <circle cx="400" cy="400" r="390" stroke="#fff" />
      <circle cx="400" cy="400" r="300" stroke="#fff" stroke-dasharray="2 8" />
      <circle cx="400" cy="400" r="210" stroke="#fff" />
      <ellipse cx="400" cy="400" rx="390" ry="140" transform="rotate(-24 400 400)" stroke="#fff" />
    </svg>
    <div class="shell relative grid items-center gap-10 py-12 sm:py-16 lg:grid-cols-[1fr_auto] lg:gap-16 lg:py-20">
      <div class="min-w-0">
        <p class="t-label">Mission · Open-source space education</p>
        <h1 id="home-title" class="mt-4"><span class="md:block">Run a ground station</span> <span class="md:block">in your classroom.</span></h1>
        <p class="lede mt-6">Use the simulator to read a satellite’s sensors, receive a picture and interrupt the signal.</p>

        <section class="panel mt-8 max-w-[38rem]" aria-labelledby="flight-plan">
          <div class="panel-head">
            <p id="flight-plan" class="t-label flex items-center gap-2.5 text-white/85"><span class="live-dot" aria-hidden="true"></span>Flight plan · First lessons</p>
            <p class="t-label hidden sm:block">Desk simulation</p>
          </div>
          <dl class="readouts">
            <div class="flex flex-col-reverse"><dt class="t-label">Lessons</dt><dd class="readout">05</dd></div>
            <div class="flex flex-col-reverse"><dt class="t-label">Total time</dt><dd class="readout">35<small>min</small></dd></div>
            <div class="flex flex-col-reverse"><dt class="t-label">Ages</dt><dd class="readout">13<small>+</small></dd></div>
            <div class="flex flex-col-reverse"><dt class="t-label">To start</dt><dd class="readout">$0</dd></div>
          </dl>
        </section>

        <div class="mt-8 flex flex-wrap items-center gap-3">
          <a class="button launch" href="#demo">Try the simulator <span class="arrow" aria-hidden="true">→</span></a>
          <a class="button ghost" href="#pedal-lab">Try the receiver pedal <span class="arrow" aria-hidden="true">→</span></a>
        </div>
        <p class="t-label note mt-5">No account · No equipment · Built by volunteers</p>
        <p class="note mt-3 max-w-[40rem] text-[.92rem] leading-relaxed">For learners 13 and up, guided by teachers, guardians and mentors. <a class="text-inherit underline underline-offset-4" href={missionBriefing}>Read the Summer 2027 mission briefing.</a></p>
      </div>
      <MissionEmblem class="mx-auto lg:w-[19rem] xl:w-[21rem]" />
    </div>
  </section>

  <div class="shell pt-12 sm:pt-16"><PlayLearn /></div>

  <section id="quests" class="shell scroll-mt-6 py-12 sm:py-16" aria-labelledby="lessons-title">
    <div class="grid gap-6 lg:grid-cols-[.8fr_1.2fr] lg:gap-16">
      <div>
        <p class="eyebrow t-label">01 · Lessons</p>
        <h2 id="lessons-title">Classroom lessons</h2>
        <p class="mt-3 max-w-md text-muted">Five short exercises, about 35 minutes. Take a reading, bring back a picture, lose the signal, decide when data is old, and watch the light change.</p>
        <a class="mt-4 inline-block text-accent" href={base + '/quests/'}>View the lesson sequence</a>
      </div>
      <ol class="lesson-outline">
        <li><span>01</span><div><a class="tap text-ink hover:text-accent" href={base + '/quests/first-contact/'}>Request a reading</a><p>Record a value and its unit.</p></div></li>
        <li><span>02</span><div><a class="tap text-ink hover:text-accent" href={base + '/quests/bring-back-a-picture/'}>Receive a picture</a><p>Count the frames that reach the station.</p></div></li>
        <li><span>03</span><div><a class="tap text-ink hover:text-accent" href={base + '/quests/lose-the-signal/'}>Investigate a signal loss</a><p>Pause contact and check which data still arrives.</p></div></li>
        <li><span>04</span><div><a class="tap text-ink hover:text-accent" href={base + '/quests/fresh-or-historical/'}>Decide if a reading is fresh</a><p>Wait until the station calls it historical.</p></div></li>
        <li><span>05</span><div><a class="tap text-ink hover:text-accent" href={base + '/quests/light-and-shadow/'}>Watch the light level</a><p>See why it sometimes drops to zero.</p></div></li>
      </ol>
    </div>
  </section>

  <div class="section-band" id="demo">
    <div class="shell py-12 sm:py-16">
      <div class="mb-6 flex flex-wrap items-end justify-between gap-4">
        <div>
          <p class="eyebrow t-label">02 · Simulator · Desk simulation</p>
        <h2>Ground station simulator</h2>
          <p class="mt-2 text-muted">Request a reading or start the test camera. All data is simulated in your browser.</p>
        </div>
        <LevelPicker />
      </div>
      <div class="mb-5">
        <p class="mb-3">Grab a pencil and paper. Write the level at the top. Tick each step after you record what you saw.</p>
        {[
          ['beginner', ['Press Ask for a reading. Wait for a temperature to appear.', 'Copy the temperature and its unit onto your paper.', 'Press Take pictures. Write down how many frames arrive. Then try Intermediate.']],
          ['intermediate', ['Press Start video. After two frames appear, press Pause contact.', 'Copy the frame count. Divide the number received by eight to find the fraction delivered.', 'Press Restore contact, then Start video again. Compare the two counts before trying Professional.']],
          ['professional', ['Press Get sensor reading. Open Raw telemetry and copy the request ID and capture timestamp.', 'Match that ID to the reply in the mission log. Record the round-trip time in milliseconds.', 'Repeat twice. Calculate the mean round-trip time and write down the range.']]
        ].map(([id, steps]) => <ol data-show={id} class="ml-6 list-decimal space-y-1">{Array.isArray(steps) && steps.map(step => <li>{step}</li>)}</ol>)}
      </div>
      <StationDemo heading={false} anchor="station-controls" />
      <a class="mt-5 inline-block font-bold text-accent underline underline-offset-4" href={base + '/quests/'}>Continue with the five lessons</a>
      <PedalLab />
    </div>
  </div>

  <section id="labs" class="shell scroll-mt-6 py-12 sm:py-16" aria-labelledby="labs-title">
    <div class="grid items-start gap-8 lg:grid-cols-[1.15fr_1fr] lg:gap-14">
      <div>
        <p class="eyebrow t-label">03 · Labs · Hardware bench</p>
        <h2 id="labs-title">Bench and field labs</h2>
        <div class="resource-grid mt-6 grid gap-y-6">
          {labs.map((lab, i) => (
            <article class="resource grid gap-x-5 sm:grid-cols-[2.2rem_1fr]">
              <span class="t-src pt-1 text-orbit" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <div>
                <h3>{lab.name}</h3>
                <p class="my-2 text-muted">{lab.text}</p>
                <a class="tap text-accent" href={lab.href}>{lab.action}</a>
              </div>
            </article>
          ))}
        </div>
      </div>
      <figure class="bench-figure hud m-0">
        <Image src={exploded} alt="Exploded view of the classroom CubeSat: AMSAT CubeSatSim frame ends and sides, and a printed payload plate holding an Arduino Uno and Nano 33 BLE Sense" widths={[480, 720, 1080]} sizes="(min-width: 1024px) 32rem, 100vw" />
        <figcaption><span>AMSAT CubeSatSim frame · Arduino payload</span><span>1U · 100 × 100 × 113.5 mm · 100% printed</span></figcaption>
      </figure>
    </div>
    <div id="get-started" class="mt-9"><QuickStart /></div>
  </section>

  <section id="app" class="shell scroll-mt-6 pb-12 sm:pb-16" aria-labelledby="app-title">
    <div class="grid gap-6 border-t-2 border-line pt-8 lg:grid-cols-[.8fr_1.2fr] lg:gap-16">
      <div>
        <p class="eyebrow t-label">04 · App · Every screen</p>
        <h2 id="app-title">Follow along on every screen</h2>
        <p class="mt-3 max-w-md text-muted">The CubeSat Classroom app preview lets you follow a practice station, predict satellite passes, and check each reading’s age and source. No student account is needed.</p>
        <p class="mt-3 max-w-md text-muted">The project is testing a live viewer for phones and browsers. Wearable views and live classroom stations are part of the rollout plan.</p>
        <a class="mt-5 inline-block font-bold text-accent underline underline-offset-4" href="https://cubesat.app/">Open cubesat.app</a>
      </div>
      <div>
        <h3>Learn the spectrum, then earn your licence</h3>
        <p class="mt-2 text-muted">We follow the model of <a class="text-accent" href="https://ariss.org/about-ariss-contacts.html">ARISS school contacts</a>: anyone can listen, licensed operators run every transmitter, and students work toward a licence of their own.</p>
        <ul class="lesson-outline mt-4">
          <li><span>01</span><div><strong class="text-ink">Listen first</strong><p>Hear satellites and the space station's amateur radio on 145.800 MHz. Listening needs no licence.</p></div></li>
          <li><span>02</span><div><strong class="text-ink">Take part through a licensed operator</strong><p>Students ask the questions while a licensed control operator runs the radio, as in an ARISS contact.</p></div></li>
          <li><span>03</span><div><strong class="text-ink">Apply with a local club</strong><p>With a radio club and a mentor, read the ARISS proposal guide and choose a direct or telebridge contact.</p></div></li>
          <li><span>04</span><div><strong class="text-ink">Get licensed</strong><p>There is no minimum age. Study the published Technician questions, test with Volunteer Examiners, then work satellites with AMSAT.</p></div></li>
        </ul>
        <a class="mt-5 inline-block text-accent" href="https://cubesat.app/#learn">Learn the spectrum on cubesat.app</a>
      </div>
    </div>
  </section>

  <section id="fork" class="shell scroll-mt-6 pb-12 sm:pb-16" aria-labelledby="fork-title">
    <div class="grid gap-6 border-t-2 border-line pt-8 lg:grid-cols-[.8fr_1.2fr] lg:gap-16">
      <div>
        <p class="eyebrow t-label">05 · Fork · Your own mission</p>
        <h2 id="fork-title">Start your own club site</h2>
        <p class="mt-3 max-w-md text-muted">CubeSat Classroom is a starting kit, not a competitor. Copy it, rename it, and make it your school's, club's or mission's own.</p>
      </div>
      <div>
        <ul class="lesson-outline">
          <li><span>01</span><div><strong class="text-ink">Fork the repository</strong><p>Lessons, simulator, ground station and print files come with it. MIT or Apache 2.0.</p></div></li>
          <li><span>02</span><div><strong class="text-ink">Change one settings file</strong><p>Your name, web address and links live in one place.</p></div></li>
          <li><span>03</span><div><strong class="text-ink">Add your mission</strong><p>Write quests for your balloon, rocket, glider or satellite. Share improvements back if you like.</p></div></li>
        </ul>
        <a class="mt-5 inline-block font-bold text-accent underline underline-offset-4" href={repo + '/blob/main/docs/fork-guide.md'}>Read the fork guide</a>
          <a class="mt-3 block text-accent" href={base + '/open-source/'}>Open-source neighbours: projects with and without SI, both respected</a>
      </div>
    </div>
  </section>

  <div class="section-band" id="support">
    <section id="teachers" class="shell grid gap-9 py-12 sm:py-16 md:grid-cols-2" aria-labelledby="teacher-title">
      <div>
        <p class="eyebrow t-label">06 · Teachers and mentors</p>
        <h2 id="teacher-title">For teachers and mentors</h2>
        <p class="mt-3 max-w-lg text-muted">Start with <a class="text-accent" href={base + '/quests/first-contact/'}>First contact</a>. Ask students to record what they measured and what they would check next. Tell us where the lesson could be clearer.</p>
        <a class="mt-4 inline-block text-accent" href={repo + '/blob/main/output/pdf/cubesat-classroom-quick-start.pdf'}>Print the one-page guide</a>
        <a class="mt-2 block text-accent" href={repo + '/blob/main/docs/demo-run-sheet.md'}>Use the five-minute demo run sheet</a>
      </div>
      <div id="workshops">
        <h3>Volunteer and contribute</h3>
        <p class="mt-3 max-w-lg text-muted">Help review a lesson, run a bench test, or make plans for a workshop with CubeSat Club.</p>
        <div class="mt-4 flex flex-wrap gap-x-5 gap-y-2">
          <a class="tap text-accent" href={base + '/volunteer/'}>Volunteer with CubeSat Club</a>
          <a class="tap text-accent" href={repo + '/blob/main/CONTRIBUTING.md'}>Contribution guide</a>
        </div>
      </div>
    </section>
  </div>

  <div class="shell space-y-6 py-10">
    <details class="reference-panel">
      <summary>How a ground station shares data</summary>
      <div class="mt-6"><MissionFanout /></div>
    </details>
    <details class="reference-panel">
      <summary>Open hardware proposal</summary>
      <div class="mt-6"><ProposalCard /></div>
    </details>
  </div>

  <SiteFooter slot="footer" />
</Base>
