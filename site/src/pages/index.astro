---
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import LevelPicker from '../components/LevelPicker.astro';
import StationDemo from '../components/StationDemo.astro';
import PatchShelf from '../components/PatchShelf.astro';
import MissionFanout from '../components/MissionFanout.astro';
import ProposalCard from '../components/ProposalCard.astro';
import RelatedProjects from '../components/RelatedProjects.astro';
import QuickStart from '../components/QuickStart.astro';
import Workshops from '../components/Workshops.astro';
import QuestGuide from '../components/QuestGuide.astro';
import { Image } from 'astro:assets';
import PageHero from '../components/PageHero.astro';
import rail from '../../../docs/assets/rail-fit.png';
import { classroomHost, fundraiser, repo } from '../hubs.mjs';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const site = 'https://' + classroomHost;
const labs = [
  { name: 'Ground station', text: 'Send requests to a simulated CubeSat over two MoQ relays on your own computer.', href: '#start', action: 'Install the station' },
  { name: 'Balloon lab', text: 'Log pressure and temperature in class, then compare your data with a real balloon flight.', href: repo + '/blob/main/docs/balloon-lab.md', action: 'Open the lesson' },
  { name: 'Print the CubeSat', text: 'Print a 1U bench model on a Bambu P1S. Start in PLA and measure how the parts fit.', href: repo + '/tree/main/hardware', action: 'Get the print files' },
];
---
<Base
  title="CubeSat Classroom: run a satellite mission from your classroom"
  description="A free, open space lab for K–12. Run a practice CubeSat ground station in your browser, earn mission patches, and teach the next crew."
  canonical={site + '/'}
  image={site + rail.src.replace(base, '')}
>
  <SiteHeader slot="header" home={base + '/'} links={[
    { label: 'Quests', href: base + '/quests/' },
    { label: 'How it works', href: '#fanout' },
    { label: 'Labs', href: '#labs' },
    { label: 'Install', href: '#start' },
    { label: 'Plans', href: base + '/plans/' },
    { label: 'Workshops', href: '#workshops' },
  ]} />

  <PageHero size="large" labels>
    <div class="max-w-[38rem]">
      <h1>Run a satellite mission from your classroom.</h1>
      <p class="lede mt-5">A satellite rises, passes overhead and sets. In those few minutes your crew sends a command, waits for the reply, and finds out what made it back to Earth. Practise right here, then earn a patch for every quest you finish.</p>
      <div class="mt-7"><LevelPicker describe tone="dark" /></div>
      <div class="mt-8 flex flex-wrap items-center gap-3">
        <a class="button launch" href={base + '/quests/'}>Start the first quest</a>
        <a class="button ghost" href="#start">Install the real station</a>
      </div>
      <p class="mt-4 max-w-md text-sm text-blue-100/85">Teachers: the browser quests need no setup, no accounts and no technical background. Start on Beginner.</p>
    </div>
  </PageHero>

  <div class="shell relative z-10 -mt-24 max-w-[64rem] sm:-mt-32">
    <StationDemo heading={false} />
    <p class="mt-3 text-center text-sm text-faint">The practice ground station sits on the horizon, like a real one. Nothing is transmitted.</p>
  </div>

  <div class="shell space-y-20 py-16">
    <section aria-labelledby="patches-title" class="grid gap-8 lg:grid-cols-[minmax(0,0.8fr)_minmax(0,1.6fr)] lg:items-center">
      <div>
        <h2 id="patches-title">Collect five mission patches</h2>
        <p class="mt-3 text-muted">Real missions have patches. So do yours. Each example quest takes 5 to 10 minutes in the practice station above, at the level you picked.</p>
        <p class="mt-3 text-sm text-faint">Progress stays in this browser. No account, no tracking.</p>
      </div>
      <PatchShelf />
    </section>

    <QuestGuide title="satellites and ground stations" />

    <MissionFanout />
  </div>

  <section id="labs" class="sky scroll-mt-0" aria-labelledby="labs-title">
    <div class="shell grid gap-10 py-16 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] lg:items-center">
      <figure class="chassis m-0">
        <Image src={rail} alt="Exploded CAD view of the printed CubeSat chassis, camera cover and base plate" widths={[360, 720]} sizes="(min-width: 1024px) 36rem, 100vw" loading="lazy" />
        <figcaption>Rev B, the 3D-printable 1U bench model. Ten centimetres on each side.</figcaption>
      </figure>
      <div>
        <h2 id="labs-title" class="text-white">When you are ready for the real thing</h2>
        <p class="mt-3 max-w-lg text-blue-100">Three labs your class can run with a computer, a balloon log, or a 3D printer.</p>
        <ul class="mt-8 divide-y divide-white/15 border-y border-white/15">
          {labs.map(lab => (
            <li class="grid gap-1 py-5 sm:grid-cols-[10rem_1fr] sm:gap-6">
              <h3 class="text-white">{lab.name}</h3>
              <div>
                <p class="text-blue-100">{lab.text}</p>
                <a class="mt-2 inline-block font-bold text-horizon underline underline-offset-4" href={lab.href}>{lab.action}</a>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <div class="shell space-y-20 py-16">
    <div id="get-started"><QuickStart /></div>

    <div id="support" class="scroll-mt-6"><Workshops /></div>

    <div class="grid gap-x-12 gap-y-10 md:grid-cols-2">
      <section id="quests" class="scroll-mt-6" aria-labelledby="quests-title">
        <h2 id="quests-title">Help the next crew</h2>
        <p class="mt-3 mb-4 text-muted">The project is open for contributions. Try a lesson, record a bench test, or improve a part, and write the steps so another group can repeat it. AI tools are welcome. A person owns each result, and someone else reviews it.</p>
        <div class="flex flex-wrap gap-x-5 gap-y-2">
          <a class="font-bold underline underline-offset-4" href={repo + '/tree/main/quest'}>Pick a quest on GitHub</a>
          <a class="font-bold underline underline-offset-4" href={repo + '/blob/main/CONTRIBUTING.md'}>How to contribute</a>
        </div>
      </section>
      <section class="scroll-mt-6" aria-labelledby="tis-title">
        <h2 id="tis-title">Support Teachers in Space</h2>
        <p class="mt-3 mb-4 text-muted">Volunteers build and run this project. Donations go directly to Teachers in Space for teacher training, spaceflight and the workshops.</p>
        <a class="font-bold text-signal-deep underline underline-offset-4" href={fundraiser}>Donate to Teachers in Space</a>
      </section>
    </div>

    <ProposalCard />
    <RelatedProjects />

    <p class="text-sm text-faint">Networking runs on the open-source Media over QUIC libraries and IETF work from <a class="font-bold text-ink underline underline-offset-4" href="https://moq.dev">moq.dev</a>. Quests are organized with tools from <a class="font-bold text-ink underline underline-offset-4" href="https://kixel.ai">kixel.ai</a>.</p>
  </div>

  <SiteFooter slot="footer" />
</Base>
