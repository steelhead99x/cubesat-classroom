---
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Base
  title="Page not found | CubeSat Classroom"
  description="That address is not on CubeSat Classroom. Try the home page or the five classroom lessons."
  robots="noindex"
>
  <SiteHeader slot="header" home={base + '/'} links={[
    { label: 'Home', href: base + '/' },
    { label: 'Lessons', href: base + '/quests/' },
    { label: 'Mission', href: base + '/mission/' },
  ]} />
  <section class="shell py-16 sm:py-24" aria-labelledby="missing-title">
    <p class="field-label">404</p>
    <h1 id="missing-title" class="mt-3 max-w-3xl">That page is not here</h1>
    <p class="lede mt-5">The address may be mistyped, or the page may have moved. The lessons and the practice ground station are still on the home page.</p>
    <div class="mt-7 flex flex-wrap items-center gap-x-5 gap-y-3">
      <a class="button primary" href={base + '/'}>Back to the home page</a>
      <a class="font-bold text-accent underline underline-offset-4" href={base + '/quests/'}>Open the five lessons</a>
    </div>
  </section>
  <SiteFooter slot="footer" />
</Base>
