---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import rail from '../../../docs/assets/rail-fit.png';
import drawing from '../../../hardware/rev-b-drawing.svg?url';
import { classroomHost, repo } from '../hubs.mjs';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const cad = repo + '/blob/main/hardware/';
const mesh = repo + '/raw/refs/heads/main/hardware/stl/';
const parts = [
  { name: 'Rail corner coupon', dimensions: '26 × 26 × 20', file: 'rev-b-rail-corner-coupon.stl', print: 'Print first, rail end down. Measure the corner and inspect the recessed walls.' },
  { name: 'Rail frame', dimensions: '100 × 100 × 113.5', file: 'rev-b-rail-frame.stl', print: 'Print upright. Check supports under the recessed walls in Bambu Studio.' },
  { name: 'Base plate', dimensions: '93.3 × 93.3 × 4.4', file: 'rev-b-base-plate.stl', print: 'Print the exterior face down. Check that the locators seat without force.' },
  { name: 'Camera plate', dimensions: '93.3 × 93.3 × 4.4', file: 'rev-b-camera-plate.stl', print: 'Print the exterior face down. Check the 18 mm opening against the camera’s field of view.' },
];
---
<Base title="CAD and print files | CubeSat Classroom" description="Dimensioned Rev B rail-fit drawings, printable STL files, and bench fit requirements for the 1U CubeSat model." canonical={'https://' + classroomHost + '/hardware/'}>
  <SiteHeader slot="header" home={base + '/'} links={[
    { label: 'Lessons', href: base + '/quests/' },
    { label: 'Simulator', href: base + '/#demo' },
    { label: 'CAD and print files', href: base + '/hardware/', current: true },
  ]} />
  <section class="classroom-hero">
    <div class="shell grid items-center gap-8 py-12 lg:grid-cols-[1.15fr_1fr]">
      <div>
        <p class="field-label">Mechanical kit · Revision B</p>
        <h1 class="mt-3">CubeSat CAD and print files</h1>
        <p class="lede mt-4">Use the Rev B rail-fit set to check the assembly and measure the printed parts on a Bambu P1S. Start with the corner coupon in PLA before printing the frame or repeating the check in ASA.</p>
        <div class="mt-6 flex flex-wrap items-center gap-x-5 gap-y-3">
          <a class="button primary" href={mesh + parts[0].file}>Download the rail coupon</a>
          <a class="font-bold text-accent underline underline-offset-4" href={cad + 'generate.py'}>Open the parametric CAD source</a>
        </div>
      </div>
      <figure class="bench-figure m-0">
        <Image src={rail} alt="Exploded view of the printable rail frame and two end plates" widths={[360, 540]} sizes="(min-width: 1024px) 33rem, 100vw" priority />
        <figcaption><span>Rev B assembly preview</span><span>Three printed parts</span></figcaption>
      </figure>
    </div>
  </section>
  <div class="shell space-y-12 py-12">
    <section aria-labelledby="drawing-title">
      <h2 id="drawing-title">Dimensioned drawing</h2>
      <p class="mt-2 text-muted">Nominal dimensions come from the checked-in STL geometry. The drawing shows a front view of the frame and the outside face of the camera plate.</p>
      <a class="mt-4 inline-block text-accent" href={drawing} download="rev-b-drawing.svg">Download the drawing (SVG)</a>
      <figure class="mt-4 overflow-hidden rounded-lg border border-line">
        <img src={drawing} width="900" height="590" loading="lazy" alt="Rev B orthographic drawing showing a 100 mm wide and 113.5 mm tall frame, 9 mm square rails and a 93.3 mm camera plate with an 18 mm aperture." />
      </figure>
    </section>
    <section aria-labelledby="parts-title">
      <h2 id="parts-title">Printable parts</h2>
      <dl class="mt-5 divide-y divide-line border-y border-line">
        {parts.map(part => (
          <div class="grid gap-2 py-4 sm:grid-cols-[13rem_1fr] sm:gap-6">
            <dt><a class="text-accent" href={mesh + part.file}>{part.name} (STL)</a></dt>
            <dd><p class="text-sm font-bold">{part.dimensions} mm</p><p class="text-muted">{part.print}</p></dd>
          </div>
        ))}
      </dl>
    </section>
    <section aria-labelledby="requirements-title">
      <h2 id="requirements-title">Fit requirements and evidence</h2>
      <p class="mt-3 max-w-3xl text-muted">The model targets a 100 × 100 × 113.5 mm envelope, 9 mm square rails, 3 mm end recesses, and 0.35 mm of locator clearance per side. Compare printed width at both ends and the middle, and record warping or support scars.</p>
      <p class="mt-3 max-w-3xl text-muted">The meshes passed nominal size and integrity checks. Slicing, print measurements, positive plate retention, and deployer fit still need verification. Flight qualification requires review of the exact materials, process, and assembled hardware.</p>
      <ul class="mt-5 flex flex-wrap gap-x-6 gap-y-3">
        <li><a class="text-accent" href={cad + 'README.md'}>Print and fit instructions</a></li>
        <li><a class="text-accent" href={repo + '/blob/main/quest/m0/print-and-fit.md'}>Rail coupon test</a></li>
        <li><a class="text-accent" href={repo + '/blob/main/docs/iss-deployment-review.md'}>ISS qualification review</a></li>
      </ul>
    </section>
  </div>
  <SiteFooter slot="footer" />
</Base>
