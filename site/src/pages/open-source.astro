---
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import PageHero from '../components/PageHero.astro';
import { publicSite, repo } from '../hubs.mjs';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const suggest = `${repo}/issues/new?template=feedback.yml&labels=feedback,open-source&title=${encodeURIComponent('Open-source project to list: ')}`;

// Each entry links to the project's own policy. Check the policy before adding or
// changing an entry, and describe it in neutral words: both choices are respected here.
const groups = [
  {
    id: 'with-ai',
    title: 'Projects that welcome AI-assisted work',
    summary: 'These projects let contributors use AI coding assistants and real-time AI tools, as long as a person takes responsibility for the result and says when a tool helped.',
    projects: [
      {
        name: 'Linux kernel',
        policy: 'AI coding assistants guide',
        url: 'https://docs.kernel.org/process/coding-assistants.html',
        note: 'AI tools may help, but only a person can certify a patch. Contributions say which tool helped with an Assisted-by tag.',
      },
      {
        name: 'Fedora',
        policy: 'AI-Assisted Contributions Policy',
        url: 'https://docs.fedoraproject.org/en-US/council/policy/ai-contribution-policy/',
        note: 'Contributors may use AI assistance. They stay accountable for their work and disclose significant AI help, for example with an Assisted-by commit trailer.',
      },
    ],
  },
  {
    id: 'human-only',
    title: 'Projects that accept only human-written work',
    summary: 'These projects keep AI-generated code and text out of their own work, for reasons that include copyright, quality and the cost of review. Contributing to them means writing every line yourself.',
    projects: [
      {
        name: 'Gentoo',
        policy: 'Council AI policy',
        url: 'https://wiki.gentoo.org/wiki/Project:Council/AI_policy',
        note: 'Content created with the help of AI language tools may not be contributed to Gentoo.',
      },
      {
        name: 'NetBSD',
        policy: 'Commit guidelines',
        url: 'https://www.netbsd.org/developers/commit-guidelines.html',
        note: 'Code generated by a large language model is treated as tainted and cannot be committed without written approval from the core team.',
      },
    ],
  },
];
---
<Base title="Open-source neighbours | CubeSat Classroom" description="Open-source projects that welcome AI-assisted work and projects that accept only human-written work. Both choices are respected." canonical={'https://' + publicSite + '/open-source/'}>
  <SiteHeader slot="header" home={base + '/'} links={[
    { label: 'Home', href: base + '/' },
    { label: 'Quests', href: base + '/quests/' },
    { label: 'Open source', href: base + '/open-source/', current: true },
  ]} />
  <PageHero>
    <h1 class="max-w-3xl">Two ways to build in the open, both respected</h1>
    <p class="lede mt-5">Some open-source projects work with real-time AI assistants. Others accept only code and text written by people. Both are careful choices made by their communities. We learn from both, and we follow each project's own rules when we contribute to it.</p>
  </PageHero>

  <div class="shell space-y-14 py-12 sm:py-16">
    <section aria-labelledby="every-level">
      <h2 id="every-level">Every level of learning and experience</h2>
      <p class="mt-3 max-w-3xl text-muted">This project is for first-time learners and for people with decades of engineering, teaching and radio experience, and for everyone in between. Ask beginner questions. Share a failed test. Review someone else's work. Write every line by hand, or work with an AI assistant and say so. Each of these is a real contribution.</p>
    </section>

    <section aria-labelledby="how-we-build">
      <h2 id="how-we-build">How this project is built</h2>
      <p class="mt-3 max-w-3xl text-muted">CubeSat Classroom and its site work by <a class="text-accent" href="https://hikd.ai/">hikd.ai</a> use human-driven coding agents. People direct the agent, check its work and decide what ships, bringing hundreds of hours on this project and lifetimes of experience between them. Contributions that use AI say so and explain what the person checked, as the <a class="text-accent" href={repo + '/blob/main/CONTRIBUTING.md'}>contribution guide</a> asks. Contributions written entirely by hand are just as welcome.</p>
    </section>

    {groups.map(group => (
      <section id={group.id} class="scroll-mt-6" aria-labelledby={group.id + '-title'}>
        <h2 id={group.id + '-title'}>{group.title}</h2>
        <p class="mt-3 max-w-3xl text-muted">{group.summary}</p>
        <ul class="mt-6 grid gap-5 md:grid-cols-2">
          {group.projects.map(project => (
            <li class="rounded-[1.25rem] bg-white p-6 ring-1 ring-line">
              <h3>{project.name}</h3>
              <p class="mt-2 text-muted">{project.note}</p>
              <a class="mt-3 inline-block text-accent" href={project.url}>Read the {project.policy}</a>
            </li>
          ))}
        </ul>
      </section>
    ))}

    <section aria-labelledby="add-project">
      <h2 id="add-project">Add a project</h2>
      <p class="mt-3 max-w-3xl text-muted">Know an open-source project with a clear policy either way, especially in space, radio or education? <a class="text-accent" href={suggest}>Suggest it</a> with a link to its policy. We describe every project in its own terms and do not rank one approach above the other.</p>
    </section>
  </div>

  <SiteFooter slot="footer" />
</Base>
