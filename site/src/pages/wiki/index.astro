---
import Base from '../../layouts/Base.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { glossary, letterOf, ldJson } from '../../lib/glossary';
import { repo } from '../../hubs.mjs';
import { siteOrigin } from '../../origin';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const entries = await glossary();
const letters = [...new Set(entries.map(entry => letterOf(entry.data.term)))].sort((a, b) => (a === '#' ? -1 : b === '#' ? 1 : a.localeCompare(b)));
const groups = letters.map(letter => ({ letter, id: letter === '#' ? 'num' : letter.toLowerCase(), entries: entries.filter(entry => letterOf(entry.data.term) === letter) }));
const canonical = `${siteOrigin}/wiki/`;
const ld = {
  '@context': 'https://schema.org',
  '@type': 'DefinedTermSet',
  '@id': canonical,
  name: 'CubeSat Classroom glossary',
  description: 'Plain-language definitions of CubeSat, radio, launch and rules terms for teachers and students.',
  url: canonical,
  hasDefinedTerm: entries.map(entry => ({ '@type': 'DefinedTerm', '@id': `${canonical}${entry.id}/`, name: entry.data.term, description: entry.data.summary, url: `${canonical}${entry.id}/` })),
};
---
<Base title="Glossary: CubeSat, radio and launch terms | CubeSat Classroom" description="A public dictionary and thesaurus of CubeSat, radio, launch and rules terms, in plain language for teachers and students." canonical={canonical}>
  <script slot="head" type="application/ld+json" is:inline set:html={ldJson(ld)} />
  <SiteHeader slot="header" home={base + '/'} current="glossary" />
  <div class="shell space-y-10 py-10 sm:py-14">
    <header>
      <p class="field-label">Public wiki · Dictionary and thesaurus</p>
      <h1 class="mt-3">Glossary</h1>
      <p class="lede mt-3">{entries.length} terms from the lessons, the hardware and the mission briefing, explained in plain language. Each entry lists other names for the term, related terms and its sources.</p>
    </header>

    <div class="space-y-4">
      <div class="max-w-xl">
        <label for="wiki-filter" class="font-bold">Search the glossary</label>
        <input id="wiki-filter" type="search" autocomplete="off" spellcheck="false" placeholder="Try LoRa, orbit or Part 97" class="wiki-search mt-2" aria-describedby="wiki-count" />
        <p id="wiki-count" class="mt-2 text-sm text-muted" role="status" aria-live="polite">{entries.length} terms</p>
      </div>
      <nav aria-label="Jump to letter" class="flex flex-wrap gap-x-1 font-mono text-sm">
        {groups.map(group => <a class="tap min-w-[2.75rem] justify-center text-accent underline underline-offset-4" href={`#letter-${group.id}`} data-letter-link={group.id}>{group.letter}</a>)}
      </nav>
    </div>

    <div id="wiki-list" class="space-y-8">
      {groups.map(group => (
        <section aria-labelledby={`letter-${group.id}`} data-letter-group>
          <h2 id={`letter-${group.id}`} class="border-b border-line pb-1 font-mono text-xl">{group.letter}</h2>
          <ul class="mt-3 grid gap-x-8 gap-y-4 md:grid-cols-2">
            {group.entries.map(entry => (
              <li data-entry data-search={[entry.data.term, ...entry.data.aliases, entry.data.summary, entry.data.category].join(' ').toLowerCase()}>
                <a class="tap font-bold text-accent underline underline-offset-4" href={`${base}/wiki/${entry.id}/`}>{entry.data.term}</a>
                <span class="t-src ml-2 text-muted">{entry.data.category}</span>
                <p class="mt-1 text-muted">{entry.data.summary}</p>
                {entry.data.aliases.length > 0 && <p class="mt-1 text-sm text-muted">Also: {entry.data.aliases.join(', ')}</p>}
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
    <p id="wiki-empty" class="text-muted" hidden>No terms match. <a class="text-accent underline underline-offset-4" href={`${repo}/issues/new?title=${encodeURIComponent('Glossary: add a term')}`}>Suggest a term</a>.</p>

    <section id="contribute" class="border-t border-line pt-8" aria-labelledby="contribute-title">
      <h2 id="contribute-title">How to contribute</h2>
      <p class="mt-3 max-w-3xl text-muted">This glossary is a wiki: anyone can improve it on GitHub. Each entry is one Markdown file in <a class="text-accent underline underline-offset-4" href={`${repo}/tree/main/site/src/content/glossary`}>site/src/content/glossary</a>, and every page has an "Edit this page on GitHub" link that opens a pull request. Keep definitions short and plain, cite a source for any technical or regulatory fact, and link related terms by their file names. See the <a class="text-accent underline underline-offset-4" href={`${repo}/blob/main/CONTRIBUTING.md`}>contribution guide</a>.</p>
    </section>
  </div>
  <SiteFooter slot="footer" />
</Base>

<script>
  // Filter the list as you type. Without JavaScript the full list still shows.
  const input = document.getElementById('wiki-filter') as HTMLInputElement | null;
  const count = document.getElementById('wiki-count');
  const empty = document.getElementById('wiki-empty');
  const items = [...document.querySelectorAll<HTMLElement>('[data-entry]')];
  const groups = [...document.querySelectorAll<HTMLElement>('[data-letter-group]')];
  const fold = (s: string) => s.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase().trim();
  function apply() {
    const words = fold(input?.value ?? '').split(/\s+/).filter(Boolean);
    let shown = 0;
    for (const item of items) {
      const text = fold(item.dataset.search ?? '');
      const match = words.every(word => text.includes(word));
      item.hidden = !match;
      if (match) shown++;
    }
    for (const group of groups) {
      const visible = group.querySelector('[data-entry]:not([hidden])') !== null;
      group.hidden = !visible;
      const link = document.querySelector<HTMLElement>(`[data-letter-link="${group.querySelector('h2')?.id.replace('letter-', '')}"]`);
      if (link) link.toggleAttribute('aria-disabled', !visible);
    }
    if (count) count.textContent = words.length ? `${shown} of ${items.length} terms` : `${items.length} terms`;
    if (empty) empty.hidden = shown > 0;
  }
  if (input) {
    const q = new URLSearchParams(location.search).get('q');
    if (q) input.value = q;
    input.addEventListener('input', apply);
    apply();
  }
</script>
