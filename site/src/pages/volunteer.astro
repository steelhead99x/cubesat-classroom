---
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import QuickStart from '../components/QuickStart.astro';
import RelatedProjects from '../components/RelatedProjects.astro';
import PageHero from '../components/PageHero.astro';
import { Image } from 'astro:assets';
import Workshops from '../components/Workshops.astro';
import rail from '../../../docs/assets/rail-fit.png';
import { classroomHost, fundraiser, publicSite, repo } from '../hubs.mjs';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const canonical = 'https://' + publicSite + '/volunteer/';
const description = 'Help learners 13 and up run their first CubeSat mission. Volunteer as a teacher, amateur-radio mentor, or builder with CubeSat Classroom.';
const roles = [
  { title: 'Teach one lesson', summary: 'Run the practice mission with your class. Tell us which step worked, where students got stuck, and what you would change.', action: 'Join the teacher pilot', url: repo + '/blob/main/docs/quick-start.md' },
  { title: 'Mentor a crew', summary: 'Help learners understand how a ground station sends commands and receives data. Review a relay or radio test with the crew.', action: 'Review the ground station', url: repo + '/blob/main/quest/m1/ground-station-rf.md' },
  { title: 'Build and test', summary: 'Print the P1S case, check how the parts fit, and share measurements another classroom can verify.', action: 'Start the print and test quests', url: repo + '/blob/main/quest/README.md#bambu-p1s-case-test-track' },
];
---
<Base
  title="CubeSat Club | Volunteer with CubeSat Classroom"
  description={description}
  canonical={canonical}
  mark="club-mark.svg"
  image={canonical.replace(/\/$/, '') + rail.src.replace(base, '')}
>
  <SiteHeader slot="header" brand="CubeSat Club" mark="club-mark.svg" home={canonical} links={[
    { label: 'Quick start', href: '#start' },
    { label: 'Volunteer', href: '#volunteer' },
    { label: 'Donate', href: '#give' },
    { label: 'Classroom', href: 'https://' + classroomHost + '/' },
  ]} />
      <PageHero class="grid gap-9 lg:grid-cols-[1.3fr_1fr] lg:items-center">
        <div>
          <p class="kicker">The volunteer community behind CubeSat Classroom</p>
          <h1>Volunteer with CubeSat Classroom</h1>
          <p class="lede mt-5">Pilot a lesson, review a radio procedure, or help verify a part. We share results so other classrooms can repeat the work.</p>
          <a class="button launch mt-7" href="#volunteer">See volunteer roles</a>
        </div>
        <figure class="chassis relative m-0 bg-transparent">
          <Image src={rail} alt="Exploded model of the CubeSat frame, camera cover, and base plate" widths={[360, 720]} sizes="(min-width: 1024px) 28rem, 100vw" />
          <figcaption>The 1U CubeSat bench model. Print it and test it with a classroom crew.</figcaption>
        </figure>
      </PageHero>
      <div class="shell py-12">
        <QuickStart />
        <section id="volunteer" class="mt-10" aria-labelledby="volunteer-title">
          <h2 id="volunteer-title">Volunteer roles</h2>
          <div class="mt-5 grid gap-4 md:grid-cols-3">
            {roles.map(role => (
              <article class="resource flex min-w-0 flex-col items-start">
                <h3>{role.title}</h3>
                <p class="mt-3 mb-4 text-muted">{role.summary}</p>
                <a class="mt-auto font-bold underline underline-offset-4" href={role.url}>{role.action}</a>
              </article>
            ))}
          </div>
        </section>
        <section id="give" class="mt-10 border-t border-line pt-6" aria-labelledby="give-title">
          <h2 id="give-title">Support Teachers in Space</h2>
          <p class="mt-3 max-w-2xl text-muted">CubeSat Classroom is an open-source contribution to space education, built and supported by volunteers. Give directly to Teachers in Space to help fund its teacher flight program.</p>
          <a class="mt-4 inline-block font-semibold text-signal-deep underline underline-offset-4" href={fundraiser}>Donate directly to Teachers in Space</a>
        </section>
        <div class="mt-14"><Workshops id="club-workshops" /></div>
        <div class="mt-14"><RelatedProjects /></div>
      </div>
  <SiteFooter slot="footer" showHubs={false} />
</Base>
