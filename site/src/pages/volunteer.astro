---
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import QuickStart from '../components/QuickStart.astro';
import rail from '../../../docs/assets/rail-fit.png';
import { classroomHost, fundraiser, repo } from '../hubs.mjs';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const canonical = 'https://cubesat.club/';
const description = 'Help a K–12 classroom run its first CubeSat mission. Volunteer as a teacher, amateur-radio mentor, or builder with CubeSat Classroom.';
const roles = [
  { title: 'Teach one lesson', summary: 'Run the practice mission with your class. Tell us which step worked, where students got stuck, and what you would change.', action: 'Join the teacher pilot', url: repo + '/blob/main/docs/quick-start.md', color: 'border-t-blue-700' },
  { title: 'Mentor a crew', summary: 'Help learners understand how a ground station sends commands and receives data. Review a relay or radio test with the crew.', action: 'Review the ground station', url: repo + '/blob/main/quest/m1/ground-station-rf.md', color: 'border-t-amber-600' },
  { title: 'Build and test', summary: 'Print a CubeSat part, improve the simulator, or document a bench test another classroom can repeat.', action: 'Choose a contribution quest', url: repo + '/blob/main/quest/README.md', color: 'border-t-signal' },
];
---
<Base
  title="CubeSat Club | Volunteer with CubeSat Classroom"
  description={description}
  canonical={canonical}
  image={canonical.replace(/\/$/, '') + rail.src.replace(base, '')}
>
  <SiteHeader slot="header" brand="CubeSat Club" home={canonical} links={[
    { label: 'Quick start', href: '#start' },
    { label: 'Volunteer', href: '#volunteer' },
    { label: 'Donate', href: '#give' },
    { label: 'Classroom', href: 'https://' + classroomHost + '/' },
  ]} />
      <div class="night">
        <section class="shell grid gap-9 py-12 lg:grid-cols-[1.3fr_1fr] lg:items-center lg:py-16">
          <div>
            <p class="eyebrow">The volunteer community behind CubeSat Classroom</p>
            <h1>Help a classroom run its <em>first space mission.</em></h1>
            <p class="intro mt-5">Give a K–12 crew a first taste of space science. Help them build a model, request a simulated sensor reading, and teach the next crew how they did it.</p>
            <a class="button launch mt-7" href="#volunteer">Find a way to help <span aria-hidden="true">↓</span></a>
          </div>
          <figure class="chassis">
            <img src={rail.src} width={rail.width} height={rail.height} alt="Exploded model of the CubeSat frame, camera cover, and base plate">
            <figcaption>1U CubeSat bench model · Print and test it with a classroom crew</figcaption>
          </figure>
        </section>
      </div>
      <div class="shell py-12">
        <QuickStart />
        <section id="volunteer" class="mt-10" aria-labelledby="volunteer-title">
          <h2 id="volunteer-title">Pick one way to help</h2>
          <div class="mt-5 grid gap-4 md:grid-cols-3">
            {roles.map(role => (
              <article class={'flex min-w-0 flex-col items-start rounded-2xl border border-t-4 border-line bg-white p-5 sm:p-6 ' + role.color}>
                <h3>{role.title}</h3>
                <p class="mt-3 mb-4 text-muted">{role.summary}</p>
                <a class="mt-auto font-semibold underline underline-offset-4" href={role.url}>{role.action} <span aria-hidden="true">↗</span></a>
              </article>
            ))}
          </div>
        </section>
        <section id="give" class="mt-10 rounded-2xl bg-rose-50 p-5 sm:p-6" aria-labelledby="give-title">
          <h2 id="give-title">Support Teachers in Space</h2>
          <p class="mt-3 max-w-2xl text-muted">CubeSat Classroom is an open-source contribution to space education, built and supported by volunteers. Give directly to Teachers in Space to help fund its teacher flight program.</p>
          <a class="mt-4 inline-block font-semibold text-signal underline underline-offset-4" href={fundraiser}>Donate directly to Teachers in Space <span aria-hidden="true">↗</span></a>
        </section>
      </div>
  <SiteFooter slot="footer" showHubs={false} />
</Base>
