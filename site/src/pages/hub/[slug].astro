---
import Base from '../../layouts/Base.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import PageHero from '../../components/PageHero.astro';
import { classroomHost, hubs } from '../../hubs.mjs';

export function getStaticPaths() {
  return hubs.filter(hub => hub.slug !== 'volunteer').map(hub => ({ params: { slug: hub.slug }, props: { hub } }));
}

const { hub } = Astro.props;
const homeFor = (item: typeof hubs[number]) => item.home ?? 'https://' + item.host + (item.path ?? '/');
---
<Base title={hub.name + ' | CubeSat Classroom'} description={hub.description} canonical={homeFor(hub)}>
  <SiteHeader slot="header" home={'https://' + classroomHost + '/'} label="Project sites"
    links={[...hubs.map(item => ({ label: item.name, href: homeFor(item), current: item.host === hub.host })), { label: 'Games', href: 'https://' + classroomHost + '/games/' }]} />
  <PageHero>
    <h1 class="max-w-3xl">{hub.heading}</h1>
    <p class="lede mt-5">{hub.description}</p>
  </PageHero>
  <div class="shell py-12">
    <section aria-labelledby="resources" class="max-w-2xl rounded-[1.5rem] bg-white p-6 ring-1 ring-line sm:p-8">
      <h2 id="resources">Get started</h2>
      <ul class="mt-3 divide-y divide-line">
        {hub.links.map(([label, url]) => (
          <li><a class="flex items-center justify-between gap-4 py-3 font-semibold hover:text-blue-700" href={url}>{label}</a></li>
        ))}
      </ul>
    </section>
  </div>
  <SiteFooter slot="footer" />
</Base>
