---
import Base from '../../layouts/Base.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { siteOrigin } from '../../origin';
import { patch } from '../../games/patches.mjs';
import { icon } from '../../games/icons.mjs';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const games = [
  {
    href: base + '/games/catch-the-pass/',
    name: 'Catch the Pass',
    text: 'Follow a CubeSat across the sky, tune your radio and collect its data before it sets.',
    mode: 'Solo levels or shared sky',
    time: 'About 1 minute per pass',
    theme: 'pass',
    patch: 'pass',
  },
  {
    href: base + '/games/rockoon-wars/',
    name: 'Rockoon Battle',
    text: 'Launch a balloon from the ground, release a rocket and score by flying through the sky ring.',
    mode: '2–4 players, local or online',
    time: '5–15 minutes',
    theme: 'rockoon',
    patch: 'rockoon',
  },
];
---
<Base title="Games | CubeSat Classroom" description="Free browser games about satellites and radio, from the CubeSat Classroom project." canonical={siteOrigin + '/games/'}>
  <SiteHeader slot="header" home={base + '/'} current="games" />
  <div class="shell space-y-8 py-10 sm:py-14">
    <header class="games-intro">
      <div>
        <h1>Classroom games</h1>
        <p class="lede mt-3">Track a satellite on your own, or get friends together for a turn-based match.</p>
      </div>
      <p>Play in your browser with a keyboard, mouse or touch. No account required.</p>
    </header>
    <ul class="games-list">
      {games.map(game => (
        <li class:list={['game-card', game.theme]}>
          <div class="game-patch" set:html={patch(game.patch, game.name)} />
          <div class="game-info">
            <h2>{game.name}</h2>
            <p>{game.text}</p>
            <ul class="game-details" aria-label="Game details">
              <li><Fragment set:html={icon('crew', 16)} />{game.mode}</li>
              <li><Fragment set:html={icon('clock', 16)} />{game.time}</li>
            </ul>
            <a class="button play" href={game.href}><Fragment set:html={icon('start', 18)} />Play {game.name}</a>
          </div>
        </li>
      ))}
    </ul>
    <section class="lesson-link" aria-labelledby="lessons-heading">
      <div><h2 id="lessons-heading">Practice with the ground station</h2><p>Try the five guided lessons on sensors, camera frames and signal loss.</p></div>
      <a class="button" href={base + '/quests/'}>Open the lessons <span class="arrow" aria-hidden="true">→</span></a>
    </section>
  </div>
  <SiteFooter slot="footer" />
</Base>
<style>
  .games-intro { display: flex; flex-wrap: wrap; align-items: end; justify-content: space-between; gap: 1rem 2rem; }
  .games-intro > p { max-width: 20rem; color: var(--color-muted); }
  .games-list { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(30rem, 100%), 1fr)); gap: 1rem; list-style: none; padding: 0; }
  /* Each game is a mission card: its patch, a short brief, and one action. */
  .game-card {
    display: grid; grid-template-columns: auto minmax(0, 1fr); align-items: start; gap: 1.25rem 1.5rem;
    min-width: 0; padding: clamp(1.25rem, 3.5vw, 1.9rem);
    border-radius: .25rem; background: var(--color-navy); color: #fff;
    border-bottom: 4px solid var(--color-flag);
  }
  .game-patch { width: clamp(6.5rem, 16vw, 8.5rem); }
  .game-patch :global(.patch) { display: block; width: 100%; height: auto; }
  .game-info { display: grid; gap: .6rem; justify-items: start; min-width: 0; }
  .game-info h2 { font-size: clamp(1.6rem, 3vw, 2.1rem); }
  .game-info p { max-width: 38ch; color: rgb(255 255 255 / .86); }
  .game-details { display: flex; flex-wrap: wrap; gap: .3rem 1.1rem; padding: 0; margin: .1rem 0 .3rem; list-style: none; font: 500 .82rem var(--font-mono); color: var(--color-sky); }
  .game-details li { display: inline-flex; align-items: center; gap: .35rem; }
  .play { gap: .55rem; background: #fff; color: var(--color-navy); border-color: transparent; }
  .play:hover { background: var(--color-sky); color: var(--color-navy); }
  .game-card a:focus-visible { outline: 3px solid #fff; outline-offset: 3px; }
  @media (max-width: 520px) { .game-card { grid-template-columns: minmax(0, 1fr); } .game-patch { width: 7rem; } }
  .lesson-link { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: .8rem 1.5rem; border-top: 1px solid var(--color-line); padding-top: 1.2rem; }
  .lesson-link h2 { font-size: 1.3rem; }
  .lesson-link p { color: var(--color-muted); margin-top: .25rem; }
</style>
