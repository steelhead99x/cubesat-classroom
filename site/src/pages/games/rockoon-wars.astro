---
import Base from '../../layouts/Base.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { WEAPONS } from '../../games/rockoon-wars/logic.mjs';
import { siteOrigin } from '../../origin';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Base title="Rockoon Wars | CubeSat Classroom games" description="A turn-based artillery game for 2 to 4 players. Set the angle and power, mind the wind, and be the last rockoon flying. Play on one computer or online with a room code." canonical={siteOrigin + '/games/rockoon-wars/'}>
  <SiteHeader slot="header" home={base + '/'} links={[
    { label: 'Mission', href: base + '/mission/' },
    { label: 'Lessons', href: base + '/quests/' },
    { label: 'Games', href: base + '/games/', current: true },
    { label: 'CAD', href: base + '/hardware/' },
    { label: 'Glossary', href: base + '/wiki/' },
  ]} />
  <div class="shell py-8 sm:py-12">
    <p class="eyebrow t-label"><a href={base + '/games/'}>Games</a> · Play &amp; learn</p>
    <h1>Rockoon Wars</h1>
    <p class="lede mt-3">Take turns launching rockets from balloon platforms over the hills. Set your angle and power, mind the wind, and be the last rockoon flying.</p>

    <section class="rw mt-7" data-rw aria-labelledby="rw-title">
      <h2 id="rw-title" class="sr-only">Game</h2>
      <div class="rw-top">
        <p data-net class="small" aria-live="polite"></p>
        <div class="tools">
          <button type="button" data-pause aria-pressed="false">Pause</button>
          <button type="button" data-sound aria-pressed="false">Sound off</button>
          <button type="button" data-quit>Menu</button>
        </div>
      </div>
      <div class="stage">
        <canvas tabindex="0" aria-label="Battlefield" aria-describedby="rw-keys"></canvas>
        <div class="overlay" data-overlay></div>
      </div>
      <p class="sr-only" data-status role="status" aria-live="polite"></p>

      <div class="hud">
        <dl class="numbers">
          <div><dt>Turn</dt><dd data-who>—</dd></div>
          <div><dt>Angle</dt><dd data-angle>—</dd></div>
          <div><dt>Power</dt><dd data-power>—</dd></div>
          <div><dt>Weapon</dt><dd data-weapon>—</dd></div>
          <div><dt>Wind</dt><dd data-wind>—</dd></div>
          <div><dt>Round</dt><dd data-round>—</dd></div>
        </dl>
        <div class="controls" data-controls role="group" aria-label="Aim and fire">
          <button type="button" data-adj="angle:1" aria-label="Aim left">◀ Angle</button>
          <button type="button" data-adj="angle:-1" aria-label="Aim right">Angle ▶</button>
          <button type="button" data-adj="power:-1" aria-label="Less power">Power −</button>
          <button type="button" data-adj="power:1" aria-label="More power">Power +</button>
          <button type="button" data-adj="weapon:1">Next weapon</button>
          <button type="button" data-fire class="fire">Fire!</button>
        </div>
      </div>
      <ol class="board" data-board aria-label="Players"></ol>
    </section>

    <div class="mt-8 grid gap-8 lg:grid-cols-2">
      <section aria-labelledby="how-title">
        <h2 id="how-title">How to play</h2>
        <ul id="rw-keys" class="mt-3 list-disc space-y-1.5 pl-5">
          <li><strong>Aim:</strong> Left and Right arrows change the angle, Up and Down change the power. Hold Shift to move by 5.</li>
          <li><strong>Weapon:</strong> Q and E. <strong>Fire:</strong> Space or Enter.</li>
          <li><strong>Pause:</strong> P or Esc. <strong>Sound:</strong> M (it starts off).</li>
          <li>Hits earn money, knocking a rockoon out earns a point, and the last one flying wins the round. Spend your money in the shop between rounds.</li>
          <li><strong>Online:</strong> create a room and share its five-letter code. Players are anonymous call signs. There is no chat.</li>
        </ul>
      </section>
      <section aria-labelledby="arms-title">
        <h2 id="arms-title">The shop</h2>
        <ul class="mt-3 list-disc space-y-1.5 pl-5">
          {WEAPONS.map(w => (
            <li><strong>{w.name}:</strong> {w.price ? `${w.pack} for $${w.price}` : 'free, never runs out'}{w.dirt ? '. Builds a hill instead of blowing one up' : ''}.</li>
          ))}
        </ul>
      </section>
    </div>
  </div>
  <SiteFooter slot="footer" />
</Base>

<script>
  import '../../games/rockoon-wars/game';
</script>

<style>
  .rw { background: #081028; color: #e8ecff; border-radius: .6rem; padding: clamp(.8rem, 2.5vw, 1.4rem); }
  .rw button, .rw :global(.overlay button) { min-height: 44px; padding: .45rem .85rem; border: 1px solid #5b6ab8; border-radius: .3rem; background: #121d4a; color: #fff; font: 600 .95rem var(--font-sans); }
  .rw button:hover:not(:disabled) { background: #1d2b6b; }
  .rw button[aria-pressed="true"] { background: #ffd23f; color: #081028; border-color: #ffd23f; }
  .rw button:disabled, .rw :global(.overlay button:disabled) { opacity: .5; cursor: not-allowed; }
  .rw :global(:focus-visible) { outline: 3px solid #ffd23f; outline-offset: 2px; }
  .rw-top { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: .6rem; }
  .tools, .controls { display: flex; flex-wrap: wrap; gap: .5rem; align-items: center; }
  .stage { position: relative; margin-top: .8rem; }
  canvas { display: block; width: 100%; aspect-ratio: 640 / 400; border-radius: .4rem; background: #081028; }
  .overlay { position: absolute; inset: 0; display: grid; place-content: center; gap: .6rem; padding: 1rem; text-align: center; background: rgb(0 0 40 / .82); border-radius: .4rem; overflow: auto; }
  .overlay[hidden] { display: none; }
  .overlay :global(h3) { font-size: clamp(1.3rem, 3vw, 1.9rem); }
  .overlay :global(p) { max-width: 36rem; margin-inline: auto; }
  .overlay :global(.row) { display: flex; gap: .6rem; justify-content: center; align-items: center; flex-wrap: wrap; }
  .overlay :global(label) { display: inline-flex; gap: .4rem; align-items: center; }
  .overlay :global(select), .overlay :global(input) { min-height: 44px; padding: .3rem .5rem; border: 1px solid #5b6ab8; border-radius: .3rem; background: #121d4a; color: #fff; font: 600 1rem var(--font-mono); }
  .overlay :global(input) { width: 6.5rem; text-transform: uppercase; letter-spacing: .15em; }
  .overlay :global(button.go) { background: #ffd23f; color: #081028; border-color: #ffd23f; font-size: 1.05rem; padding-inline: 1.4rem; }
  .overlay :global(.code) { font-family: var(--font-mono); color: #ffd23f; letter-spacing: .15em; }
  .overlay :global(.people) { font-family: var(--font-mono); list-style: none; padding: 0; }
  .overlay :global(.shop) { list-style: none; padding: 0; display: grid; gap: .4rem; }
  .overlay :global(.shop li) { display: grid; grid-template-columns: 8rem 7rem 5rem auto; gap: .6rem; align-items: center; text-align: left; font-family: var(--font-mono); }
  .hud { display: grid; gap: .8rem; margin-top: .9rem; }
  .numbers { display: flex; gap: 1.2rem; flex-wrap: wrap; font-family: var(--font-mono); }
  .numbers dt { font-size: .72rem; letter-spacing: .12em; text-transform: uppercase; opacity: .75; }
  .numbers dd { font-size: 1.15rem; font-weight: 600; }
  .numbers :global(i), .board :global(i) { display: inline-block; width: .8rem; height: .8rem; border-radius: 50%; margin-right: .35rem; vertical-align: -.05rem; }
  .controls .fire { background: #ef6b6c; border-color: #ef6b6c; }
  .board { display: grid; gap: .3rem; margin-top: .8rem; font: .9rem/1.4 var(--font-mono); list-style: none; padding: 0; }
  .board :global(li) { display: grid; grid-template-columns: 1.2rem 9rem 7rem 5rem auto; gap: .6rem; align-items: center; }
  .board :global(.hp) { height: .6rem; background: #1b2550; border-radius: .2rem; overflow: hidden; }
  .board :global(.hp b) { display: block; height: 100%; background: #6fd3a0; }
  .small { font-size: .88rem; color: #c9d2ff; }
  .eyebrow a { color: inherit; }
</style>
