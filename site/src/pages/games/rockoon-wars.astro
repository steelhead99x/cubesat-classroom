---
import Base from '../../layouts/Base.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { WEAPONS, START_CREDITS } from '../../games/rockoon-wars/logic.mjs';
import { siteOrigin } from '../../origin';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Base title="Rockoon Wars | CubeSat Classroom games" description="A turn-based artillery game for 2 to 4 players. Set the angle and power, mind the wind, and be the last rockoon flying. Play on one computer or online with a room code." canonical={siteOrigin + '/games/rockoon-wars/'}>
  <SiteHeader slot="header" home={base + '/'} links={[
    { label: 'Mission', href: base + '/mission/' },
    { label: 'Lessons', href: base + '/quests/' },
    { label: 'Games', href: base + '/games/', current: true },
    { label: 'CAD', href: base + '/hardware/' },
    { label: 'Glossary', href: base + '/wiki/' },
  ]} />
  <div class="shell py-8 sm:py-12">
    <p class="eyebrow t-label"><a href={base + '/games/'}>Games</a> · Play &amp; learn</p>
    <h1>Rockoon Wars</h1>
    <p class="lede mt-3">Take turns launching rockets from balloon platforms over the hills. Set your angle and power, mind the wind, and be the last rockoon flying.</p>

    <section class="rw mt-7" data-rw aria-labelledby="rw-title">
      <h2 id="rw-title" class="sr-only">Game</h2>
      <div class="rw-top">
        <p data-net class="small" aria-live="polite"></p>
        <div class="tools">
          <button type="button" data-help>❓ How to play</button>
          <button type="button" data-pause aria-pressed="false">⏸ Pause</button>
          <button type="button" data-sound aria-pressed="false">🔇 Sound off</button>
          <button type="button" data-quit>🏠 Start over</button>
        </div>
      </div>
      <p class="turn" data-turn hidden></p>
      <div class="stage">
        <canvas tabindex="0" aria-label="Battlefield" aria-describedby="rw-keys"></canvas>
        <div class="overlay" data-overlay></div>
      </div>
      <p class="sr-only" data-status role="status" aria-live="polite"></p>

      <div class="controls" data-controls role="group" aria-label="Aim and fire" hidden>
        <div class="ctl">
          <span class="lbl">🎯 Aim</span>
          <div class="pair">
            <button type="button" data-adj="angle:1" aria-label="Aim more to the left">◀</button>
            <output data-angle>—</output>
            <button type="button" data-adj="angle:-1" aria-label="Aim more to the right">▶</button>
          </div>
        </div>
        <div class="ctl">
          <span class="lbl">💪 Power</span>
          <div class="pair">
            <button type="button" data-adj="power:-1" aria-label="Less power">−</button>
            <output data-power>—</output>
            <button type="button" data-adj="power:1" aria-label="More power">+</button>
          </div>
        </div>
        <div class="ctl">
          <span class="lbl">Rocket</span>
          <button type="button" class="rocket" data-adj="weapon:1" aria-label="Change rocket"><span data-rocket>—</span><small>Tap to change</small></button>
        </div>
        <button type="button" data-fire class="fire">🚀 FIRE!</button>
      </div>
      <dl class="info" hidden>
        <div><dt>Wind</dt><dd data-wind>—</dd></div>
        <div><dt>Round</dt><dd data-round>—</dd></div>
      </dl>
      <ol class="board" data-board aria-label="Players"></ol>
    </section>

    <div class="mt-8 grid gap-8 lg:grid-cols-2">
      <section aria-labelledby="how-title">
        <h2 id="how-title">How to play</h2>
        <ul id="rw-keys" class="mt-3 list-disc space-y-1.5 pl-5">
          <li><strong>Aim:</strong> tap ◀ and ▶, or press the Left and Right arrow keys. The yellow dots show which way your rocket starts.</li>
          <li><strong>Power:</strong> tap − and +, or press the Up and Down arrow keys. Hold a button (or Shift) to go faster.</li>
          <li><strong>Rocket:</strong> tap the rocket button, or press Q and E. <strong>Fire:</strong> tap FIRE, or press Space or Enter.</li>
          <li><strong>Pause:</strong> P or Esc. <strong>Sound:</strong> M (it starts off).</li>
          <li>Hits earn credits, knocking a rockoon out earns a point, and the last one flying wins the round. Spend your credits in the shop between rounds. Everyone starts with {START_CREDITS} credits.</li>
          <li><strong>Online:</strong> make a room and tell your friends its 5-letter code. Players get random names like GS-AB1. There is no chat.</li>
        </ul>
      </section>
      <section aria-labelledby="arms-title">
        <h2 id="arms-title">The shop</h2>
        <ul class="mt-3 list-disc space-y-1.5 pl-5">
          {WEAPONS.map(w => (
            <li><strong>{w.name}:</strong> {w.price ? `${w.pack} for ${w.price} credits` : 'free, never runs out'}{w.dirt ? '. Builds a hill instead of blowing one up' : ''}.</li>
          ))}
        </ul>
      </section>
    </div>
  </div>
  <SiteFooter slot="footer" />
</Base>

<script>
  import '../../games/rockoon-wars/game';
</script>

<style>
  .rw { background: #081028; color: #e8ecff; border-radius: .6rem; padding: clamp(.6rem, 2.5vw, 1.4rem); }
  .rw button { min-height: 48px; padding: .45rem .85rem; border: 1px solid #5b6ab8; border-radius: .4rem; background: #121d4a; color: #fff; font: 600 1rem var(--font-sans); touch-action: manipulation; }
  .rw button:hover:not(:disabled) { background: #1d2b6b; }
  .rw button[aria-pressed="true"] { background: #ffd23f; color: #081028; border-color: #ffd23f; }
  .rw button:disabled { opacity: .45; cursor: not-allowed; }
  .rw :global(:focus-visible) { outline: 3px solid #ffd23f; outline-offset: 2px; }
  .rw-top { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: .6rem; }
  .tools { display: flex; flex-wrap: wrap; gap: .5rem; }
  .turn { margin-top: .7rem; padding: .55rem 1rem; border-radius: .5rem; border-left: .5rem solid var(--who, #ffd23f); background: #121d4a; font: 800 clamp(1.25rem, 4vw, 1.8rem)/1.2 var(--font-sans); text-align: center; }
  .turn[hidden] { display: none; }
  .stage { position: relative; margin-top: .7rem; }
  canvas { display: block; width: 100%; aspect-ratio: 640 / 400; border-radius: .4rem; background: #081028; }
  .overlay { position: absolute; inset: 0; display: grid; grid-template-columns: minmax(0, 1fr); align-content: safe center; gap: .8rem; padding: 1rem; text-align: center; background: rgb(0 0 40 / .85); border-radius: .4rem; overflow: auto; }
  .overlay[hidden] { display: none; }
  /* Menus, the how-to card and the shop take the canvas's place, so they fit on a phone. */
  .stage[data-panel]:not([data-panel=""]) canvas { display: none; }
  .stage[data-panel]:not([data-panel=""]) .overlay { position: static; min-height: min(26rem, 70vh); background: #0d1638; }
  .overlay :global(h3) { font-size: clamp(1.4rem, 4vw, 2rem); }
  .overlay :global(p) { max-width: 36rem; margin-inline: auto; font-size: 1.05rem; }
  .overlay :global(.row) { display: flex; gap: .7rem; justify-content: center; align-items: center; flex-wrap: wrap; }
  .overlay :global(button) { min-height: 48px; padding: .5rem 1.1rem; border: 1px solid #5b6ab8; border-radius: .4rem; background: #121d4a; color: #fff; font: 600 1.05rem var(--font-sans); }
  .overlay :global(button:disabled) { opacity: .5; }
  .overlay :global(button.go) { background: #ffd23f; color: #081028; border-color: #ffd23f; }
  .overlay :global(button.big) { min-height: 64px; min-width: 13rem; font-size: 1.25rem; font-weight: 800; padding-inline: 1.5rem; border-radius: .6rem; }
  .overlay :global(button.num) { min-width: 5rem; font-size: 1.8rem; }
  .overlay :global(.small) { font-size: .95rem; color: #c9d2ff; }
  .overlay :global(.t-label) { margin-bottom: -.4rem; }
  .overlay :global(.bigcode) { display: flex; gap: .4rem; justify-content: center; font: 800 clamp(2.2rem, 10vw, 3.6rem)/1 var(--font-mono); color: #081028; }
  .overlay :global(.bigcode span) { background: #ffd23f; border-radius: .4rem; padding: .3rem .5rem; min-width: 1.4em; }
  .overlay :global(.code-in) { width: 12rem; min-height: 64px; text-align: center; border: 2px solid #ffd23f; border-radius: .5rem; background: #121d4a; color: #fff; font: 800 2rem var(--font-mono); letter-spacing: .25em; text-transform: uppercase; }
  .overlay :global(.people) { font: 1.05rem/1.6 var(--font-mono); list-style: none; padding: 0; }
  .overlay :global(.steps) { list-style: none; padding: 0; display: grid; gap: .7rem; grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr)); max-width: 46rem; width: 100%; margin-inline: auto; }
  .overlay :global(.steps li), .overlay :global(.card) { display: grid; gap: .3rem; justify-items: center; padding: .8rem; border-radius: .6rem; background: #121d4a; border: 1px solid #2b3a85; }
  .overlay :global(.pic) { font-size: 2.6rem; line-height: 1; }
  .overlay :global(.steps b), .overlay :global(.card b) { font-size: 1.15rem; }
  .overlay :global(.wallet) { font-size: 1.3rem; font-weight: 800; color: #ffd23f; }
  .overlay :global(.shop) { list-style: none; padding: 0; display: grid; gap: .6rem; grid-template-columns: repeat(auto-fit, minmax(min(10rem, 100%), 1fr)); max-width: 48rem; width: 100%; margin-inline: auto; }
  .overlay :global(.card button) { width: 100%; margin-top: .2rem; }
  .controls { display: grid; gap: .7rem; margin-top: .8rem; grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr)); align-items: end; }
  .controls[hidden] { display: none; }
  .ctl { display: grid; gap: .3rem; }
  .lbl { font-weight: 700; font-size: 1rem; }
  .pair { display: grid; grid-template-columns: 1fr auto 1fr; gap: .4rem; align-items: center; }
  .pair button { min-height: 60px; font-size: 1.6rem; font-weight: 800; }
  .pair output { min-width: 3.2rem; text-align: center; font: 800 1.3rem var(--font-mono); }
  .rocket { display: grid; min-height: 60px !important; text-align: center; }
  .rocket small { font-weight: 400; opacity: .8; font-size: .8rem; }
  .fire { min-height: 72px !important; font-size: 1.5rem !important; font-weight: 900 !important; background: #ef6b6c !important; border-color: #ef6b6c !important; border-radius: .6rem !important; }
  .info[hidden] { display: none; }
  .info { display: flex; gap: 1.4rem; flex-wrap: wrap; margin-top: .8rem; font-family: var(--font-mono); }
  .info dt { font-size: .72rem; letter-spacing: .12em; text-transform: uppercase; opacity: .75; }
  .info dd { font-size: 1.3rem; font-weight: 700; }
  .board { display: grid; gap: .3rem; margin-top: .8rem; font: .95rem/1.4 var(--font-mono); list-style: none; padding: 0; }
  .board :global(li) { display: grid; grid-template-columns: 1.2rem minmax(5rem, 8rem) minmax(4rem, 7rem) auto auto; gap: .6rem; align-items: center; padding: .2rem .4rem; border-radius: .3rem; }
  .board :global(li.now) { background: #1d2b6b; }
  .board :global(i) { display: inline-block; width: .9rem; height: .9rem; border-radius: 50%; }
  .board :global(.hp) { height: .7rem; background: #1b2550; border-radius: .2rem; overflow: hidden; }
  .board :global(.hp b) { display: block; height: 100%; background: #6fd3a0; }
  @media (max-width: 34rem) { .board :global(li) { grid-template-columns: 1.2rem 1fr 4rem; } .board :global(li span:nth-of-type(n+3)) { grid-column: 2 / -1; } .tools button { padding-inline: .6rem; font-size: .9rem; } }
  .small { font-size: .88rem; color: #c9d2ff; }
  .eyebrow a { color: inherit; }
</style>
