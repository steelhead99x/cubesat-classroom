---
import Base from '../../layouts/Base.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import GameSteps from '../../components/GameSteps.astro';
import { icon } from '../../games/icons.mjs';
import { WEAPONS, START_CREDITS } from '../../games/rockoon-wars/logic.mjs';
import { STEPS, KEYS } from '../../games/rockoon-wars/steps.mjs';
import { siteOrigin } from '../../origin';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Base title="Rockoon Battle | CubeSat Classroom games" description="Launch a balloon from the ground and send its rocket through a sky ring. Play on one computer or online with a room code." canonical={siteOrigin + '/games/rockoon-wars/'}>
  <SiteHeader slot="header" home={base + '/'} current="games" />
  <div class="shell py-5 sm:py-8">
    <nav class="crumbs" aria-label="Breadcrumb"><a href={base + '/'}>Home</a><span aria-hidden="true">›</span><a href={base + '/games/'}>Games</a><span aria-hidden="true">›</span><span aria-current="page">Rockoon Battle</span><a class="all" href={base + '/games/'}>← All games</a></nav>
    <h1 class="rw-h1">Rockoon Battle</h1>
    <p class="lede mt-2">Launch your balloon from the hillside. Release the rocket toward the gold ring, then check where it lands. Craters can move the launch pads.</p>

    <section class="rw mt-5" data-rw data-playing="false" aria-labelledby="rw-title">
      <h2 id="rw-title" class="sr-only">Game</h2>
      <div class="bar">
        <ol class="board" data-board aria-label="Players" tabindex="0"></ol>
        <span class="round" data-round></span>
        <div class="tools">
          <button type="button" data-help aria-label="How to play" title="How to play" set:html={icon('help')} />
          <button type="button" data-sound aria-pressed="false" aria-label="Sound off" title="Sound (M)" set:html={icon('sound-off')} />
          <button type="button" data-pause aria-pressed="false" aria-label="Pause" title="Pause (P)" set:html={icon('pause')} />
          <button type="button" data-full aria-pressed="false" aria-label="Full screen" title="Full screen" set:html={icon('fullscreen')} />
          <button type="button" data-quit aria-label="Back to the start" title="Back to the start" set:html={icon('exit')} />
        </div>
      </div>
      <p class="now" data-now aria-live="off"></p>
      <div class="stage">
        <canvas tabindex="0" aria-label="Launch field. On your turn, drag from your rockoon to aim." aria-describedby="rw-keys"></canvas>
        <div class="toast" data-toast aria-hidden="true"></div>
        <p class="net" data-net aria-live="polite"></p>
        <p class="sideways" aria-hidden="true">↻ Turn your phone sideways for a bigger view</p>
        <div class="overlay" data-overlay hidden></div>
      </div>
      <p class="air" data-air hidden></p>
      <div class="controls" data-controls role="group" aria-label="Aim and launch">
        <div class="grp">
          <button type="button" data-adj="angle:1" aria-label="Aim more to the left">◀</button>
          <div class="val"><small>Aim</small><b data-angle>—</b></div>
          <button type="button" data-adj="angle:-1" aria-label="Aim more to the right">▶</button>
        </div>
        <div class="grp">
          <button type="button" data-adj="power:-1" aria-label="Less power">−</button>
          <div class="val"><small>Power</small><b data-power>—</b></div>
          <button type="button" data-adj="power:1" aria-label="More power">+</button>
        </div>
        <button type="button" class="rocket" data-adj="weapon:1"><span class="ico" data-rocket-icon aria-hidden="true"></span><span class="val"><small>Rocket · tap to change</small><b data-rocket>—</b></span></button>
        <button type="button" data-fire class="fire">Launch balloon</button>
        <p class="wait" data-wait aria-hidden="true"></p>
      </div>
      <p class="sr-only" data-status role="status" aria-live="polite"></p>
    </section>

    <div class="mt-8"><GameSteps steps={STEPS} keysNote={KEYS} listId="rw-keys" /></div>

    <div class="mt-8 grid gap-8 lg:grid-cols-2">
      <section aria-labelledby="know-title">
        <h2 id="know-title">Good to know</h2>
        <ul class="mt-3 list-disc space-y-1.5 pl-5">
          <li>Each point earns 50 credits, and everyone starts with {START_CREDITS}. A match has three rounds, or one per crew with four crews, so every crew launches once from every spot on the hill.</li>
          <li>The barometer reads from pad to release. Altitudes are simulated metres above sea level, and pressure follows the <a href="https://www.weather.gov/index.php/ama/conversions">standard atmosphere</a>. Local weather can give a different reading.</li>
          <li><strong>Online:</strong> players get random names like GS-AB1. There is no chat.</li>
        </ul>
      </section>
      <section aria-labelledby="arms-title">
        <h2 id="arms-title">The shop</h2>
        <ul class="mt-3 list-disc space-y-1.5 pl-5">
          {WEAPONS.map(w => (
            <li><strong>{w.name}:</strong> {w.price ? `${w.pack} for ${w.price} credits` : 'free, never runs out'}. Scan range beyond the ring: {w.radius} pixels. Ground impact: {w.impact.name.toLowerCase()}.</li>
          ))}
        </ul>
      </section>
    </div>
  </div>
  <SiteFooter slot="footer" />
</Base>

<script>
  import '../../games/rockoon-wars/game';
</script>

<style>
  .rw-h1 { font-size: clamp(1.8rem, 5vw, 2.6rem); }
  .rw {
    --ink: #e8ecff; --panel: #121a46; --line: #2b3a85; --gold: #ffd23f;
    display: flex; flex-direction: column; height: calc(100svh - .75rem); min-height: 440px; max-height: 960px;
    background: #0b1240; color: var(--ink); border-radius: .9rem; overflow: hidden; box-shadow: 0 10px 40px rgb(8 12 40 / .35);
  }
  .rw:fullscreen { height: 100dvh; min-height: 0; max-height: none; border-radius: 0; }
  .rw button { font: 700 1rem var(--font-sans); color: #fff; touch-action: manipulation; -webkit-tap-highlight-color: transparent; }
  .rw :global(:focus-visible) { outline: 3px solid var(--gold); outline-offset: 2px; }
  .rw [data-quit][data-armed] { background: #ef6b6c; color: #fff; }

  /* Top bar: players, round and small tool buttons. It sits above the playfield, never on it. */
  .bar { display: flex; align-items: center; gap: .5rem; padding: .45rem .55rem; background: rgb(8 12 36 / .92); border-bottom: 1px solid var(--line); min-height: 3.1rem; }
  .board { min-width: 0; display: flex; gap: .35rem; list-style: none; margin: 0; padding: 0; overflow-x: auto; flex: 1; scrollbar-width: none; }
  .board :global(li) { display: flex; align-items: center; gap: .45rem; padding: .25rem .6rem .25rem .5rem; border-radius: 999px; background: var(--panel); border: 2px solid transparent; white-space: nowrap; font-size: .85rem; }
  .board :global(li::before) { content: ''; width: .7rem; height: .7rem; border-radius: 50%; background: var(--c); box-shadow: 0 0 0 2px rgb(255 255 255 / .15); }
  .board :global(li.now) { border-color: var(--c); background: color-mix(in srgb, var(--c) 22%, var(--panel)); }
  .board :global(li.out) { opacity: .45; }
  .board :global(.cr), .board :global(.pt) { display: inline-flex; align-items: center; gap: .25rem; font: 600 .8rem var(--font-mono); }
  .board :global(.ico) { color: var(--gold); }
  .round { font: 700 .8rem var(--font-mono); opacity: .8; white-space: nowrap; }
  .tools { display: flex; flex: none; gap: .3rem; }
  .tools button { display: grid; place-items: center; width: 2.75rem; height: 2.75rem; border-radius: .6rem; background: var(--panel); border: 1px solid var(--line); line-height: 1; }
  .tools button:hover { background: #1d2b6b; }
  .tools button[aria-pressed="true"] { background: var(--gold); color: #0b1240; }

  /* The playfield fills the rest; the canvas matches it pixel for pixel. */
  .stage { position: relative; flex: 1; min-height: 0; }
  canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; touch-action: none; cursor: crosshair; }
  .toast { position: absolute; left: 50%; top: 18%; transform: translateX(-50%); opacity: 0; pointer-events: none; padding: .6rem 1.4rem; border-radius: 999px; background: rgb(8 12 36 / .8); border: 3px solid var(--c, var(--gold)); font: 900 clamp(1.3rem, 4.5vw, 2.2rem)/1.1 var(--font-sans); white-space: nowrap; text-shadow: 0 2px 0 rgb(0 0 0 / .4); }
  .toast :global(small) { display: block; margin-top: .3rem; max-width: min(80vw, 28rem); white-space: normal; font: 700 clamp(.8rem, 2.6vw, 1rem)/1.3 var(--font-sans); text-align: center; color: #e8ecff; }
  .net { position: absolute; left: .6rem; bottom: .4rem; margin: 0; font-size: .75rem; opacity: .75; pointer-events: none; }
  .sideways { display: none; position: absolute; top: 3.4rem; left: 50%; transform: translateX(-50%); margin: 0; font-size: .8rem; padding: .2rem .7rem; border-radius: 999px; background: rgb(8 12 36 / .55); white-space: nowrap; pointer-events: none; }
  @media (orientation: portrait) and (max-width: 600px) { .rw[data-playing="true"] .sideways { display: block; } }
  /* Portrait phones: the world is wide, so give it a sky-sized stage instead of a tall empty one while playing. */
  @media (orientation: portrait) and (max-width: 600px) {
    .rw[data-playing="true"]:not(:fullscreen) { height: auto; min-height: 0; }
    .rw[data-playing="true"]:not(:fullscreen) .stage { flex: none; aspect-ratio: 640 / 540; }
  }

  /* Menus, the shop and results: a card over the (dimmed) playfield. */
  .overlay { position: absolute; inset: 0; display: grid; place-items: center; padding: .8rem; background: rgb(6 10 32 / .55); backdrop-filter: blur(2px); }
  .overlay[hidden] { display: none; }
  .overlay :global(.panel) { display: grid; gap: .75rem; justify-items: center; text-align: center; width: min(100%, 44rem); max-height: 100%; overflow: auto; padding: clamp(1rem, 3vw, 1.6rem); border-radius: 1rem; background: rgb(14 20 60 / .94); border: 1px solid var(--line); box-shadow: 0 20px 50px rgb(0 0 0 / .45); }
  .overlay :global(h3) { font-size: clamp(1.35rem, 4vw, 2rem); display: flex; align-items: center; gap: .5rem; }
  .overlay :global(.title) { font-size: clamp(2rem, 7vw, 3.2rem); letter-spacing: -.01em; }
  .overlay :global(.logo) { width: clamp(6.5rem, 22vw, 9rem); margin-bottom: -.2rem; }
  .overlay :global(.logo .patch) { display: block; width: 100%; height: auto; }
  .overlay :global(button) { display: inline-flex; align-items: center; justify-content: center; gap: .55rem; }
  .overlay :global(.wallet) { display: inline-flex; align-items: center; gap: .45rem; }
  .overlay :global(p) { max-width: 34rem; font-size: 1.02rem; color: #d6dcff; }
  .overlay :global(.row) { display: flex; gap: .6rem; justify-content: center; align-items: center; flex-wrap: wrap; }
  .overlay :global(.row.col) { flex-direction: column; width: min(100%, 22rem); }
  .overlay :global(.row.col button) { width: 100%; }
  .overlay :global(button) { min-height: 46px; padding: .5rem 1.1rem; border: 1px solid var(--line); border-radius: .7rem; background: var(--panel); }
  .overlay :global(button:hover:not(:disabled)) { filter: brightness(1.15); }
  .overlay :global(button:disabled) { opacity: .5; cursor: not-allowed; }
  .overlay :global(button.go) { background: linear-gradient(#ffe27a, #ffc62e); color: #0b1240; border-color: #ffc62e; box-shadow: 0 4px 0 #b88a10; }
  .overlay :global(button.go.alt) { background: linear-gradient(#8fd8ff, #4fb4f0); border-color: #4fb4f0; box-shadow: 0 4px 0 #2a6f99; }
  .overlay :global(button.go:active) { transform: translateY(2px); box-shadow: 0 2px 0 #b88a10; }
  .overlay :global(button.big) { min-height: 60px; min-width: 12rem; font-size: 1.2rem; font-weight: 800; padding-inline: 1.4rem; }
  .overlay :global(button.num) { min-width: 3.6rem; padding-inline: .75rem; font-size: 1.65rem; }
  .overlay :global(.small) { font-size: .92rem; color: #c9d2ff; }
  .overlay :global(.bigcode) { display: flex; gap: clamp(.15rem, 1vw, .4rem); justify-content: center; font: 800 clamp(1.35rem, 6vw, 3.4rem)/1 var(--font-mono); color: #0b1240; }
  .overlay :global(.bigcode span) { background: var(--gold); border-radius: .5rem; padding: .3rem clamp(.2rem, 1vw, .5rem); min-width: 1.35em; box-shadow: 0 4px 0 #b88a10; }
  .overlay :global(.code-in) { width: 12rem; min-height: 62px; text-align: center; border: 2px solid var(--gold); border-radius: .7rem; background: #0b1240; color: #fff; font: 800 2rem var(--font-mono); letter-spacing: .25em; text-transform: uppercase; }
  .overlay :global(.people) { font: 1rem/1.7 var(--font-mono); list-style: none; padding: 0; }
  .overlay :global(.people i), .overlay :global(.dot) { display: inline-block; width: .8rem; height: .8rem; border-radius: 50%; }
  .overlay :global(.steps) { list-style: none; padding: 0; display: grid; gap: .6rem; grid-template-columns: repeat(auto-fit, minmax(min(11rem, 100%), 1fr)); width: 100%; }
  .overlay :global(.steps li), .overlay :global(.card) { display: grid; gap: .25rem; justify-items: center; align-content: start; padding: .8rem .7rem; border-radius: .8rem; background: #18225a; border: 1px solid var(--line); }
  .overlay :global(.pic) { display: grid; place-items: center; width: 3.6rem; height: 3.6rem; margin-bottom: .2rem; border-radius: 50%; background: #0b1240; border: 1px solid var(--line); color: var(--gold); }
  .overlay :global(.steps b), .overlay :global(.card b) { font-size: 1.08rem; }
  .overlay :global(.steps span:last-child) { font-size: .92rem; color: #c9d2ff; }
  .overlay :global(.wallet) { font-size: 1.25rem; font-weight: 800; color: var(--gold); }
  .overlay :global(.shop) { list-style: none; padding: 0; display: grid; gap: .55rem; grid-template-columns: repeat(auto-fit, minmax(min(9.5rem, 100%), 1fr)); width: 100%; }
  .overlay :global(.card .say) { font-size: .85rem; color: #c9d2ff; min-height: 2.2em; }
  .overlay :global(.card .price) { font-weight: 800; color: var(--gold); }
  .overlay :global(.card .have) { font-size: .8rem; opacity: .8; }
  .overlay :global(.card.poor) { opacity: .7; }
  .overlay :global(.card button) { width: 100%; margin-top: .2rem; min-height: 42px; }

  /* Bottom controls: one tidy row on wide screens, two on phones. Space is kept even between
     turns, so the playfield never jumps. */
  /* What to do now: one instruction and a link to that step below the game. */
  .now { margin: 0; padding: .4rem .7rem; display: flex; flex-wrap: wrap; align-items: baseline; gap: .2rem .6rem; background: rgb(8 12 36 / .92); border-bottom: 1px solid var(--line); font-size: .98rem; }
  .now:empty { display: none; }
  .now :global(.now-n) { font: 600 .78rem var(--font-mono); letter-spacing: .06em; color: var(--gold); }
  .now :global(a), .overlay :global(a) { color: #fff; text-decoration: underline; text-underline-offset: 3px; font-weight: 600; }
  @media (orientation: landscape) and (max-height: 500px) { .now { display: none; } }
  .air { margin: 0; padding: .35rem .7rem; font: .8rem/1.4 var(--font-mono); color: #d7e6ff; }
  .controls { position: relative; display: grid; grid-template-columns: auto auto minmax(0, 1fr) minmax(8rem, 12rem); gap: .5rem; align-items: stretch; padding: .5rem; background: rgb(8 12 36 / .92); border-top: 1px solid var(--line); }
  .rw[data-playing="false"] .controls > * { visibility: hidden; }
  .controls[data-wait="true"] > :not(.wait) { visibility: hidden; }
  .wait { position: absolute; inset: 0; display: grid; place-items: center; margin: 0; font: 800 1.15rem var(--font-sans); color: #c9d2ff; visibility: hidden; }
  .controls[data-wait="true"] .wait { visibility: visible; }
  .grp { display: grid; grid-template-columns: 3rem 4.4rem 3rem; gap: .3rem; align-items: stretch; }
  .grp button, .rocket { min-height: 52px; border-radius: .7rem; background: var(--panel); border: 1px solid var(--line); font-size: 1.4rem; }
  .grp button:active:not(:disabled), .rocket:active:not(:disabled) { background: #26357f; }
  .val { display: grid; place-content: center; text-align: center; line-height: 1.1; }
  .val small { font: 600 .68rem var(--font-sans); letter-spacing: .06em; text-transform: uppercase; opacity: .7; }
  .val b { font: 800 1.2rem var(--font-mono); }
  .rocket { display: flex; align-items: center; gap: .5rem; padding: 0 .7rem; text-align: left; font-size: 1rem; }
  .rocket .val { place-content: center start; text-align: left; }
  .rocket .val b { font: 800 1rem var(--font-sans); }
  .rocket .ico { display: grid; }
  .fire { min-height: 52px; border-radius: .8rem; border: 0; background: linear-gradient(#ff8a7a, #e8463c); box-shadow: 0 4px 0 #9b2a22; font-size: 1.35rem !important; font-weight: 900 !important; letter-spacing: .04em; }
  .fire:active:not([aria-disabled="true"]):not(:disabled) { transform: translateY(2px); box-shadow: 0 2px 0 #9b2a22; }
  .controls button:disabled, .fire[aria-disabled="true"] { opacity: .45; }
  /* After a while at the release point the button pulses (a steady ring with reduced motion). */
  .fire[data-nudge] { outline: 3px solid var(--gold); outline-offset: 2px; animation: nudge 1s ease-in-out infinite; }
  @keyframes nudge { 50% { transform: scale(1.04); } }
  @media (prefers-reduced-motion: reduce) { .fire[data-nudge] { animation: none; } }
  @media (max-width: 720px) {
    .controls { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .grp { grid-template-columns: 2.75rem minmax(0, 1fr) 2.75rem; }
    .round { display: none; }
    .board :global(.pt) { display: none; }
  }
  @media (max-width: 360px) {
    .bar { gap: .3rem; padding-inline: .35rem; }
    .tools { gap: .15rem; }
    .controls { gap: .35rem; padding-inline: .35rem; }
    .grp { gap: .15rem; }
    .val small { letter-spacing: 0; }
    .rocket { padding-inline: .35rem; gap: .25rem; }
  }
  @media (orientation: landscape) and (max-height: 500px) {
    .rw:fullscreen .controls { grid-template-columns: auto auto minmax(0, 1fr) minmax(6rem, 9rem); }
  }
  .crumbs { display: flex; flex-wrap: wrap; align-items: center; gap: .1rem .5rem; font-size: .9rem; color: var(--color-muted); }
  .crumbs a { display: inline-flex; align-items: center; min-height: 2.75rem; font-weight: 600; color: var(--color-accent); text-decoration: underline; text-underline-offset: 3px; }
  .crumbs [aria-current] { font-weight: 600; color: var(--color-ink, inherit); }
  .crumbs .all { margin-left: auto; padding: 0 .9rem; border-radius: 999px; background: var(--color-mist); border: 1px solid var(--color-line); text-decoration: none; }
</style>
