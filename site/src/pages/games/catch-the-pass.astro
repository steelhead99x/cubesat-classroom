---
import Base from '../../layouts/Base.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { ANTENNAS, DEFAULT_RECEIVER, LEVELS, receiverFrequency } from '../../games/catch-the-pass/logic.mjs';
import { GAIN_MAX_DB } from '../../lib/pedal.mjs';
import { siteOrigin } from '../../origin';
import GameSteps from '../../components/GameSteps.astro';
import { STEPS, KEYS } from '../../games/catch-the-pass/steps.mjs';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const wiki = (slug: string, text: string) => `<a href="${base}/wiki/${slug}/">${text}</a>`;
---
<Base title="Catch the Pass | CubeSat Classroom games" description="Track a CubeSat across the sky with a ground-station antenna, choose a LoRa spreading factor and download its packets before it sets. A free browser game." canonical={siteOrigin + '/games/catch-the-pass/'}>
  <SiteHeader slot="header" home={base + '/'} current="games" />
  <div class="shell py-8 sm:py-12">
    <nav class="crumbs" aria-label="Breadcrumb"><a href={base + '/'}>Home</a><span aria-hidden="true">›</span><a href={base + '/games/'}>Games</a><span aria-hidden="true">›</span><span aria-current="page">Catch the Pass</span><a class="all" href={base + '/games/'}>← All games</a></nav>
    <h1>Catch the Pass</h1>
    <p class="lede mt-2">Keep your antenna on the CubeSat as it crosses the sky, and catch its packets before it sets.</p>

    <section class="ctp mt-5" data-ctp aria-labelledby="ctp-title">
      <h2 id="ctp-title" class="sr-only">Game</h2>
      <div class="ctp-top">
        <div role="group" aria-label="Game mode" class="tabs">
          <button type="button" data-mode="missions" aria-pressed="true">⭐ Levels</button>
          <button type="button" data-mode="live" aria-pressed="false">🌐 Play with others</button>
        </div>
        <div class="tools">
          <label class="slow" title="Slower passes and a bigger antenna circle"><input type="checkbox" data-slow checked /> 🙂 Easy</label>
          <button type="button" data-pause class="start">Start</button>
          <button type="button" data-restart class="ico" aria-label="Start again" title="Start again">↺</button>
          <button type="button" data-sound aria-pressed="false" class="ico" aria-label="Sound off" title="Sound">🔇</button>
          <button type="button" data-help class="ico" aria-label="How to play" title="How to play">?</button>
        </div>
      </div>
      <div data-missions class="levels" role="group" aria-label="Levels">
        {LEVELS.map((level, i) => (
          <button type="button" data-level={i} aria-pressed={i === 0 ? 'true' : 'false'}>
            <span class="n">{i + 1}</span> {level.name} <span data-stars class="stars-mini">☆☆☆</span>
          </button>
        ))}
      </div>
      <div data-live class="live-note" hidden>
        <p data-sky-status aria-live="polite">Not connected.</p>
        <p class="small">Everyone in the live sky tracks the same satellite at the same time. A new pass starts every minute. Stations are anonymous call signs. There are no names and no chat.</p>
      </div>

      <div class="antenna-row">
        <label for="ctp-antenna">Antenna</label>
        <select id="ctp-antenna" data-antenna aria-describedby="ctp-antenna-note">
          <option value="">Recommended for this pass</option>
          {Object.entries(ANTENNAS).map(([id, antenna]) => <option value={id}>{antenna.name}</option>)}
        </select>
        <span id="ctp-antenna-note" data-antenna-note>Patch · Medium beam · balanced gain</span>
        <a href="#ctp-receiver">Receiver pedal ↓</a>
      </div>

      <div class="dash">
        <dl class="numbers">
          <div><dt>📦 Packets</dt><dd data-rx>0</dd></div>
          <div><dt>🪙 Credits</dt><dd data-score>0</dd></div>
          <div><dt>🔥 In a row</dt><dd data-streak>0</dd></div>
          <div><dt>⏱ Time</dt><dd data-time>—</dd></div>
        </dl>
        <div class="meter">
          <span class="t-label">📶 Signal <span data-snr>—</span></span>
          <div class="bar" aria-hidden="true"><i data-snr-bar></i><b data-snr-floor title="You need a signal past this line to catch packets"></b></div>
        </div>
        <div class="meter">
          <span class="t-label">🔋 Battery <span data-battery>—</span> · <span data-light>Sunlit</span></span>
          <div class="bar" aria-hidden="true"><i data-battery-bar class="battery"></i></div>
        </div>
      </div>
      <p class="now" data-now aria-live="off"></p>
      <div class="stage">
        <canvas tabindex="0" aria-label="Sky view" aria-describedby="ctp-keys"></canvas>
        <div class="overlay" data-overlay></div>
      </div>
      <p class="sr-only" data-status role="status" aria-live="polite"></p>

      <div class="deck">
        <div class="sf" role="group" aria-label="Radio setting (spreading factor)">
          <span class="t-label">📻 Radio setting</span>
          <div>
            <button type="button" data-sf="7" aria-pressed="false">🐇 Fast <small>SF7</small></button>
            <button type="button" data-sf="9" aria-pressed="true">Middle <small>SF9</small></button>
            <button type="button" data-sf="12" aria-pressed="false">🐢 Far <small>SF12</small></button>
          </div>
        </div>
        <button type="button" data-tx aria-pressed="true" class="tx">📡 Sending: on</button>
        <div class="pad" role="group" aria-label="Move the antenna">
          <button type="button" data-aim="ArrowUp" aria-label="Antenna up" class="up">▲</button>
          <button type="button" data-aim="ArrowLeft" aria-label="Antenna left" class="left">◀</button>
          <button type="button" data-aim="ArrowRight" aria-label="Antenna right" class="right">▶</button>
          <button type="button" data-aim="ArrowDown" aria-label="Antenna down" class="down">▼</button>
        </div>
      </div>

      <section class="receiver" id="ctp-receiver" aria-labelledby="ctp-receiver-title">
        <div class="receiver-face">
          <h3 id="ctp-receiver-title">Receiver pedal</h3>
          <div class="receiver-screen">
            <span>Input <span data-rx-input>0%</span></span>
            <span data-rx-state>Ready</span>
            <div class="bar" aria-hidden="true"><i data-rx-meter></i></div>
          </div>
          <button type="button" data-rx-engage aria-pressed="true">Engaged</button>
        </div>
        <div class="receiver-controls">
          <label>Tune <output data-rx-tune-label>{receiverFrequency(0).toFixed(3)} MHz</output>
            <input type="range" data-rx-tune min="-4" max="4" step="1" value={DEFAULT_RECEIVER.offset} />
          </label>
          <label>Gain <output data-rx-gain-label>{DEFAULT_RECEIVER.gainDb} dB</output>
            <input type="range" data-rx-gain min="0" max={GAIN_MAX_DB} step="1" value={DEFAULT_RECEIVER.gainDb} />
          </label>
          <label>Audio level <output data-rx-level-label>{DEFAULT_RECEIVER.level}%</output>
            <input type="range" data-rx-level min="0" max="100" step="1" value={DEFAULT_RECEIVER.level} />
          </label>
          <p class="small">Tune to 915 MHz and lower the gain if the input clips. Audio level only changes the sound. <a href={base + '/#pedal-lab'}>Try the CSC-R1 pedal trainer</a></p>
        </div>
      </section>

      <div class="panels">
        <div>
          <h3 class="t-label">Downlinked packets</h3>
          <ol data-log class="log"><li>No packets yet.</li></ol>
        </div>
        <div data-live-board hidden>
          <h3 class="t-label">Stations playing now</h3>
          <p data-total class="small">Press “Play with others” to join.</p>
          <ol data-board class="log"></ol>
          <h3 class="t-label mt-3">Heard across the sky</h3>
          <ul data-feed class="log"></ul>
        </div>
      </div>
    </section>

    <div class="mt-8"><GameSteps steps={STEPS} keysNote={KEYS} listId="ctp-keys" /></div>

    <div class="mt-8 max-w-3xl">
      <section aria-labelledby="real-title">
        <h2 id="real-title">What is real here</h2>
        <div class="real mt-3 space-y-3">
          <p set:html={`A ${wiki('ground-station', 'ground station')} must point its antenna at a ${wiki('cubesat', 'CubeSat')} in ${wiki('leo', 'low Earth orbit')} for the few minutes it is overhead. Low in the sky the satellite is up to five times farther away, so its ${wiki('downlink', 'downlink')} is weaker.`} />
          <p set:html={`Many CubeSats send ${wiki('telemetry', 'telemetry')} with ${wiki('lora', 'LoRa')} radios at ${wiki('915-mhz', '915 MHz')}. Each spreading factor really does decode at a different ${wiki('rssi-snr', 'signal-to-noise ratio')}: SF7 needs about −7.5 dB and SF12 works down to −20 dB, but each SF12 packet takes about 30 times longer to send. The ${wiki('ism-band', 'ISM band')} is shared with other devices, which is the noise you have to avoid.`} />
          <p set:html={`The live sky sends each station's antenna and packets over ${wiki('moq', 'Media over QUIC (MoQ)')}, the same relay technology the classroom plans to use to share real satellite passes between schools.`} />
          <p class="small">The game adapts the CSC-R1 pedal controls for a simulated 915 MHz LoRa receiver. The physical CSC-R1 receiver is designed for 2 m and 70 cm. Passes and packet airtimes are shortened for play.</p>
        </div>
      </section>
    </div>
  </div>
  <SiteFooter slot="footer" />
</Base>

<script>
  import '../../games/catch-the-pass/game';
</script>

<style>
  .ctp { --line: #2b3a85; --panel: #121a46; --gold: #ffd23f; background: #0b1240; color: #e8ecff; border-radius: .9rem; padding: .6rem; box-shadow: 0 10px 40px rgb(8 12 40 / .35); }
  .ctp button { min-height: 44px; padding: .45rem .85rem; border: 1px solid var(--line); border-radius: .7rem; background: var(--panel); color: #fff; font: 700 .95rem var(--font-sans); touch-action: manipulation; }
  .ctp button:hover:not(:disabled) { filter: brightness(1.15); }
  .ctp button[aria-pressed="true"], .ctp button[aria-selected="true"] { background: var(--gold); color: #0b1240; border-color: var(--gold); }
  .ctp button:disabled { opacity: .5; cursor: not-allowed; }
  .ctp :focus-visible { outline: 3px solid var(--gold); outline-offset: 2px; }
  .ctp-top { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: .5rem; }
  .tabs, .tools { display: flex; gap: .4rem; align-items: center; flex-wrap: wrap; }
  .tools .ico { width: 2.75rem; padding: 0; font-size: 1.1rem; }
  .tools .start { background: linear-gradient(#ffe27a, #ffc62e); color: #0b1240; border-color: #ffc62e; min-width: 6rem; }
  .slow { display: inline-flex; gap: .35rem; align-items: center; min-height: 44px; padding: 0 .7rem; border-radius: .7rem; background: var(--panel); border: 1px solid var(--line); font-weight: 700; font-size: .9rem; cursor: pointer; }
  .slow:has(input:disabled) { opacity: .6; cursor: default; }
  .slow input { width: 1.1rem; height: 1.1rem; accent-color: var(--gold); }
  @media (max-width: 480px) { .tabs, .tools { width: 100%; flex-wrap: nowrap; } .tabs button { flex: 1; } .tools .start { flex: 1; min-width: 0; } .slow { padding: 0 .55rem; } .tools .ico { width: 2.6rem; flex: none; } }
  /* Levels: one scrolling strip of chips instead of a block of buttons */
  .levels { display: flex; gap: .4rem; margin-top: .55rem; overflow-x: auto; scrollbar-width: thin; padding-bottom: .15rem; }
  .levels button { white-space: nowrap; flex: none; font-size: .88rem; min-height: 44px; border-radius: 999px; }
  .levels .n { font-family: var(--font-mono); opacity: .8; }
  .stars-mini { font-size: .78rem; letter-spacing: .05em; opacity: .9; }
  .live-note { margin-top: .55rem; }
  .antenna-row { display: flex; flex-wrap: wrap; align-items: center; gap: .35rem .65rem; margin-top: .55rem; padding: .3rem .55rem; font-size: .85rem; }
  .antenna-row label { font-weight: 750; }
  .antenna-row select { min-height: 44px; max-width: 100%; padding: .4rem .6rem; border: 1px solid var(--line); border-radius: .55rem; color: #fff; background: var(--panel); color-scheme: dark; }
  .antenna-row span { color: #bfc9ec; }
  .antenna-row a { margin-inline-start: auto; }
  .antenna-row a, .receiver a { color: inherit; text-decoration: underline; text-underline-offset: .18em; }
  .receiver { margin-top: .55rem; padding: .7rem; display: grid; grid-template-columns: minmax(12rem, 1fr) 2fr; gap: .65rem 1rem; background: #122923; border: 1px solid #467865; border-radius: .7rem; }
  .receiver-face, .receiver-controls { display: grid; gap: .5rem; align-items: center; }
  .receiver h3 { margin: 0; color: #e2ffeb; font-size: 1rem; }
  .receiver-screen { display: grid; grid-template-columns: 1fr auto; gap: .3rem; padding: .5rem; color: #a3f7bd; background: #061a14; border-radius: .4rem; font: .83rem var(--font-mono); }
  .receiver-screen .bar { grid-column: 1 / -1; background: #183a31; height: .42rem; }
  .receiver-screen [data-rx-meter] { background: #76e7a2; }
  .receiver-screen [data-rx-meter][data-clip="true"] { background: #ff7979; }
  .receiver-face button { justify-self: start; }
  .receiver-controls { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: .3rem .85rem; }
  .receiver-controls label { display: grid; gap: .15rem; font-size: .82rem; font-weight: 700; }
  .receiver-controls output { font-family: var(--font-mono); color: #a3f7bd; }
  .receiver-controls input { width: 100%; min-height: 2rem; accent-color: #a3f7bd; }
  .receiver-controls p { grid-column: 1 / -1; margin: 0; }
  @media (max-width: 610px) { .receiver { grid-template-columns: minmax(0, 1fr); } }
  /* HUD strip above the sky */
  .dash { display: grid; grid-template-columns: auto 1fr 1fr; gap: .4rem 1rem; align-items: center; margin-top: .55rem; padding: .45rem .7rem; border-radius: .7rem; background: rgb(8 12 36 / .9); border: 1px solid var(--line); }
  .numbers { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: .35rem .75rem; font-family: var(--font-mono); margin: 0; }
  .numbers dt { font-size: .64rem; letter-spacing: .04em; text-transform: uppercase; opacity: .75; line-height: 1.2; }
  .numbers dd { font-size: 1.2rem; font-weight: 800; font-variant-numeric: tabular-nums; }
  .meter { display: grid; gap: .25rem; font-family: var(--font-mono); }
  .meter .t-label { font-size: .7rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .bar { position: relative; height: .7rem; background: #1b2550; border-radius: 999px; overflow: hidden; }
  .bar i { position: absolute; inset: 0 auto 0 0; background: linear-gradient(90deg, #ffb13b, #ffd23f); border-radius: 999px; transition: width .15s linear; }
  .bar i[data-ok="true"] { background: linear-gradient(90deg, #3fbf7f, #7ff0a8); }
  .bar i.battery { background: linear-gradient(90deg, #3fbf7f, #7ff0a8); }
  .bar i.battery[data-low="true"] { background: #ef6b6c; }
  .bar b { position: absolute; top: 0; bottom: 0; width: 3px; background: #fff; box-shadow: 0 0 4px #fff; }
  @media (max-width: 720px) { .dash { grid-template-columns: 1fr 1fr; } .numbers { grid-column: 1 / -1; justify-content: space-between; } }
  /* What to do now: one instruction and a link to that step below the game. */
  .now { margin: .55rem 0 0; padding: .45rem .7rem; display: flex; flex-wrap: wrap; align-items: baseline; gap: .2rem .6rem; border-radius: .7rem; background: rgb(8 12 36 / .9); border: 1px solid var(--line); font-size: .98rem; }
  .now:empty { display: none; }
  .now :global(.now-n) { font: 600 .78rem var(--font-mono); letter-spacing: .06em; color: var(--gold); }
  .now :global(a), .overlay :global(a) { color: #fff; text-decoration: underline; text-underline-offset: 3px; font-weight: 600; }
  .stage { position: relative; margin-top: .5rem; }
  canvas { display: block; width: 100%; border-radius: .7rem; touch-action: none; cursor: crosshair; background: #0b1240; }
  /* Controls under the sky: radio setting and sending on one side, the antenna pad on the other */
  .deck { display: grid; grid-template-columns: minmax(0, 1fr) auto; grid-template-areas: "sf pad" "tx pad"; gap: .5rem 1rem; align-items: center; margin-top: .55rem; padding: .55rem .7rem; border-radius: .7rem; background: rgb(8 12 36 / .9); border: 1px solid var(--line); }
  .sf { grid-area: sf; }
  .sf .t-label { font-size: .72rem; }
  .sf > div { display: grid; grid-template-columns: repeat(3, 1fr); gap: .35rem; margin-top: .3rem; }
  .sf button { display: grid; line-height: 1.15; min-height: 52px; }
  .sf small { font-weight: 500; opacity: .75; font-size: .72rem; }
  .tx { grid-area: tx; min-height: 48px; }
  .pad { grid-area: pad; display: grid; grid-template-columns: repeat(3, 3.4rem); grid-template-rows: repeat(3, 3.4rem); gap: .3rem; }
  .pad button { min-height: 0; padding: 0; font-size: 1.4rem; touch-action: none; user-select: none; -webkit-user-select: none; border-radius: .8rem; }
  .pad button[data-held="true"] { background: var(--gold); color: #0b1240; }
  .pad .up { grid-column: 2; grid-row: 1; } .pad .left { grid-column: 1; grid-row: 2; } .pad .right { grid-column: 3; grid-row: 2; } .pad .down { grid-column: 2; grid-row: 3; }
  @media (max-width: 480px) { .pad { grid-template-columns: repeat(3, 2.9rem); grid-template-rows: repeat(3, 2.9rem); } .deck { gap: .45rem; padding: .5rem; } .sf button { padding: .3rem .2rem; font-size: .82rem; } .sf small { font-size: .66rem; } }
  @media (max-width: 380px) {
    .tools { display: grid; grid-template-columns: minmax(0, 1fr) repeat(3, 2.75rem); }
    .tools .start { grid-row: 2; grid-column: 1 / -1; }
    .tools .ico { width: 2.75rem; }
    .deck { grid-template-columns: minmax(0, 1fr); grid-template-areas: "sf" "tx" "pad"; }
    .pad { justify-self: center; }
    .dash { padding-inline: .45rem; }
    .numbers dd { font-size: 1rem; }
  }
  @media (prefers-reduced-motion: reduce) { .bar i { transition: none; } }
  .overlay { position: absolute; inset: 0; display: grid; grid-template-columns: minmax(0, 1fr); align-content: safe center; justify-items: center; gap: .6rem; padding: 1rem; text-align: center; background: rgb(6 10 32 / .72); backdrop-filter: blur(2px); border-radius: .7rem; overflow: auto; }
  .overlay[hidden] { display: none; }
  .overlay :global(h3) { font-size: clamp(1.4rem, 3vw, 2rem); }
  .overlay :global(p) { max-width: 36rem; margin-inline: auto; color: #d6dcff; }
  .overlay :global(.stars) { font-size: 2.4rem; color: var(--gold); letter-spacing: .1em; }
  .overlay :global(.goal) { font-family: var(--font-mono); font-size: .9rem; color: var(--gold); }
  .overlay :global(.row) { display: flex; gap: .6rem; justify-content: center; flex-wrap: wrap; }
  .overlay :global(button) { justify-self: center; min-height: 46px; padding: .5rem 1.1rem; border: 1px solid var(--line); border-radius: .7rem; background: var(--panel); color: #fff; font: 700 1rem var(--font-sans); }
  .overlay :global(button.go) { min-height: 56px; background: linear-gradient(#ffe27a, #ffc62e); color: #0b1240; border-color: #ffc62e; box-shadow: 0 4px 0 #b88a10; font-size: 1.2rem; padding-inline: 1.6rem; }
  .overlay :global(.steps) { list-style: none; padding: 0; display: grid; gap: .6rem; grid-template-columns: repeat(auto-fit, minmax(min(11rem, 100%), 1fr)); max-width: 46rem; width: 100%; margin-inline: auto; }
  .overlay :global(.steps li) { display: grid; gap: .3rem; justify-items: center; padding: .8rem; border-radius: .8rem; background: #18225a; border: 1px solid var(--line); }
  .overlay :global(.steps .pic) { font-size: 2.2rem; line-height: 1; }
  .stage[data-panel="howto"] canvas { visibility: hidden; }
  @media (max-width: 40rem) { .stage[data-panel="howto"] canvas { display: none; } .stage[data-panel="howto"] .overlay { position: static; } }
  .panels { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(min(16rem, 100%), 1fr)); margin-top: .8rem; padding: 0 .3rem .3rem; }
  .log { margin-top: .4rem; font: .82rem/1.5 var(--font-mono); color: #c9d2ff; }
  .small { font-size: .88rem; color: #c9d2ff; }
  .real :global(a) { color: var(--color-accent); text-decoration: underline; text-underline-offset: 3px; font-weight: 600; }
  .real .small { color: var(--color-muted); }
  .crumbs { display: flex; flex-wrap: wrap; align-items: center; gap: .1rem .5rem; font-size: .9rem; color: var(--color-muted); }
  .crumbs a { display: inline-flex; align-items: center; min-height: 2.75rem; font-weight: 600; color: var(--color-accent); text-decoration: underline; text-underline-offset: 3px; }
  .crumbs [aria-current] { font-weight: 600; color: var(--color-ink, inherit); }
  .crumbs .all { margin-left: auto; padding: 0 .9rem; border-radius: 999px; background: var(--color-mist); border: 1px solid var(--color-line); text-decoration: none; }
</style>
