---
import '../../styles/bricks.css';
import Base from '../../layouts/Base.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { ANTENNAS, DEFAULT_RECEIVER, LEVELS, receiverFrequency } from '../../games/catch-the-pass/logic.mjs';
import { GAIN_MAX_DB } from '../../lib/pedal.mjs';
import { siteOrigin } from '../../origin';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const wiki = (slug: string, text: string) => `<a href="${base}/wiki/${slug}/">${text}</a>`;
---
<Base title="Catch the Pass | CubeSat Classroom games" description="Track a CubeSat across the sky with a ground-station antenna, choose a LoRa spreading factor and download its packets before it sets. A free browser game." canonical={siteOrigin + '/games/catch-the-pass/'}>
  <SiteHeader slot="header" home={base + '/'} current="games" />
  <div class="shell py-8 sm:py-12">
    <nav class="crumbs" aria-label="Breadcrumb"><a href={base + '/'}>Home</a><span aria-hidden="true">›</span><a href={base + '/games/'}>Games</a><span aria-hidden="true">›</span><span aria-current="page">Catch the Pass</span><a class="all" href={base + '/games/'}>← All games</a></nav>
    <h1>Catch the Pass</h1>
    <p class="lede mt-2">Keep your antenna on the CubeSat as it crosses the sky, and catch its packets before it sets.</p>

    <section class="ctp bricks plate mt-5" data-ctp aria-labelledby="ctp-title">
      <h2 id="ctp-title" class="sr-only">Game</h2>
      <div class="ctp-top">
        <div role="group" aria-label="Game mode" class="tabs brick-auto">
          <button type="button" class="white" data-mode="missions" aria-pressed="true">⭐ Levels</button>
          <button type="button" class="white" data-mode="live" aria-pressed="false">🌐 Play with others</button>
        </div>
        <div class="tools brick-auto">
          <label class="slow" title="Slower passes and a bigger antenna circle"><input type="checkbox" data-slow checked /> 🙂 Easy mode</label>
          <button type="button" data-pause class="start green">Start</button>
          <button type="button" data-restart class="white" aria-label="Start again" title="Start again"><span aria-hidden="true">🔁</span><span class="w">Again</span></button>
          <button type="button" data-sound aria-pressed="false" class="white" aria-label="Sound off" title="Sound"><span class="i" aria-hidden="true">🔇</span><span class="w">Sound</span></button>
          <button type="button" data-help class="white no-tick" aria-label="Help: how to play" title="How to play"><span aria-hidden="true">❓</span><span class="w">Help</span></button>
        </div>
      </div>
      <div data-missions class="levels brick-auto" role="group" aria-label="Levels">
        {LEVELS.map((level, i) => (
          <button type="button" class="white" data-level={i} aria-pressed={i === 0 ? 'true' : 'false'}>
            <span class="n">{i + 1}</span> {level.name} <span data-stars class="stars-mini">☆☆☆</span>
          </button>
        ))}
      </div>
      <div data-live class="live-note" hidden>
        <p data-sky-status aria-live="polite">Not connected.</p>
        <p class="small">Everyone in the live sky tracks the same satellite at the same time. A new pass starts every minute. Stations are anonymous call signs. There are no names and no chat.</p>
      </div>

      <div class="antenna-row">
        <label for="ctp-antenna">Antenna</label>
        <select id="ctp-antenna" data-antenna aria-describedby="ctp-antenna-note">
          <option value="">Recommended for this pass</option>
          {Object.entries(ANTENNAS).map(([id, antenna]) => <option value={id}>{antenna.name}</option>)}
        </select>
        <span id="ctp-antenna-note" data-antenna-note>Patch · Medium beam · balanced gain</span>
        <a href="#ctp-receiver">Receiver pedal ↓</a>
      </div>

      <div class="dash">
        <dl class="numbers">
          <div><dt>📦 Packets</dt><dd data-rx>0</dd></div>
          <div><dt>🪙 Credits</dt><dd data-score>0</dd></div>
          <div><dt>🔥 In a row</dt><dd data-streak>0</dd></div>
          <div><dt>⏱ Time</dt><dd data-time>—</dd></div>
        </dl>
        <div class="meter">
          <span class="t-label">📶 Signal <span data-snr>—</span></span>
          <div class="bar" aria-hidden="true"><i data-snr-bar></i><b data-snr-floor title="You need a signal past this line to catch packets"></b></div>
        </div>
        <div class="meter">
          <span class="t-label">🔋 Battery <span data-battery>—</span> · <span data-light>Sunlit</span></span>
          <div class="bar" aria-hidden="true"><i data-battery-bar class="battery"></i></div>
        </div>
      </div>
      <p class="now" data-now></p>
      <div class="stage on-dark">
        <canvas tabindex="0" aria-label="Sky view" aria-describedby="ctp-keys"></canvas>
        <div class="overlay brick-auto" data-overlay></div>
      </div>
      <p class="sr-only" data-status role="status" aria-live="polite"></p>

      <div class="deck brick-auto">
        <div class="sf" role="group" aria-label="Radio setting (spreading factor)">
          <span class="t-label">📻 Radio setting</span>
          <div>
            <button type="button" class="white" data-sf="7" aria-pressed="false">🐇 Fast <small>SF7</small></button>
            <button type="button" class="white" data-sf="9" aria-pressed="true">🚶 Middle <small>SF9</small></button>
            <button type="button" class="white" data-sf="12" aria-pressed="false">🐢 Far <small>SF12</small></button>
          </div>
        </div>
        <button type="button" data-tx aria-pressed="true" class="tx white">📡 Sending: on</button>
        <div class="pad" role="group" aria-label="Move the antenna">
          <button type="button" data-aim="ArrowUp" aria-label="Antenna up" class="up blue">▲</button>
          <button type="button" data-aim="ArrowLeft" aria-label="Antenna left" class="left blue">◀</button>
          <button type="button" data-aim="ArrowRight" aria-label="Antenna right" class="right blue">▶</button>
          <button type="button" data-aim="ArrowDown" aria-label="Antenna down" class="down blue">▼</button>
        </div>
      </div>

      <section class="receiver" id="ctp-receiver" aria-labelledby="ctp-receiver-title">
        <div class="receiver-face brick-auto">
          <h3 id="ctp-receiver-title">Receiver pedal</h3>
          <div class="receiver-screen">
            <span>Input <span data-rx-input>0%</span></span>
            <span data-rx-state>Ready</span>
            <div class="bar" aria-hidden="true"><i data-rx-meter></i></div>
          </div>
          <button type="button" class="white" data-rx-engage aria-pressed="true">Engaged</button>
        </div>
        <div class="receiver-controls">
          <label>Tune <output data-rx-tune-label>{receiverFrequency(0).toFixed(3)} MHz</output>
            <input type="range" data-rx-tune min="-4" max="4" step="1" value={DEFAULT_RECEIVER.offset} />
          </label>
          <label>Gain <output data-rx-gain-label>{DEFAULT_RECEIVER.gainDb} dB</output>
            <input type="range" data-rx-gain min="0" max={GAIN_MAX_DB} step="1" value={DEFAULT_RECEIVER.gainDb} />
          </label>
          <label>Audio level <output data-rx-level-label>{DEFAULT_RECEIVER.level}%</output>
            <input type="range" data-rx-level min="0" max="100" step="1" value={DEFAULT_RECEIVER.level} />
          </label>
          <p class="small">Tune to 915 MHz and lower the gain if the input clips. Audio level only changes the sound. <a href={base + '/#pedal-lab'}>Try the CSC-R1 pedal trainer</a></p>
        </div>
      </section>

      <div class="panels">
        <div>
          <h3 class="t-label">Downlinked packets</h3>
          <ol data-log class="log"><li>No packets yet.</li></ol>
        </div>
        <div data-live-board hidden>
          <h3 class="t-label">Stations playing now</h3>
          <p data-total class="small">Press “Play with others” to join.</p>
          <ol data-board class="log"></ol>
          <h3 class="t-label mt-3">Heard across the sky</h3>
          <ul data-feed class="log"></ul>
        </div>
      </div>
    </section>

    <div class="mt-8 grid gap-8 lg:grid-cols-2">
      <section aria-labelledby="how-title">
        <h2 id="how-title">How to play</h2>
        <ul id="ctp-keys" class="mt-3 list-disc space-y-1.5 pl-5">
          <li><strong>Move the antenna:</strong> tap or hold the ▲ ◀ ▶ ▼ buttons, drag on the sky with a finger, move the mouse over the sky, or use the arrow keys or W A S D.</li>
          <li><strong>Catch packets:</strong> keep the circle on the satellite. When the signal bar turns green, you are catching packets and earning credits.</li>
          <li><strong>Set up your receiver:</strong> choose a wide beam for easier aiming or a narrow beam for more gain. Keep the pedal engaged and tuned to 915 MHz.</li>
          <li><strong>Radio setting:</strong> 🐇 Fast catches packets quickly when the satellite is close. 🐢 Far works when it is low and far away. Keys 1, 2 and 3 work too.</li>
          <li><strong>Sending:</strong> press Space or the 📡 button to let the satellite rest and save its battery.</li>
          <li><strong>Pause:</strong> P or Esc. <strong>Start:</strong> Enter. Sound starts off. Easy mode (on at first) makes passes slower and the antenna’s circle bigger.</li>
          <li>Earn 1 to 3 stars per pass. A star on a level unlocks the next one.</li>
        </ul>
      </section>
      <section aria-labelledby="real-title">
        <h2 id="real-title">What is real here</h2>
        <div class="real mt-3 space-y-3">
          <p set:html={`A ${wiki('ground-station', 'ground station')} must point its antenna at a ${wiki('cubesat', 'CubeSat')} in ${wiki('leo', 'low Earth orbit')} for the few minutes it is overhead. Low in the sky the satellite is up to five times farther away, so its ${wiki('downlink', 'downlink')} is weaker.`} />
          <p set:html={`Many CubeSats send ${wiki('telemetry', 'telemetry')} with ${wiki('lora', 'LoRa')} radios at ${wiki('915-mhz', '915 MHz')}. Each spreading factor really does decode at a different ${wiki('rssi-snr', 'signal-to-noise ratio')}: SF7 needs about −7.5 dB and SF12 works down to −20 dB, but each SF12 packet takes about 30 times longer to send. The ${wiki('ism-band', 'ISM band')} is shared with other devices, which is the noise you have to avoid.`} />
          <p set:html={`The live sky sends each station's antenna and packets over ${wiki('moq', 'Media over QUIC (MoQ)')}, the same relay technology the classroom plans to use to share real satellite passes between schools.`} />
          <p class="small">The game adapts the CSC-R1 pedal controls for a simulated 915 MHz LoRa receiver. The physical CSC-R1 receiver is designed for 2 m and 70 cm. Passes and packet airtimes are shortened for play.</p>
        </div>
      </section>
    </div>
  </div>
  <SiteFooter slot="footer" />
</Base>

<script>
  import '../../games/catch-the-pass/game';
</script>

<style>
  /* The game sits on a studded baseplate (bricks.css); every control is a brick. */
  .ctp { padding: .6rem; display: grid; gap: .55rem; }
  .ctp-top { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: .5rem; }
  .tabs, .tools { display: flex; gap: .45rem; align-items: end; flex-wrap: wrap; }
  .tools .start { min-width: 7rem; }
  .slow { display: inline-flex; gap: .45rem; align-items: center; min-height: 48px; padding: 0 .8rem; border-radius: 6px; background: #fff; border: 3px solid var(--brick-ink); font-weight: 700; font-size: 1rem; cursor: pointer; }
  .slow:has(input:disabled) { opacity: .6; cursor: default; }
  .slow input { width: 1.4rem; height: 1.4rem; accent-color: var(--brick-green); }
  @media (max-width: 560px) {
    .tools .w { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
    .tabs { width: 100%; } .tabs button { flex: 1; }
    .tools { width: 100%; display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); }
    .tools .slow, .tools .start { grid-column: span 3; min-width: 0; }
    .tools button:not(.start) { grid-column: span 2; }
  }
  /* Levels: one strip of bricks, each with its number and stars. */
  .levels { display: flex; gap: .45rem; overflow-x: auto; padding: .1rem .1rem .35rem; scrollbar-width: thin; }
  .levels button { white-space: nowrap; flex: none; font-size: 1rem; }
  .levels .n { display: inline-grid; place-items: center; width: 1.5rem; height: 1.5rem; border-radius: 50%; background: var(--brick-ink); color: #fff; font-size: .9rem; }
  .stars-mini { letter-spacing: .05em; }
  .live-note { padding: .5rem .7rem; border-radius: 8px; background: #fff; border: 2px solid var(--brick-ink); }
  .antenna-row { display: flex; flex-wrap: wrap; align-items: center; gap: .4rem .7rem; padding: .45rem .7rem; border-radius: 8px; background: #fff; border: 2px solid var(--brick-ink); font-size: 1rem; }
  .antenna-row label { font-weight: 700; }
  .antenna-row select { min-height: 48px; max-width: 100%; padding: .4rem .6rem; border: 3px solid var(--brick-ink); border-radius: 6px; color: var(--brick-ink); background: #fff; font: 700 1rem var(--brick-font); }
  .antenna-row a { margin-inline-start: auto; }
  .antenna-row a, .receiver a, .live-note a { color: var(--brick-blue); text-decoration: underline; text-underline-offset: .18em; font-weight: 700; }
  /* Receiver pedal: a green brick box with a screen. */
  .receiver { padding: .8rem; display: grid; grid-template-columns: minmax(12rem, 1fr) 2fr; gap: .65rem 1rem; background: #fff; border: 3px solid var(--brick-ink); border-radius: 10px; box-shadow: inset 0 -6px 0 var(--brick-green); }
  .receiver-face, .receiver-controls { display: grid; gap: .5rem; align-items: center; }
  .receiver h3 { margin: 0; font: 700 1.15rem var(--brick-font); }
  .receiver-screen { display: grid; grid-template-columns: 1fr auto; gap: .3rem; padding: .55rem; color: #c8ffd9; background: #0e2a1e; border-radius: 6px; font-size: 1rem; }
  .receiver-screen .bar { grid-column: 1 / -1; background: #24493b; height: .6rem; }
  .receiver-screen [data-rx-meter] { background: #76e7a2; }
  .receiver-screen [data-rx-meter][data-clip="true"] { background: #ff9b8f; }
  .receiver-face button { justify-self: start; }
  .receiver-controls { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: .35rem .9rem; }
  .receiver-controls label { display: grid; gap: .2rem; font-size: 1rem; font-weight: 700; }
  .receiver-controls output { font-variant-numeric: tabular-nums; color: var(--brick-green); }
  .receiver-controls input { width: 100%; min-height: 2.2rem; accent-color: var(--brick-green); }
  .receiver-controls p { grid-column: 1 / -1; margin: 0; }
  @media (max-width: 610px) { .receiver { grid-template-columns: minmax(0, 1fr); } .receiver-controls { grid-template-columns: minmax(0, 1fr); } }
  /* Score strip above the sky: a word, then the number. */
  .dash { display: grid; grid-template-columns: auto 1fr 1fr; gap: .45rem 1rem; align-items: center; padding: .5rem .75rem; border-radius: 8px; background: #fff; border: 3px solid var(--brick-ink); }
  .numbers { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: .35rem .9rem; margin: 0; }
  .numbers dt { font-size: .95rem; line-height: 1.2; }
  .numbers dd { font-size: 1.35rem; font-weight: 700; font-variant-numeric: tabular-nums; }
  .meter { display: grid; gap: .25rem; }
  .meter .t-label { font-size: .98rem; font-weight: 700; }
  .bar { position: relative; height: .9rem; background: var(--brick-plate-dark); border: 2px solid var(--brick-ink); border-radius: 4px; overflow: hidden; }
  .bar i { position: absolute; inset: 0 auto 0 0; background: var(--brick-yellow); transition: width .15s linear; }
  .bar i[data-ok="true"], .bar i.battery { background: var(--brick-green); }
  .bar i.battery[data-low="true"] { background: var(--brick-red); }
  .bar b { position: absolute; top: 0; bottom: 0; width: 3px; background: var(--brick-ink); }
  @media (max-width: 720px) { .dash { grid-template-columns: 1fr 1fr; } .numbers { grid-column: 1 / -1; } }
  @media (max-width: 420px) { .numbers { grid-template-columns: repeat(2, minmax(0, 1fr)); } .dash { grid-template-columns: minmax(0, 1fr); } }
  .stage { position: relative; }
  canvas { display: block; width: 100%; border: 3px solid var(--brick-ink); border-radius: 8px; touch-action: none; cursor: crosshair; background: #0b1240; }
  /* Controls under the sky: radio setting and sending on one side, the antenna pad on the other. */
  .deck { display: grid; grid-template-columns: minmax(0, 1fr) auto; grid-template-areas: "sf pad" "tx pad"; gap: .55rem 1rem; align-items: end; padding: .55rem .75rem .75rem; border-radius: 8px; background: #fff; border: 3px solid var(--brick-ink); }
  .sf { grid-area: sf; }
  .sf .t-label { font-size: 1rem; font-weight: 700; }
  .sf > div { display: grid; grid-template-columns: repeat(3, 1fr); gap: .4rem; }
  .sf button { display: grid; line-height: 1.15; min-height: 56px; padding-inline: .4rem; }
  .sf small { font-weight: 400; font-size: .85rem; }
  .tx { grid-area: tx; justify-self: start; }
  .pad { grid-area: pad; display: grid; grid-template-columns: repeat(3, 3.6rem); grid-template-rows: repeat(3, 3.6rem); gap: .35rem; }
  .pad button { min-height: 0; padding: 0; font-size: 1.5rem; touch-action: none; user-select: none; -webkit-user-select: none; }
  .pad button[data-held="true"] { --b: var(--brick-yellow); --fg: var(--brick-ink); }
  .pad .up { grid-column: 2; grid-row: 1; } .pad .left { grid-column: 1; grid-row: 2; } .pad .right { grid-column: 3; grid-row: 2; } .pad .down { grid-column: 2; grid-row: 3; }
  @media (max-width: 480px) { .pad { grid-template-columns: repeat(3, 3.1rem); grid-template-rows: repeat(3, 3.1rem); } .sf button { font-size: .95rem; } }
  @media (max-width: 400px) { .deck { grid-template-columns: minmax(0, 1fr); grid-template-areas: "sf" "tx" "pad"; } .pad { justify-self: center; } }
  @media (prefers-reduced-motion: reduce) { .bar i { transition: none; } }
  /* Cards over the sky: a white brick with an ink border. */
  .overlay { position: absolute; inset: 0; display: grid; grid-template-columns: minmax(0, 1fr); align-content: safe center; justify-items: center; gap: .7rem; padding: 1rem; text-align: center; background: rgb(11 18 64 / .6); border-radius: 8px; overflow: auto; }
  .overlay[hidden] { display: none; }
  .overlay :global(.panel) { display: grid; gap: .7rem; justify-items: center; width: min(100%, 48rem); padding: clamp(1rem, 3vw, 1.6rem); background: #fff; border: 4px solid var(--brick-ink); border-radius: 12px; box-shadow: 0 6px 0 var(--brick-ink); }
  .overlay :global(h3) { font: 700 clamp(1.45rem, 3vw, 2.1rem)/1.15 var(--brick-font); }
  .overlay :global(p) { max-width: 36rem; margin-inline: auto; font-size: 1.1rem; line-height: 1.45; }
  .overlay :global(.stars) { font-size: 2.6rem; color: #9a6f00; letter-spacing: .1em; }
  .overlay :global(.goal) { font-size: 1.05rem; font-weight: 700; }
  .overlay :global(.row) { display: flex; gap: .7rem; justify-content: center; flex-wrap: wrap; }
  .overlay :global(button) { --b: var(--brick-blue); justify-self: center; }
  .overlay :global(button.go) { --b: var(--brick-green); min-height: 60px; font-size: 1.25rem; padding-inline: 1.6rem; }
  .overlay :global(.steps) { list-style: none; padding: 0; display: grid; gap: .9rem; grid-template-columns: repeat(auto-fit, minmax(min(11rem, 100%), 1fr)); max-width: 46rem; width: 100%; margin-inline: auto; }
  .overlay :global(.steps li) { display: grid; gap: .3rem; justify-items: center; padding: .9rem .8rem; border-radius: 8px; color: #fff; border: 3px solid var(--brick-ink); box-shadow: inset 0 -6px 0 rgb(0 0 0 / .25); font-size: 1.02rem; line-height: 1.4; }
  .overlay :global(.steps li:nth-child(1)) { background: var(--brick-blue); }
  .overlay :global(.steps li:nth-child(2)) { background: var(--brick-green); }
  .overlay :global(.steps li:nth-child(3)) { background: var(--brick-red); }
  .overlay :global(.steps b) { font-size: 1.2rem; }
  .overlay :global(.steps .pic) { font-size: 2.3rem; line-height: 1; }
  .stage[data-panel="howto"] canvas { visibility: hidden; }
  @media (max-width: 40rem) { .stage[data-panel="howto"] canvas { display: none; } .stage[data-panel="howto"] .overlay { position: static; } }
  .panels { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(min(16rem, 100%), 1fr)); padding: .6rem .75rem; border-radius: 8px; background: #fff; border: 2px solid var(--brick-ink); }
  .panels .t-label { font: 700 1.05rem var(--brick-font); }
  .log { margin-top: .4rem; font-size: .98rem; line-height: 1.5; }
  .small { font-size: 1rem; }
  .real :global(a) { color: var(--color-accent); text-decoration: underline; text-underline-offset: 3px; font-weight: 600; }
  .real .small { color: var(--color-muted); }
  .crumbs { display: flex; flex-wrap: wrap; align-items: center; gap: .1rem .5rem; font-size: .9rem; color: var(--color-muted); }
  .crumbs a { display: inline-flex; align-items: center; min-height: 2.75rem; font-weight: 600; color: var(--color-accent); text-decoration: underline; text-underline-offset: 3px; }
  .crumbs [aria-current] { font-weight: 600; color: var(--color-ink, inherit); }
  .crumbs .all { margin-left: auto; padding: 0 .9rem; border-radius: 999px; background: var(--color-mist); border: 1px solid var(--color-line); text-decoration: none; }
</style>
