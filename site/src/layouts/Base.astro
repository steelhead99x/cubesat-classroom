---
import '@fontsource/atkinson-hyperlegible/400.css';
import '@fontsource/atkinson-hyperlegible/700.css';
import '../theme.css';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  image?: string;
  mark?: string;
}

const { title, description, canonical, image, mark = 'mark.svg' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <!-- GitHub Pages cannot send security headers, so the page sets what a meta tag can.
         All scripts are files on this origin (no inline scripts), so script-src can be 'self'.
         frame-ancestors, HSTS and nosniff cannot be set from a meta tag; the Cloudflare Worker sends them. -->
    <meta http-equiv="Content-Security-Policy" content="script-src 'self'; base-uri 'none'; object-src 'none'; form-action 'self'">
    <meta name="referrer" content="strict-origin-when-cross-origin">
    <meta name="description" content={description}>
    <meta name="theme-color" content="#10264a">
    <link rel="icon" type="image/svg+xml" href={base + '/' + mark}>
    {canonical && <link rel="canonical" href={canonical}>}
    <meta property="og:type" content="website">
    <meta property="og:title" content={title}>
    <meta property="og:description" content={description}>
    {canonical && <meta property="og:url" content={canonical}>}
    {image && <meta property="og:image" content={image}>}
    {image && <meta name="twitter:card" content="summary_large_image">}
    <title>{title}</title>
    <script is:inline src={base + '/level.js'}></script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <slot name="header" />
    <main id="main">
      <slot />
    </main>
    <slot name="footer" />
  </body>
</html>
