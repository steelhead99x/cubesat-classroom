---
import '@fontsource-variable/inter';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '@fontsource/ibm-plex-mono/600.css';
import '../theme.css';
import preview from '../../../hardware/amsat-cubesatsim/render-exploded-navy.png';
import { siteOrigin } from '../origin';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  image?: string;
  imageAlt?: string;
  mark?: string;
  robots?: string;
}

const { title, description, canonical, image, imageAlt = 'Exploded view of the classroom CubeSat: the AMSAT CubeSatSim frame with a printed Arduino payload plate', mark = 'favicon.svg', robots } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const social = image ?? siteOrigin + preview.src.replace(base, '');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <!-- GitHub Pages cannot send security headers, so the page sets what a meta tag can.
         All scripts are files on this origin (no inline scripts), so script-src can be 'self'.
         frame-ancestors, HSTS and nosniff cannot be set from a meta tag; the Cloudflare Worker sends them. -->
    <meta http-equiv="Content-Security-Policy" content="script-src 'self'; base-uri 'none'; object-src 'none'; form-action 'self'">
    <meta name="referrer" content="strict-origin-when-cross-origin">
    <meta name="description" content={description}>
    {robots && <meta name="robots" content={robots}>}
    <meta name="theme-color" content="#01017f">
    <link rel="icon" type="image/svg+xml" href={base + '/' + mark}>
    {canonical && <link rel="canonical" href={canonical}>}
    <meta property="og:site_name" content="CubeSat Classroom">
    <meta property="og:type" content="website">
    <meta property="og:title" content={title}>
    <meta property="og:description" content={description}>
    {canonical && <meta property="og:url" content={canonical}>}
    <meta property="og:image" content={social}>
    <meta property="og:image:alt" content={imageAlt}>
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content={title}>
    <meta name="twitter:description" content={description}>
    <meta name="twitter:image" content={social}>
    <meta name="twitter:image:alt" content={imageAlt}>
    <title>{title}</title>
    <script is:inline src={base + '/level.js'}></script>
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <slot name="header" />
    <main id="main">
      <slot />
    </main>
    <slot name="footer" />
  </body>
</html>
