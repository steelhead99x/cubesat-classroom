// Cloudflare Worker settings for the site. `run_worker_first` sends every request
// through src/worker.mjs, which the preview password and the start.sh headers rely on.
// Secrets (SITE_PASSWORD, PREVIEW_COOKIE_SECRET, ANTHROPIC_API_KEY) are set with
// `npx wrangler secret put NAME`, never written here.
//
// Custom domains are listed here so `wrangler deploy` keeps the existing apex hostnames
// and the www hostnames that 301 to the apex or, for cubesat.club and cubesatclass.com,
// to cubesatclass.org. Omitting them would risk dropping dashboard-managed domains.
// cubesat.app is not listed: it belongs to the app's own Worker (cubesat-classroom-app repo).
{
  "name": "cubesat-classroom",
  "workers_dev": true,
  "main": "src/worker.mjs",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "cubesatclass.org", "custom_domain": true },
    { "pattern": "www.cubesatclass.org", "custom_domain": true },
    { "pattern": "cubesat.club", "custom_domain": true },
    { "pattern": "www.cubesat.club", "custom_domain": true },
    { "pattern": "cubesatclass.com", "custom_domain": true },
    { "pattern": "www.cubesatclass.com", "custom_domain": true },
    { "pattern": "cubesatclass.io", "custom_domain": true },
    { "pattern": "www.cubesatclass.io", "custom_domain": true },
    { "pattern": "cubesatclass.dev", "custom_domain": true },
    { "pattern": "www.cubesatclass.dev", "custom_domain": true }
  ],
  // Password attempts on the preview gate, per network address: 20 a minute. It needs the
  // PREVIEW_COOKIE_SECRET secret (see src/worker.mjs, tooManyGuesses) but no KV store; the
  // optional GUIDE_LIMITS store adds a daily cap on wrong guesses.
  // namespace_id is account-wide: keep it different from cubesat.app's TOKEN_LIMIT (4401).
  "ratelimits": [
    { "name": "UNLOCK_LIMIT", "namespace_id": "4410", "simple": { "limit": 20, "period": 60 } }
  ]
}
